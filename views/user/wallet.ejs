                                <p class="font-headline-md text-headline-md">₹2000</p>
                            </div>
                            <div
                                class="border border-primary p-6 text-center cursor-pointer hover:bg-primary hover:text-on-primary transition-colors group">
                                <p class="font-label-caps text-label-caps opacity-50 mb-2">PRESET</p>
                                <p class="font-headline-md text-headline-md">₹5000</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
                            <div class="md:col-span-8"> <label
                                    class="block font-label-caps text-label-caps text-on-surface-variant mb-4">CUSTOM
                                    AMOUNT</label><input
                                    class="w-full bg-transparent border-0 border-b border-primary p-4 font-mono-data text-headline-md focus:ring-0 placeholder:opacity-20"
                                    placeholder="ENTER AMOUNT (₹)" type="text"></div>
                            <div class="md:col-span-4"> <button
                                    class="w-full bg-primary text-on-primary py-6 font-label-caps text-label-caps border border-primary hover:bg-surface hover:text-primary transition-colors">ADD
                                    TO WALLET</button></div>
                        </div>
                    </div>
                </section> -->
                <section class="px-container-padding py-section-gap">
                    <h4 class="font-label-caps text-label-caps text-on-surface-variant mb-12 tracking-widest">WALLET
                        ACTIVITY
                    </h4>


                    <% if (wallet.transactions && wallet.transactions.length> 0) { %>

                        <% wallet.transactions.forEach(transaction=> { %>

                            <div
                                class="grid grid-cols-12 py-8 border-b border-primary hover:bg-surface-container-low transition-colors group">

                                <div class="col-span-12 md:col-span-6 mb-4 md:mb-0">
                                    <p class="font-headline-md text-headline-md uppercase">
                                        <%= transaction.reason.replaceAll("_", " " ) %>
                                    </p>

                                    <% if (transaction.orderId) { %>
                                        <p class="font-mono-data text-mono-data text-on-surface-variant">
                                            ORDER: <%= transaction.orderId %>
                                        </p>
                                        <% } else { %>
                                            <p class="font-mono-data text-mono-data text-on-surface-variant">
                                                WALLET TRANSACTION
                                            </p>
                                            <% } %>
                                </div>

                                <div class="col-span-6 md:col-span-3 flex items-center">
                                    <p class="font-mono-data text-mono-data text-on-surface-variant uppercase">
                                        <%= new Date(transaction.createdAt).toLocaleDateString("en-IN", { day: "2-digit"
                                            , month: "short" , year: "numeric" }) %>
                                    </p>
                                </div>

                                <div class="col-span-6 md:col-span-3 flex items-center justify-end">
                                    <p
                                        class="font-headline-md text-headline-md <%= transaction.type === 'CREDIT' ? 'text-accent-success' : '' %>">
                                        <%= transaction.type==="CREDIT" ? "+" : "-" %>₹<%=
                                                Number(transaction.amount).toLocaleString("en-IN") %>
                                    </p>
                                </div>

                            </div>

                            <% }) %>

                                <% } else { %>

                                    <div class="py-16 text-center border-b border-primary">
                                        <p class="font-headline-md text-headline-md uppercase">
                                            NO WALLET ACTIVITY
                                        </p>

                                        <p class="font-mono-data text-mono-data text-on-surface-variant mt-3">
                                            Your wallet transactions will appear here.
                                        </p>
                                    </div>

                                    <% } %>


                                        <div class="mt-12 flex justify-center">
                                            <% if (wallet.totalPages> 1) { %>
                                                <div class="mt-12 border-t border-primary">

                                                    <div class="flex items-center justify-between py-6">

                                                        <!-- Previous -->
                                                        <div>
                                                            <% if (wallet.currentPage> 1) { %>

                                                                <a href="/wallet?page=<%= wallet.currentPage - 1 %>"
                                                                    class="group inline-flex items-center gap-3 font-label-caps text-label-caps hover:opacity-60 transition-opacity">

                                                                    <span class="text-lg">←</span>
                                                                    <span>PREVIOUS</span>

                                                                </a>

                                                                <% } else { %>

                                                                    <span
                                                                        class="inline-flex items-center gap-3 font-label-caps text-label-caps opacity-20 cursor-not-allowed">

                                                                        <span class="text-lg">←</span>
                                                                        <span>PREVIOUS</span>

                                                                    </span>

                                                                    <% } %>
                                                        </div>


                                                        <!-- Page Indicator -->
                                                        <div class="flex items-center gap-6">

                                                            <span
                                                                class="font-mono-data text-mono-data text-on-surface-variant">
                                                                PAGE
                                                            </span>

                                                            <div class="flex items-center gap-2">

                                                                <% for (let i=1; i <=wallet.totalPages; i++) { %>

                                                                    <% if (wallet.currentPage===i) { %>

                                                                        <span
                                                                            class="w-10 h-10 flex items-center justify-center bg-primary text-on-primary font-label-caps text-label-caps">
                                                                            <%= i %>
                                                                        </span>

                                                                        <% } else { %>

                                                                            <a href="/wallet?page=<%= i %>"
                                                                                class="w-10 h-10 flex items-center justify-center border border-primary font-label-caps text-label-caps hover:bg-primary hover:text-on-primary transition-colors">
                                                                                <%= i %>
                                                                            </a>

                                                                            <% } %>

                                                                                <% } %>

                                                            </div>

                                                            <span
                                                                class="font-mono-data text-mono-data text-on-surface-variant">
                                                                / <%= wallet.totalPages %>
                                                            </span>

                                                        </div>


                                                        <!-- Next -->
                                                        <div>
                                                            <% if (wallet.currentPage < wallet.totalPages) { %>

                                                                <a href="/wallet?page=<%= wallet.currentPage + 1 %>"
                                                                    class="group inline-flex items-center gap-3 font-label-caps text-label-caps hover:opacity-60 transition-opacity">

                                                                    <span>NEXT</span>
                                                                    <span class="text-lg">→</span>

                                                                </a>

                                                                <% } else { %>

                                                                    <span
                                                                        class="inline-flex items-center gap-3 font-label-caps text-label-caps opacity-20 cursor-not-allowed">

                                                                        <span>NEXT</span>
                                                                        <span class="text-lg">→</span>

                                                                    </span>

                                                                    <% } %>
                                                        </div>

                                                    </div>

                                                </div>
                                                <% } %>
                                        </div>
                </section>
            </main>
            <!-- Footer -->
            <%- include("partials/userFooter") %>
                <script>
                    // Micro-interaction for currency numbers
                    document.addEventListener('DOMContentLoaded', () => {
                        const balances = document.querySelectorAll('.font-display-xl, .font-headline-lg');
                        balances.forEach(balance => {
                            balance.addEventListener('mouseenter', () => {
                                balance.style.transition = 'all 0.1s';
                                balance.style.transform = 'skewX(-5deg)';
                            });
                            balance.onmouseleave = () => {
                                balance.style.transform = 'skewX(0deg)';
                            };
                        });
                    });
                </script>


</body>

</html>