<body class="bg-background text-on-surface">
    <%- include("partials/toast") %>
        <!-- Fixed SideNavBar -->
        <%- include("partials/adminSidebar") %>
            <!-- Main Content Shell -->
            <div class="ml-[240px] flex flex-col min-h-screen">
                <%- include("partials/adminNavbar") %>
                    <!-- Main Workspace -->
                    <main class="mt-16 p-xl max-w-6xl w-full mx-auto pb-2xl font-body-md">
                        <!-- Header Section -->
                        <div class="flex justify-between items-end mb-xl">
                            <div>

                                <h2 class="font-headline-lg text-headline-lg text-primary">
                                    Create Offer
                                </h2>
                                <p class="font-body-md text-body-md text-on-surface-variant">
                                    Create discounts for products or categories.
                                </p>
                            </div>
                            <div class="flex gap-md">
                                <button
