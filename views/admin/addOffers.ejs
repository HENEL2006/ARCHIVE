                    </main>
            </div>
            <!-- Micro-interaction Scripts -->
            <script>


                // Simple reactive style simulation for UI elements
                document.querySelectorAll('input, select, textarea').forEach(el => {
                    el.addEventListener('focus', () => {
                        el.parentElement.classList.add('opacity-100');
                    });
                    el.addEventListener('blur', () => {
                        // Return to normal
                    });
                });

                // Toggle logic simulation for radio groups (visual only)
                const radioGroups = document.querySelectorAll('input[type="radio"]');
                radioGroups.forEach(radio => {
                    radio.addEventListener('change', (e) => {
                        const groupName = e.target.name;
                        const siblings = document.querySelectorAll(`input[name="${groupName}"]`);
                        siblings.forEach(s => {
                            const label = s.closest('label');
                            if (label) {
                                if (s.checked) {
                                    label.classList.add('border-primary');
                                    label.classList.remove('border-outline-variant');
                                } else {
                                    label.classList.remove('border-primary');
                                    label.classList.add('border-outline-variant');
                                }
                            }
                        });
                    });
                });

                // ajax for the serach products

                const clearTargetSearch = document.getElementById("clearTargetSearch");
                const targetSearch = document.getElementById("targetSearch");
                const productSearchResults = document.getElementById("productSearchResults");
                const productTarget = document.getElementById("productTarget");
                const categoryTarget = document.getElementById("categoryTarget");
                const previewImage =
                    document.getElementById("previewImage");

                const previewDiscount =
                    document.getElementById("previewDiscount");

                const previewTargetType =
                    document.getElementById("previewTargetType");

                const previewName =
                    document.getElementById("previewName");

                const previewPriceSection =
                    document.getElementById("previewPriceSection");

                const previewCategoryMessage =
                    document.getElementById("previewCategoryMessage");

                const previewFinalPrice =
                    document.getElementById("previewFinalPrice");

                const previewOriginalPrice =
                    document.getElementById("previewOriginalPrice");

                const previewSavings =
                    document.getElementById("previewSavings");

                let selectedTargetPrice = 0;

                function updateOfferPreview() {

                    const type = getSearchType();

                    const discount =
                        Number(discountValue.value) || 0;


                    // =====================================
                    // DISCOUNT BADGE
                    // =====================================

                    if (discountType.value === "PERCENTAGE") {

                        previewDiscount.textContent =
                            `-${discount}%`;

                    } else {

                        previewDiscount.textContent =
                            `-₹${discount.toFixed(2)}`;

                    }


                    // =====================================
                    // PRODUCT
                    // =====================================

                    if (type === "PRODUCT") {

                        previewTargetType.textContent =
                            "PRODUCT OFFER";

                        previewPriceSection.classList.remove(
                            "hidden"
                        );

                        previewCategoryMessage.classList.add(
                            "hidden"
                        );


                        if (!selectedProduct.value) {

                            previewImage.src =
                                "/images/placeholder.jpg";

                            previewName.textContent =
                                "Select a product";

                            previewFinalPrice.textContent =
                                "₹0.00";

                            previewOriginalPrice.textContent =
                                "₹0.00";

                            previewSavings.textContent =
                                "You Save ₹0.00";

                            return;
                        }


                        const originalPrice =
                            Number(selectedTargetPrice) || 0;


                        let savings = 0;


                        if (discountType.value === "PERCENTAGE") {

                            savings =
                                originalPrice *
                                (discount / 100);

                        } else {

                            savings =
                                discount;

                        }


                        // Never allow discount above product price
                        savings =
                            Math.min(savings, originalPrice);


                        const finalPrice =
                            originalPrice - savings;


                        previewFinalPrice.textContent =
                            `₹${finalPrice.toFixed(2)}`;

                        previewOriginalPrice.textContent =
                            `₹${originalPrice.toFixed(2)}`;

                        previewSavings.textContent =
                            `You Save ₹${savings.toFixed(2)}`;

                    }


                    // =====================================
                    // CATEGORY
                    // =====================================

                    else {

                        previewTargetType.textContent =
                            "CATEGORY OFFER";

                        previewPriceSection.classList.add(
                            "hidden"
                        );

                        previewCategoryMessage.classList.remove(
                            "hidden"
                        );


                        if (!selectedCategory.value) {

                            previewImage.src =
                                "/images/placeholder.jpg";

                            previewName.textContent =
                                "Select a category";

                        }

                    }

                }

                function getSearchType() {
                    return categoryTarget.checked ? "CATEGORY" : "PRODUCT";
                }

                function updateSearchPlaceholder() {
                    if (categoryTarget.checked) {
                        targetSearch.placeholder = "Search categories...";
                    } else {
                        targetSearch.placeholder = "Search products...";
                    }
                }

                productTarget.addEventListener("change", () => {
                    updateSearchPlaceholder();

                    targetSearch.value = "";
                    clearTargetSearch.classList.add("hidden");
                    productSearchResults.innerHTML = "";
                    productSearchResults.classList.add("hidden");

                    document.getElementById("selectedProduct").value = "";
                    document.getElementById("selectedCategory").value = "";
                    document.getElementById("selectedProductContainer").classList.add("hidden");

                    updateOfferPreview()
                });

                categoryTarget.addEventListener("change", () => {
                    updateSearchPlaceholder();

                    targetSearch.value = "";
                    clearTargetSearch.classList.add("hidden");
                    productSearchResults.innerHTML = "";
                    productSearchResults.classList.add("hidden");

                    document.getElementById("selectedProduct").value = "";
                    document.getElementById("selectedCategory").value = "";
                    document.getElementById("selectedProductContainer").classList.add("hidden");

                    updateOfferPreview()
                });

                updateSearchPlaceholder();

                let searchTimeout;

                targetSearch.addEventListener("input", () => {
                    const search = targetSearch.value.trim();

                    clearTimeout(searchTimeout);

                    // Show / hide clear button
                    if (search) {
                        clearTargetSearch.classList.remove("hidden");
                    } else {
                        clearTargetSearch.classList.add("hidden");
                    }

                    if (!search) {
                        productSearchResults.innerHTML = "";
                        productSearchResults.classList.add("hidden");
                        return;
                    }

                    searchTimeout = setTimeout(async () => {
                        try {
                            const searchType = getSearchType();

                            const endpoint =
                                searchType === "CATEGORY"
                                    ? "/admin/offers/search-categories"
                                    : "/admin/offers/search-products";

                            const response = await fetch(
                                `${endpoint}?search=${encodeURIComponent(search)}`
                            );

                            const data = await response.json();

                            const results =
                                searchType === "CATEGORY"
                                    ? data.categories || []
                                    : data.products || [];


                            if (!data.success || results.length === 0) {

                                productSearchResults.innerHTML = `
        <div class="p-4 text-body-sm text-on-surface-variant">
            No ${searchType === "CATEGORY" ? "categories" : "products"} found.
        </div>
    `;

                                productSearchResults.classList.remove("hidden");

                                return;
                            }

                            productSearchResults.innerHTML = results
                                .map((item) => {
                                    const image =
                                        searchType === "PRODUCT"
                                            ? item.images && item.images.length > 0
                                                ? item.images[0]?.url
                                                : "/images/placeholder.jpg"
                                            : item.image || "/images/placeholder.jpg";

                                    const name = item.name;

                                    const price =
                                        searchType === "PRODUCT"
                                            ? `₹${item.price}`
                                            : "Category";

                                    return `
            <div
                class="product-result flex items-center gap-3 p-3 border-b border-outline-variant last:border-b-0 hover:bg-surface-container-low cursor-pointer"
                data-id="${item._id}"
                data-name="${item.name}"
                data-price="${item.price || ""}"
                data-image="${image}"
                data-type="${searchType}"
            >

                <img
                    src="${image}"
                    alt="${name}"
                    class="w-12 h-12 object-cover border border-outline-variant"
                >

                <div class="flex-1 min-w-0">
                    <p class="text-body-sm font-semibold text-primary truncate">
                        ${name}
                    </p>

                    <p class="text-[11px] text-on-surface-variant mt-1">
                        ${price}
                    </p>
                </div>

                <span class="text-[10px] font-bold uppercase tracking-widest text-primary">
                    Select
                </span>

            </div>
        `;
                                })
                                .join("");

                            document
                                .querySelectorAll(".product-result")
                                .forEach((productElement) => {

                                    productElement.addEventListener("click", () => {

                                        const targetId =
                                            productElement.dataset.id;

                                        const targetName =
                                            productElement.dataset.name;

                                        const targetPrice =
                                            productElement.dataset.price;

                                        const targetImage =
                                            productElement.dataset.image;

                                        const targetType =
                                            productElement.dataset.type;


                                        // Store price for live preview
                                        selectedTargetPrice =
                                            Number(targetPrice) || 0;


                                        if (targetType === "PRODUCT") {

                                            document.getElementById(
                                                "selectedProduct"
                                            ).value = targetId;

                                            document.getElementById(
                                                "selectedCategory"
                                            ).value = "";

                                        } else {

                                            document.getElementById(
                                                "selectedCategory"
                                            ).value = targetId;

                                            document.getElementById(
                                                "selectedProduct"
                                            ).value = "";

                                        }


                                        targetError.textContent = "";

                                        targetError.classList.add("hidden");


                                        document.getElementById(
                                            "selectedProductImage"
                                        ).src =
                                            targetImage ||
                                            "/images/placeholder.jpg";


                                        document.getElementById(
                                            "selectedProductImage"
                                        ).alt =
                                            targetName;


                                        document.getElementById(
                                            "selectedProductName"
                                        ).textContent =
                                            targetName;


                                        document.getElementById(
                                            "selectedProductPrice"
                                        ).textContent =
                                            targetType === "PRODUCT"
                                                ? `₹${targetPrice}`
                                                : "Entire Category";


                                        document
                                            .getElementById(
                                                "selectedProductContainer"
                                            )
                                            .classList.remove("hidden");


                                        productSearchResults.innerHTML = "";

                                        productSearchResults.classList.add(
                                            "hidden"
                                        );


                                        targetSearch.value =
                                            targetName;

                                        clearTargetSearch.classList.remove(
                                            "hidden"
                                        );


                                        // ==============================
                                        // UPDATE LIVE PREVIEW
                                        // ==============================

                                        previewImage.src =
                                            targetImage ||
                                            "/images/placeholder.jpg";

                                        previewName.textContent =
                                            targetName;

                                        updateOfferPreview();

                                    });

                                });

                            productSearchResults.classList.remove("hidden");



                        } catch (error) {
                            console.error("Product search error:", error);
                        }
                    }, 300);
                });

                clearTargetSearch.addEventListener("click", () => {
                    targetSearch.value = "";

                    clearTargetSearch.classList.add("hidden");

                    productSearchResults.innerHTML = "";
                    productSearchResults.classList.add("hidden");

                    targetSearch.focus();
                });

                document
                    .getElementById("removeSelectedProduct")
                    .addEventListener("click", () => {
                        document.getElementById("selectedProduct").value = "";
                        document.getElementById("selectedCategory").value = "";

                        document
                            .getElementById("selectedProductContainer")
                            .classList.add("hidden");

                        document.getElementById("selectedProductImage").src = "";
                        document.getElementById("selectedProductName").textContent = "";
                        document.getElementById("selectedProductPrice").textContent = "";

                        targetSearch.value = "";

                        selectedTargetPrice = 0;

                        updateOfferPreview();
                    });

                // frontend validations

                const offerName = document.getElementById("offerName");
                const targetError = document.getElementById("targetError");
                const discountType = document.getElementById("discountType");
                const discountSymbol = document.getElementById("discountSymbol");
                const discountValue = document.getElementById("discountValue");
                const discountTypeError = document.getElementById("discountTypeError");
                const discountValueError = document.getElementById("discountValueError");
                const startDate = document.getElementById("startDate");
                const expiryDate = document.getElementById("expiryDate");
                const startDateError = document.getElementById("startDateError");
                const expiryDateError = document.getElementById("expiryDateError");
                const statusError = document.getElementById("statusError");

                discountType.addEventListener("change", () => {
                    if (discountType.value === "FIXED") {
                        discountSymbol.textContent = "₹";
                    } else {
                        discountSymbol.textContent = "%";
                    }

                    clearError(discountType, discountTypeError);

                    // Revalidate discount value if the user already entered one
                    if (discountValue.value.trim()) {
                        const value = Number(discountValue.value);

                        if (
                            value > 0 &&
                            (discountType.value !== "PERCENTAGE" || value <= 100)
                        ) {
                            clearError(discountValue, discountValueError);
                        } else {
                            validateOfferForm();
                        }
                    }

                    updateOfferPreview()
                });

                discountValue.addEventListener("input", () => {

                    updateOfferPreview();

                });

                function showError(input, errorElement, message) {
                    input.classList.remove("border-outline-variant");
                    input.classList.add("border-red-500");

                    errorElement.textContent = message;
                    errorElement.classList.remove("hidden");
                }

                function clearError(input, errorElement) {
                    input.classList.remove("border-red-500");
                    input.classList.add("border-outline-variant");

                    errorElement.textContent = "";
                    errorElement.classList.add("hidden");
                }

                function validateOfferForm() {
                    let isValid = true;

                    // Offer Name
                    const name = offerName.value.trim();

                    if (!name) {
                        showError(
                            offerName,
                            document.getElementById("offerNameError"),
                            "Offer name is required."
                        );
                        isValid = false;
                    } else if (name.length > 100) {
                        showError(
                            offerName,
                            document.getElementById("offerNameError"),
                            "Offer name must be 100 characters or less."
                        );
                        isValid = false;
                    } else {
                        clearError(
                            offerName,
                            document.getElementById("offerNameError")
                        );
                    }

                    // Product / Category
                    const searchType = getSearchType();

                    const selectedProduct =
                        document.getElementById("selectedProduct").value;

                    const selectedCategory =
                        document.getElementById("selectedCategory").value;

                    if (searchType === "PRODUCT" && !selectedProduct) {
                        targetError.textContent = "Please select a product.";
                        targetError.classList.remove("hidden");
                        isValid = false;
                    } else if (searchType === "CATEGORY" && !selectedCategory) {
                        targetError.textContent = "Please select a category.";
                        targetError.classList.remove("hidden");
                        isValid = false;
                    } else {
                        targetError.textContent = "";
                        targetError.classList.add("hidden");
                    }

                    // Discount Type
                    if (!discountType.value) {
                        showError(
                            discountType,
                            discountTypeError,
                            "Please select a discount type."
                        );
                        isValid = false;
                    } else {
                        clearError(discountType, discountTypeError);
                    }

                    // Discount Value
                    const value = Number(discountValue.value);

                    if (!discountValue.value.trim()) {
                        showError(
                            discountValue,
                            discountValueError,
                            "Discount value is required."
                        );
                        isValid = false;
                    } else if (value <= 0) {
                        showError(
                            discountValue,
                            discountValueError,
                            "Discount value must be greater than 0."
                        );
                        isValid = false;
                    } else if (
                        discountType.value === "PERCENTAGE" &&
                        value > 100
                    ) {
                        showError(
                            discountValue,
                            discountValueError,
                            "Percentage discount cannot exceed 100%."
                        );
                        isValid = false;
                    } else {
                        clearError(discountValue, discountValueError);
                    }

                    // Start Date
                    if (!startDate.value) {
                        showError(
                            startDate,
                            startDateError,
                            "Start date is required."
                        );
                        isValid = false;
                    } else {
                        clearError(startDate, startDateError);
                    }

                    // Expiry Date
                    if (!expiryDate.value) {
                        showError(
                            expiryDate,
                            expiryDateError,
                            "End date is required."
                        );
                        isValid = false;
                    } else if (
                        startDate.value &&
                        expiryDate.value <= startDate.value
                    ) {
                        showError(
                            expiryDate,
                            expiryDateError,
                            "End date must be after the start date."
                        );
                        isValid = false;
                    } else {
                        clearError(expiryDate, expiryDateError);
                    }

                    // Status
                    const selectedStatus =
                        document.querySelector('input[name="status"]:checked');

                    if (!selectedStatus) {
                        statusError.textContent = "Please select a status.";
                        statusError.classList.remove("hidden");
                        isValid = false;
                    } else {
                        statusError.textContent = "";
                        statusError.classList.add("hidden");
                    }

                    return isValid;
                }

                const publishOffer = document.getElementById("publishOffer");

                publishOffer.addEventListener("click", async () => {
                    console.log("PUBLISH CLICKED")
                    const isValid = validateOfferForm();
                    console.log("VALIDATION RESULT:", isValid);

                    if (!isValid) {
                        console.log("FORM INVALID");
                        return;
                    }

                    const formData = {
                        name: offerName.value.trim(),
                        type: getSearchType(),
                        product: document.getElementById("selectedProduct").value || null,
                        category: document.getElementById("selectedCategory").value || null,
                        discountType: discountType.value,
                        discountValue: Number(discountValue.value),
                        startDate: startDate.value,
                        expiryDate: expiryDate.value,
                        status: document.querySelector('input[name="status"]:checked').value,
                    };

                    console.log("OFFER DATA:", formData);

                    try {
                        const response = await fetch("/admin/addOffer", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(formData),
                        });

                        const data = await response.json();

                        console.log("SERVER RESPONSE:", data);

                        if (data.success) {
                            window.location.href = "/admin/offers";
                        } else {
                            console.error(data.message);
                        }
                    } catch (error) {
                        console.error("Create offer error:", error);
                    }
                });

                // Remove Offer Name error while typing
                offerName.addEventListener("input", () => {
                    const error = document.getElementById("offerNameError");

                    if (offerName.value.trim()) {
                        clearError(offerName, error);
                    }
                });





                // Remove discount value error while typing
                discountValue.addEventListener("input", () => {
                    const value = Number(discountValue.value);

                    if (
                        discountValue.value.trim() &&
                        value > 0 &&
                        (discountType.value !== "PERCENTAGE" || value <= 100)
                    ) {
                        clearError(discountValue, discountValueError);
                    }
                });


                // Remove start date error when selected
                startDate.addEventListener("change", () => {
                    if (startDate.value) {
                        clearError(startDate, startDateError);
                    }

                    // If expiry date was previously invalid because of the start date,
                    // validate it again
                    if (expiryDate.value && expiryDate.value > startDate.value) {
                        clearError(expiryDate, expiryDateError);
                    }
                });


                // Remove expiry date error when corrected
                expiryDate.addEventListener("change", () => {
                    if (
                        expiryDate.value &&
                        startDate.value &&
                        expiryDate.value > startDate.value
                    ) {
                        clearError(expiryDate, expiryDateError);
                    }
                });


                // Remove status error when a status is selected
                document.querySelectorAll('input[name="status"]').forEach((radio) => {
                    radio.addEventListener("change", () => {
                        statusError.textContent = "";
                        statusError.classList.add("hidden");
                    });
                });


            </script>


</body>

</html>