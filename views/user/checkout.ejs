<button class="w-full bg-primary text-on-primary font-label-caps text-label-caps py-6 mt-12 hover:opacity-90 transition-opacity tracking-widest text-lg">PLACE ORDER</button>
</div>
</div>
</div>
</main>
<!-- Footer -->
<%- include("partials/userFooter") %>
</body></html>