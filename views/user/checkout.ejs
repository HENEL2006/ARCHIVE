<p class="font-mono-data text-mono-data text-secondary">SIZE: L / QTY: 1</p>
<p class="font-mono-data text-mono-data mt-1">$285.00</p>
</div>
</div>
<!-- Item 2 -->
<div class="flex gap-4 items-start">
<div class="w-[60px] h-[60px] border border-primary flex-shrink-0">
<img alt="Inter 2002" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/AP1WRLtGhytMttdlrgkSgyMY94FphCNA2ILfdNBNtZGFCWYhiPNuB-t83JAORqvexRavH_ou3AfsBf6-KPMzffC58TxW1PAFuIv0xTae5zGsh_fZTknDu7eVYkHM8T8GlZpJQvVoohUxV0sa_OhoJMR5Au_bzbdTdNACeiVKbLPtv-A1y0yo_bvvZNniahkOJsOZGxSu9u4RmkQENv5myYMh-3wiZnq7vICnqk6OQ0jFQ9cMz_6fRgFpT5UcNqw"/>
</div>
<div class="flex-grow">
<h4 class="font-label-caps text-label-caps leading-none mb-1">INTER MILAN</h4>
<p class="font-mono-data text-mono-data text-secondary">SIZE: M / QTY: 1</p>
<p class="font-mono-data text-mono-data mt-1">$210.00</p>
</div>
</div>
<!-- More Items -->
<div class="flex justify-between items-center pt-2">
<span class="font-mono-data text-mono-data text-secondary uppercase">+3 MORE ITEMS</span>
