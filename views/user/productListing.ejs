<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>ALL JERSEYS | ARCHIVE</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed-variant": "#474747",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "outline": "#7e7576",
                        "accent-success": "#22CD5B",
                        "on-secondary-fixed": "#1a1c1c",
                        "background": "#fcf9f8",
                        "on-primary": "#ffffff",
                        "surface-container-high": "#ebe7e7",
                        "secondary-container": "#dfe0e0",
                        "on-surface": "#1c1b1b",
                        "primary-fixed": "#e2e2e2",
                        "on-tertiary-container": "#848484",
                        "error": "#ba1a1a",
                        "secondary": "#5d5f5f",
                        "on-primary-fixed-variant": "#474747",
                        "tertiary-container": "#1b1b1b",
                        "on-tertiary-fixed": "#1b1b1b",
                        "surface": "#fcf9f8",
                        "inverse-surface": "#313030",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#cfc4c5",
                        "primary": "#000000",
                        "on-tertiary": "#ffffff",
                        "primary-fixed-dim": "#c6c6c6",
                        "surface-container-low": "#f6f3f2",
                        "on-surface-variant": "#4c4546",
                        "on-secondary-container": "#616363",
                        "inverse-on-surface": "#f3f0ef",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#e2e2e2",
                        "secondary-fixed": "#e2e2e2",
                        "primary-container": "#1b1b1b",
                        "on-background": "#1c1b1b",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e5e2e1",
                        "secondary-fixed-dim": "#c6c6c7",
                        "on-secondary": "#ffffff",
                        "inverse-primary": "#c6c6c6",
                        "on-error-container": "#93000a",
                        "on-primary-container": "#848484",
                        "on-secondary-fixed-variant": "#454747",
                        "on-primary-fixed": "#1b1b1b",
                        "tertiary": "#000000",
                        "surface-dim": "#dcd9d9",
                        "surface-container": "#f0edec",
                        "surface-bright": "#fcf9f8",
                        "surface-tint": "#5e5e5e",
                        "surface-container-highest": "#e5e2e1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "0px"
                    },
                    "spacing": {
                        "mobile-margin": "20px",
                        "grid-gutter": "0px",
                        "section-gap": "128px",
                        "unit": "8px",
                        "container-padding": "64px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        /* Custom scrollbar for brutalist feel */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #fcf9f8;
        }

        ::-webkit-scrollbar-thumb {
            background: #000000;
        }
    </style>
</head>

<body class="bg-background text-primary font-body-md selection:bg-primary selection:text-background">
    <!-- TopNavBar -->
    <%- include("./partials/userHeader") %>
        <%- include("partials/toast") %>
            <main class="pt-20">
                <!-- Hero Section -->
                <header class="pt-section-gap px-container-padding border-b border-primary pb-16">
                    <h1 class="font-display-xl text-display-xl mb-8 uppercase leading-none">

                        <% if (selectedCategory) { %>

                            <% if ( selectedCategory.name==="National Jerseys" ||
                                selectedCategory.name==="Limited Editions" ) { %>

                                <%- selectedCategory.name.replace(" ", " <br>") %>

                                    <% } else { %>

                                        <%= selectedCategory.name %>

                                            <% } %>

                                                <% } else { %>

                                                    ALL JERSEYS

                                                    <% } %>

                    </h1>
                    <div class="grid grid-cols-12 gap-0">
                        <p class="col-span-12 md:col-span-6 font-body-lg text-body-lg leading-relaxed text-secondary">

                            <% if (selectedCategory) { %>

                                <%= selectedCategory.description %>

                                    <% } else { %>

                                        A curated collection of iconic football shirts from clubs,
                                        national teams, and historic competitions across different eras.
                                        Each piece represents a moment in time, a stitch in the fabric of
                                        global football culture.

                                        <% } %>

                        </p>
                        <div class="col-span-12 md:col-span-6 flex justify-end items-end">

                        </div>
                    </div>
                </header>
                <!-- Main Content Area -->
                <section class="grid grid-cols-12">
                    <!-- Left Sidebar: Filters -->
                    <aside class="col-span-12 md:col-span-3 border-r border-primary p-container-padding">
                        <div class="sticky top-32 space-y-12">
                            <form id="filterForm" action="/products" method="GET">

                                <input type="hidden" name="search" value="<%= query.search || '' %>">
                                <input type="hidden" name="sort" value="<%= query.sort || '' %>">

                                <h3 class="font-label-caps text-label-caps mb-6 opacity-40">
                                    CATEGORIES
                                </h3>

                                <ul class="space-y-4 font-mono-data text-mono-data uppercase">

                                    <!-- ALL -->

                                    <li>

                                        <label class="flex justify-between items-center cursor-pointer group">

                                            <span
                                                class="<%= !query.category ? 'text-primary' : 'text-secondary group-hover:text-primary' %> transition-colors duration-200">

                                                All Jerseys

                                            </span>

                                            <span class="
                    transition-all duration-200
                    <%= !query.category ? 'opacity-100' : 'opacity-0 group-hover:opacity-30' %>">

                                                ✓

                                            </span>

                                            <input type="radio" name="category" value="" class="hidden"
                                                <%=!query.category ? "checked" : "" %>>

                                        </label>

                                    </li>

                                    <% categories.forEach(category=> { %>

                                        <li>

                                            <label
                                                class="flex justify-between items-center cursor-pointer group text-secondary hover:text-primary transition-colors duration-200">

                                                <span
                                                    class="<%= query.category === String(category._id) ? 'text-primary' : 'text-secondary group-hover:text-primary' %> transition-colors duration-200">

                                                    <%= category.name %>

                                                </span>

                                                <span class="
                        transition-all duration-200
                        <%= query.category === String(category._id)
                            ? 'opacity-100'
                            : 'opacity-0 group-hover:opacity-30' %>">

                                                    ✓

                                                </span>

                                                <input type="radio" name="category" value="<%= category._id %>"
                                                    class="hidden" <%=query.category===String(category._id) ? "checked"
                                                    : "" %>>

                                            </label>

                                        </li>

                                        <% }) %>

                                </ul>


                                <div class="mt-12">

                                    <h3 class="font-label-caps text-label-caps mb-6 opacity-40">
                                        FILTERS
                                    </h3>

                                    <ul class="space-y-4 font-mono-data text-mono-data uppercase">

                                        <!-- Size -->

                                        <li>

                                            <button type="button" id="sizeToggle"
                                                class="w-full flex justify-between items-center text-secondary hover:text-primary transition-colors">

                                                <span>Size</span>

                                                <span id="sizeIcon"
                                                    class="material-symbols-outlined text-[16px] transition-transform duration-300">
                                                    add
                                                </span>

                                            </button>

                                            <div id="sizeDropdown"
                                                class="max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-in-out">
                                                <div class="mt-4 pl-1 space-y-3">

                                                    <% ["S","M","L","XL","XXL"].forEach(size=> { %>

                                                        <label
                                                            class="flex items-center justify-between cursor-pointer group">

                                                            <span
                                                                class="text-secondary group-hover:text-primary transition-colors">
                                                                <%= size %>
                                                            </span>

                                                            <input type="checkbox" name="size" value="<%= size %>"
                                                                <%=query.size===size ? "checked" : "" %>
                                                            class="hidden">

                                                            <span class="
                                                            transition-all duration-200
                                                            <%= query.size === size
                                                                ? 'opacity-100'
                                                                : 'opacity-0 group-hover:opacity-30' %>">

                                                                ✓

                                                            </span>

                                                        </label>

                                                        <% }) %>

                                                </div>
                                            </div>

                                        </li>


                                        <!-- Price -->

                                        <li>

                                            <button type="button" id="priceToggle"
                                                class="w-full flex justify-between items-center text-secondary hover:text-primary transition-colors">

                                                <span>Price Range</span>

                                                <span id="priceIcon"
                                                    class="material-symbols-outlined text-[16px] transition-transform duration-300">

                                                    add

                                                </span>

                                            </button>

                                            <div id="priceDropdown"
                                                class="max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-[cubic-bezier(.22,1,.36,1)]">
                                                <div class="mt-4 pl-1 space-y-3">

                                                    <label class="flex justify-between cursor-pointer group">

                                                        <span class="text-secondary group-hover:text-primary">
                                                            ₹0 – ₹999
                                                        </span>

                                                        <input type="radio" name="price" value="0-999" class="hidden"
                                                            <%=query.price==="0-999" ? "checked" : "" %>>

                                                        <span class="<%= query.price === '0-999'
                                                    ? 'opacity-100'
                                                    : 'opacity-0 group-hover:opacity-30'
                                                    %>">

                                                            ✓

                                                        </span>

                                                    </label>

                                                    <label class="flex justify-between cursor-pointer group">

                                                        <span class="text-secondary group-hover:text-primary">
                                                            ₹1000 – ₹1999
                                                        </span>

                                                        <input type="radio" name="price" value="1000-1999"
                                                            class="hidden" <%=query.price==="1000-1999" ? "checked" : ""
                                                            %>>

                                                        <span class="<%= query.price === '1000-1999'
                                                    ? 'opacity-100'
                                                    : 'opacity-0 group-hover:opacity-30'
                                                    %>">

                                                            ✓

                                                        </span>

                                                    </label>

                                                    <label class="flex justify-between cursor-pointer group">

                                                        <span class="text-secondary group-hover:text-primary">
                                                            ₹2000+
                                                        </span>

                                                        <input type="radio" name="price" value="2000" class="hidden"
                                                            <%=query.price==="2000" ? "checked" : "" %>>

                                                        <span class="<%= query.price === '2000'
                                                    ? 'opacity-100'
                                                    : 'opacity-0 group-hover:opacity-30'
                                                    %>">

                                                            ✓

                                                        </span>

                                                    </label>

                                                </div>
                                            </div>

                                        </li>


                                        <!-- Brand -->

                                        <li>

                                            <button type="button" id="brandToggle"
                                                class="w-full flex justify-between items-center text-secondary hover:text-primary transition-colors">

                                                <span>Brand</span>

                                                <span id="brandIcon"
                                                    class="material-symbols-outlined text-[16px] transition-transform duration-300">

                                                    add

                                                </span>

                                            </button>

                                            <div id="brandDropdown"
                                                class="max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-[cubic-bezier(.22,1,.36,1)]">
                                                <div class="mt-4 pl-1 space-y-3">
                                                    <% brands.forEach(brand=> { %>

                                                        <label class="flex justify-between cursor-pointer group">

                                                            <span class="text-secondary group-hover:text-primary">
                                                                <%= brand %>
                                                            </span>

                                                            <input type="radio" name="brand" value="<%= brand %>"
                                                                class="hidden" <%=query.brand===brand ? "checked" : ""
                                                                %>>

                                                            <span class="<%= query.brand === brand
                                                        ? 'opacity-100'
                                                        : 'opacity-0 group-hover:opacity-30' %>">
                                                                ✓
                                                            </span>

                                                        </label>

                                                        <% }) %>

                                                </div>
                                            </div>

                                        </li>

                                    </ul>

                                </div>
                                <a href="/products"
                                    class="block w-full mt-10 border border-primary py-4 text-center font-label-caps text-label-caps hover:bg-primary hover:text-white">

                                    RESET FILTERS

                                </a>
                            </form>
                        </div>
                    </aside>
                    <!-- Right Content: Product Grid -->
                    <div class="col-span-12 md:col-span-9">
                        <!-- Sorting Bar -->

                        <div class="flex justify-between items-center border-b border-primary px-8 py-6">

                            <form id="searchForm" action="/products" method="GET"
                                class="flex items-center w-[420px] border-b border-primary pb-2">

                                <input type="hidden" name="category" value="<%= query.category || '' %>">
                                <input type="hidden" name="price" value="<%= query.price || '' %>">
                                <input type="hidden" name="brand" value="<%= query.brand || '' %>">
                                <input type="hidden" name="sort" value="<%= query.sort || '' %>">
                                <input type="hidden" name="size" value="<%= query.size || '' %>">

                                <span class="material-symbols-outlined text-[18px] text-secondary mr-3">
                                    search
                                </span>

                                <div class="relative flex-1">

                                    <input id="searchInput" type="text" name="search" value="<%= query.search || '' %>"
                                        placeholder="SEARCH JERSEYS..."
                                        class="w-full bg-transparent border-none outline-none focus:ring-0 font-mono-data text-mono-data uppercase placeholder:text-secondary placeholder:opacity-60 pr-10">

                                    <button id="clearSearch" type="button"
                                        class="<%= query.search ? 'flex' : 'hidden' %> absolute right-1 top-1/2 -translate-y-1/2 items-center justify-center text-secondary hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">
                                            close
                                        </span>
                                    </button>

                                </div>

                            </form>

                            <div class="relative">

                                <button id="sortToggle" type="button"
                                    class="flex items-center gap-2 font-label-caps text-label-caps cursor-pointer group">

                                    <span>

                                        SORT BY :

                                        <%= query.sort==="priceAsc" ? "PRICE LOW → HIGH" : query.sort==="priceDesc"
                                            ? "PRICE HIGH → LOW" : query.sort==="a-z" ? "A → Z" : query.sort==="z-a"
                                            ? "Z → A" : query.sort==="oldest" ? "OLDEST" : "NEWEST" %>

                                    </span>

                                    <span id="sortIcon"
                                        class="material-symbols-outlined group-hover:translate-y-1 transition-all duration-300">

                                        keyboard_arrow_down

                                    </span>

                                </button>

                                <div id="sortDropdown"
                                    class="absolute right-0 top-full w-64 border border-primary bg-background max-h-0 opacity-0 overflow-hidden transition-all duration-300 z-50">

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="newest">
                                        NEWEST
                                    </button>

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="oldest">
                                        OLDEST
                                    </button>

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="priceAsc">
                                        PRICE LOW → HIGH
                                    </button>

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="priceDesc">
                                        PRICE HIGH → LOW
                                    </button>

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="a-z">
                                        A → Z
                                    </button>

                                    <button type="button"
                                        class="sortOption w-full px-6 py-3 text-left hover:bg-primary hover:text-white"
                                        data-sort="z-a">
                                        Z → A
                                    </button>
                                </div>

                            </div>

                        </div>
                        <!-- Product Grid 1 -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
                            <% products.forEach(product=> { %>

                                <div class="border-r border-b border-primary group">

                                    <!-- Product Image -->
                                    <div
                                        class="product-image-container aspect-[4/5] bg-surface-container-low overflow-hidden relative">

                                        <a href="/product/<%= product.slug %>" class="block w-full h-full">

                                            <% product.images.forEach((image, index)=> { %>

                                                <img src="<%= image.url %>" alt="<%= product.name %>"
                                                    class="product-hover-image absolute inset-0 w-full h-full object-cover transition-opacity duration-700 <%= index === 0 ? 'opacity-100' : 'opacity-0' %>">

                                                <% }) %>

                                        </a>


                                        <!-- Wishlist Button -->
                                        <!-- Wishlist Button -->
                                        <button type="button" class="wishlist-btn absolute top-5 right-5 z-20
           flex items-center justify-center
           text-black
           opacity-80
           hover:opacity-100
           transition-all duration-300
           group/wishlist" data-product-id="<%= product._id %>"
                                            data-wishlisted="<%= wishlistIds.includes(product._id.toString()) %>"
                                            aria-label="<%= wishlistIds.includes(product._id.toString()) ? 'Remove from wishlist' : 'Add to wishlist' %>">
                                            <span class="material-symbols-outlined wishlist-icon text-[22px]" style="
            font-variation-settings:
            'FILL' <%= wishlistIds.includes(product._id.toString()) ? 1 : 0 %>,
            'wght' 400,
            'GRAD' 0,
            'opsz' 24;
        ">
                                                <%= wishlistIds.includes(product._id.toString()) ? "favorite"
                                                    : "favorite_border" %>
                                            </span>
                                        </button>
                                    </div>


                                    <!-- Product Details -->
                                    <a href="/product/<%= product.slug %>" class="block">

                                        <div class="p-6 border-t border-primary bg-background text-primary
                transition-colors duration-300
                group-hover:bg-primary group-hover:text-on-primary">

                                            <p class="font-mono-data text-[10px] text-secondary mb-1 uppercase
                    transition-colors duration-300
                    group-hover:text-on-primary">
                                                <%= product.category.name %>
                                            </p>

                                            <h4 class="font-label-caps text-label-caps mb-4 uppercase
                    transition-colors duration-300
                    group-hover:text-on-primary">
                                                <%= product.name %>
                                            </h4>

                                            <p class="font-body-md text-body-md
                    transition-colors duration-300
                    group-hover:text-on-primary">
                                                ₹<%= product.price.toLocaleString() %>
                                            </p>

                                        </div>

                                    </a>

                                </div>

                                <% }) %>
                        </div>

                        <!-- Pagination -->

                        <% if (pagination.totalPages> 1) { %>

                            <div class="border-t border-primary">

                                <div class="flex items-center justify-between px-12 py-6">

                                    <!-- Previous -->

                                    <% if (pagination.currentPage> 1) { %>

                                        <a href="/products?<%= new URLSearchParams({...query,page:pagination.currentPage-1}).toString() %>"
                                            class="font-mono-data text-mono-data uppercase tracking-[0.18em] hover:opacity-60 transition">
                                            ← PREVIOUS
                                        </a>

                                        <% } else { %>

                                            <span
                                                class="font-mono-data text-mono-data uppercase tracking-[0.18em] opacity-25">
                                                ← PREVIOUS
                                            </span>

                                            <% } %>

                                                <!-- Pages -->

                                                <div class="flex items-center gap-4">

                                                    <% for(let i=1; i <=pagination.totalPages; i++) { %>

                                                        <% if(i===pagination.currentPage) { %>

                                                            <span
                                                                class="border-b border-primary pb-1 font-label-caps text-label-caps">
                                                                <%= String(i).padStart(2,"0") %>
                                                            </span>

                                                            <% } else { %>

                                                                <a href="/products?<%= new URLSearchParams({...query,page:i}).toString() %>"
                                                                    class="font-label-caps text-label-caps opacity-40 hover:opacity-100 transition">
                                                                    <%= String(i).padStart(2,"0") %>
                                                                </a>

                                                                <% } %>

                                                                    <% } %>

                                                </div>

                                                <!-- Next -->

                                                <% if (pagination.currentPage < pagination.totalPages) { %>

                                                    <a href="/products?<%= new URLSearchParams({...query,page:pagination.currentPage+1}).toString() %>"
                                                        class="font-mono-data text-mono-data uppercase tracking-[0.18em] hover:opacity-60 transition">
                                                        NEXT →
                                                    </a>

                                                    <% } else { %>

                                                        <span
                                                            class="font-mono-data text-mono-data uppercase tracking-[0.18em] opacity-25">
                                                            NEXT →
                                                        </span>

                                                        <% } %>

                                </div>

                            </div>

                            <% } %>

                </section>

                </section>


                <!-- Museum Archive Piece -->
                <section class="border-b border-primary grid grid-cols-1 md:grid-cols-12 bg-surface-container-low">
                    <div class="col-span-12 md:col-span-7 border-r border-primary">

                    </div>

                </section>
                <!-- Newsletter Section -->
                <section class="px-container-padding py-section-gap text-center max-w-4xl mx-auto">
                    <h3 class="font-headline-md text-headline-md uppercase mb-4 tracking-tight">STAY IN THE ARCHIVE
                    </h3>
                    <p class="font-body-md text-body-md text-secondary mb-12">Receive weekly notifications on new
                        drops,
                        museum acquisitions, and journal entries.</p>
                    <form class="flex border-b border-primary pb-2 max-w-lg mx-auto">
                        <input
                            class="bg-transparent border-none focus:ring-0 w-full font-mono-data text-mono-data uppercase placeholder:opacity-30"
                            placeholder="YOUR_EMAIL@ARCHIVE.COM" type="email">
                        <button class="font-label-caps text-label-caps hover:translate-x-2 transition-transform"
                            type="submit">
                            SUBSCRIBE
                        </button>
                    </form>
                </section>
            </main>
            <div id="toast" class="hidden fixed top-6 right-6 z-[9999]
           bg-black text-white
           px-5 py-3
           text-sm">
            </div>
            <!-- Footer -->
            <%- include("partials/userFooter") %>
                <script>
                    // Micro-interactions for product images
                    // Product image hover slideshow

                    document.querySelectorAll(".product-image-container").forEach(container => {

                        const images = container.querySelectorAll(".product-hover-image");

                        console.log("Product images found:", images.length);

                        if (images.length <= 1) {
                            return;
                        }

                        let currentIndex = 0;
                        let slideshowInterval = null;

                        container.addEventListener("mouseenter", () => {

                            console.log("HOVER START");

                            // Show next image immediately
                            currentIndex = 1;

                            images.forEach((image, index) => {
                                image.style.opacity = index === currentIndex ? "1" : "0";
                            });

                            slideshowInterval = setInterval(() => {

                                images[currentIndex].style.opacity = "0";

                                currentIndex++;

                                if (currentIndex >= images.length) {
                                    currentIndex = 0;
                                }

                                images[currentIndex].style.opacity = "1";

                            }, 1200);

                        });

                        container.addEventListener("mouseleave", () => {

                            console.log("HOVER END");

                            clearInterval(slideshowInterval);

                            slideshowInterval = null;

                            images.forEach((image, index) => {
                                image.style.opacity = index === 0 ? "1" : "0";
                            });

                            currentIndex = 0;

                        });

                    });
                    document
                        .querySelectorAll("input[name='category']")
                        .forEach(radio => {

                            radio.addEventListener("change", () => {

                                document
                                    .getElementById("filterForm")
                                    .submit();

                            });

                        });



                    function setupDropdown(toggleId, dropdownId, iconId) {

                        const toggle = document.getElementById(toggleId);
                        const dropdown = document.getElementById(dropdownId);
                        const icon = document.getElementById(iconId);

                        toggle.addEventListener("click", () => {

                            const isOpen = dropdown.classList.contains("max-h-96");

                            if (isOpen) {

                                dropdown.classList.remove(
                                    "max-h-96",
                                    "opacity-100",
                                    "mt-4"
                                );

                                dropdown.classList.add(
                                    "max-h-0",
                                    "opacity-0"
                                );

                                icon.classList.remove("rotate-45");

                            } else {

                                dropdown.classList.remove(
                                    "max-h-0",
                                    "opacity-0"
                                );

                                dropdown.classList.add(
                                    "max-h-96",
                                    "opacity-100",
                                    "mt-4"
                                );

                                icon.classList.add("rotate-45");

                            }

                        });

                    }

                    setupDropdown("sizeToggle", "sizeDropdown", "sizeIcon");
                    setupDropdown("priceToggle", "priceDropdown", "priceIcon");
                    setupDropdown("brandToggle", "brandDropdown", "brandIcon");
                    setupDropdown("sortToggle", "sortDropdown", "sortIcon");

                    document.querySelectorAll("input[name='price']").forEach(radio => {

                        radio.addEventListener("change", () => {

                            document.getElementById("filterForm").submit();

                        });

                    });

                    document.querySelectorAll("input[name='brand']").forEach(radio => {

                        radio.addEventListener("change", () => {

                            document.getElementById("filterForm").submit();

                        });

                    });

                    document.querySelectorAll("input[name='size']").forEach(input => {

                        input.addEventListener("change", () => {

                            document.getElementById("filterForm").submit();

                        });

                    });

                    document.querySelectorAll(".sortOption").forEach(option => {

                        option.addEventListener("click", () => {

                            const sort = option.dataset.sort;

                            const params = new URLSearchParams(window.location.search);

                            params.set("sort", sort);

                            window.location.href = "/products?" + params.toString();

                        });

                    });



                    const searchForm = document.getElementById("searchForm");
                    const searchInput = document.getElementById("searchInput");
                    const clearSearch = document.getElementById("clearSearch");

                    function updateClearButton() {

                        clearSearch.classList.toggle(
                            "hidden",
                            searchInput.value.trim() === ""
                        );

                    }

                    updateClearButton();

                    let searchTimer;

                    searchInput.addEventListener("input", () => {

                        clearTimeout(searchTimer);

                        clearSearch.classList.toggle(
                            "hidden",
                            searchInput.value.trim() === ""
                        );

                        searchTimer = setTimeout(() => {
                            searchForm.submit();
                        }, 500);

                    });

                    clearSearch.addEventListener("click", () => {

                        searchInput.value = "";

                        clearSearch.classList.add("hidden");

                        searchForm.submit();

                    });

                    document.querySelectorAll(".wishlist-btn").forEach((button) => {

                        button.addEventListener("click", async (event) => {

                            event.preventDefault();
                            event.stopPropagation();

                            const productId = button.dataset.productId;
                            const isWishlisted = button.dataset.wishlisted === "true";

                            const icon = button.querySelector(".wishlist-icon");

                            const url = isWishlisted
                                ? "/wishlist/remove"
                                : "/wishlist/add";

                            try {

                                const response = await fetch(url, {
                                    method: "POST",

                                    headers: {
                                        "Content-Type": "application/json",
                                    },

                                    body: JSON.stringify({
                                        productId,
                                    }),
                                });

                                const data = await response.json();

                                if (data.success) {

                                    if (isWishlisted) {

                                        // ♥ → ♡
                                        icon.textContent = "favorite_border";

                                        icon.style.fontVariationSettings =
                                            "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24";

                                        button.dataset.wishlisted = "false";

                                        button.setAttribute(
                                            "aria-label",
                                            "Add to wishlist"
                                        );

                                    } else {

                                        // ♡ → ♥
                                        icon.textContent = "favorite";

                                        icon.style.fontVariationSettings =
                                            "'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24";

                                        button.dataset.wishlisted = "true";

                                        button.setAttribute(
                                            "aria-label",
                                            "Remove from wishlist"
                                        );
                                    }

                                    showToast(data.message, "success");

                                } else {

                                    showToast(data.message, "error");
                                }

                            } catch (error) {

                                console.error("Wishlist error:", error);

                                showToast(
                                    error.message || "SOMETHING WENT WRONG",
                                    "error"
                                );
                            }

                        });

                    });
                </script>


</body>

</html>