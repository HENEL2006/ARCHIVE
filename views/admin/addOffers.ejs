                        </div>
                        <!-- Bottom Actions -->
                        <div class="mt-xl pt-xl border-t border-outline-variant flex justify-end items-center gap-lg">

                            <div class="flex gap-md">
                                <button
                                    class="px-xl py-3 border border-outline text-body-sm font-bold uppercase tracking-widest hover:bg-surface-container-low transition-colors">
                                    Cancel
                                </button>

                                <button id="publishOffer" type="button"
                                    class="px-2xl py-3 bg-primary text-on-primary text-body-sm font-bold uppercase tracking-widest hover:opacity-90 transition-opacity">
                                    Publish Offer
                                </button>
                            </div>
