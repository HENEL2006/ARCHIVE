<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>ARCHIVE | ARCHIVAL FOOTBALL GRAILS</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&amp;family=Syne:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <style>
        @keyframes marquee {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .animate-marquee {
            display: flex;
            white-space: nowrap;
            animation: marquee 15s linear infinite;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #fcf9f8;
        }

        ::-webkit-scrollbar-thumb {
            background: #000000;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Typography Polish */
        .font-elegant {
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.02em;
        }

        .font-technical {
            font-family: 'Space Mono', monospace;
            letter-spacing: -0.03em;
        }

        .brutalist-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: -1px;
            background: #ffffff;
            border: 1px solid #000000;
            z-index: 100;
            border-radius: 0;
            box-shadow: none;
            transition: opacity 0.1s ease-in-out;
        }

        .group:hover>.brutalist-dropdown {
            display: flex;
        }

        .dropdown-item {
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            padding: 8px 16px;
            color: #000000;
            transition: background 0.1s, color 0.1s;
            white-space: nowrap;
            text-transform: lowercase;
        }

        .dropdown-item:hover {
            background: #000000;
            color: #ffffff;
        }

        .mega-menu {
            width: 500px;
            padding: 0;
            flex-direction: row;
        }

        .mega-column {
            flex: 1;
            padding: 20px;
            border-right: 1px solid #000000;
        }

        .mega-column:last-child {
            border-right: none;
        }

        .mega-header {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 12px;
            border-bottom: 1px solid #000000;
            padding-bottom: 4px;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed": "#1b1b1b",
                        "surface-tint": "#5e5e5e",
                        "tertiary": "#000000",
                        "primary-fixed-dim": "#c6c6c6",
                        "on-surface": "#1c1b1b",
                        "error-container": "#ffdad6",
                        "inverse-on-surface": "#f3f0ef",
                        "surface-container-highest": "#e5e2e1",
                        "on-secondary": "#ffffff",
                        "primary": "#000000",
                        "surface-dim": "#dcd9d9",
                        "surface-container-lowest": "#ffffff",
                        "on-primary": "#ffffff",
                        "surface-container-high": "#ebe7e7",
                        "surface-variant": "#e5e2e1",
                        "on-primary-fixed": "#1b1b1b",
                        "primary-container": "#1b1b1b",
                        "on-error": "#ffffff",
                        "surface-bright": "#fcf9f8",
                        "tertiary-container": "#1b1b1b",
                        "secondary-fixed-dim": "#c6c6c7",
                        "inverse-surface": "#313030",
                        "on-secondary-fixed-variant": "#454747",
                        "primary-fixed": "#e2e2e2",
                        "surface": "#fcf9f8",
                        "on-secondary-container": "#616363",
                        "on-error-container": "#93000a",
                        "on-primary-container": "#848484",
                        "outline-variant": "#cfc4c5",
                        "tertiary-fixed": "#e2e2e2",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "inverse-primary": "#c6c6c6",
                        "on-surface-variant": "#4c4546",
                        "error": "#ba1a1a",
                        "on-secondary-fixed": "#1a1c1c",
                        "background": "#fcf9f8",
                        "on-primary-fixed-variant": "#474747",
                        "accent-success": "#22CD5B",
                        "surface-container": "#f0edec",
                        "on-tertiary-fixed-variant": "#474747",
                        "on-background": "#1c1b1b",
                        "secondary-container": "#dfe0e0",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5d5f5f",
                        "on-tertiary-container": "#848484",
                        "surface-container-low": "#f6f3f2",
                        "secondary-fixed": "#e2e2e2",
                        "outline": "#7e7576"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
