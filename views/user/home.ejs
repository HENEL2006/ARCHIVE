                <script>
                    // Micro-interactions for refined feel
                    document.querySelectorAll('button, a').forEach(el => {
                        el.addEventListener('mousedown', () => {
                            el.style.transform = 'translateY(1px)';
                        });
                        el.addEventListener('mouseup', () => {
                            el.style.transform = 'translateY(0)';
                        });
                    });


                    // automatic scroll for the cards



                    document.querySelectorAll(".home-product-card").forEach(card => {

                        const images = card.querySelectorAll(".product-hover-image");

                        let currentIndex = 0;
                        let interval = null;


                        function showImage(index) {

                            images.forEach((image, i) => {

                                image.classList.toggle(
                                    "opacity-100",
                                    i === index
                                );

                                image.classList.toggle(
                                    "opacity-0",
                                    i !== index
                                );

                            });

                        }


                        function startImageSlider() {

                            // Don't start if there is only one image
                            if (images.length <= 1) {
                                return;
                            }


                            // Start from first image
                            currentIndex = 0;
                            showImage(currentIndex);


                            interval = setInterval(() => {

                                currentIndex++;

                                if (currentIndex >= images.length) {
                                    currentIndex = 0;
                                }

                                showImage(currentIndex);

                            }, 1200);

                        }


                        function stopImageSlider() {

                            clearInterval(interval);

                            interval = null;

                            // Return to first image
                            currentIndex = 0;

                            showImage(0);

                        }


                        card.addEventListener("mouseenter", startImageSlider);

                        card.addEventListener("mouseleave", stopImageSlider);

                    });


                </script>
</body>

</html>