<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Products Management | Heritage Kit Co.</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-tint": "#565e74",
                        "outline": "#76777d",
                        "error": "#ba1a1a",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#000000",
                        "on-primary-fixed-variant": "#3f465c",
                        "on-secondary": "#ffffff",
                        "surface-container-highest": "#e0e3e5",
                        "surface-container": "#eceef0",
                        "on-tertiary-fixed": "#001e2c",
                        "tertiary": "#000000",
                        "surface-container-high": "#e6e8ea",
                        "on-tertiary-container": "#008ebf",
                        "on-error-container": "#93000a",
                        "primary-fixed-dim": "#bec6e0",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#d0e1fb",
                        "secondary-fixed": "#d3e4fe",
                        "primary-container": "#131b2e",
                        "on-secondary-fixed": "#0b1c30",
                        "tertiary-fixed": "#c4e7ff",
                        "on-error": "#ffffff",
                        "on-background": "#191c1e",
                        "secondary": "#505f76",
                        "inverse-on-surface": "#eff1f3",
                        "surface-variant": "#e0e3e5",
                        "background": "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "on-secondary-container": "#54647a",
                        "outline-variant": "#c6c6cd",
                        "primary-fixed": "#dae2fd",
                        "secondary-fixed-dim": "#b7c8e1",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "on-tertiary-fixed-variant": "#004c69",
                        "on-primary-fixed": "#131b2e",
                        "on-surface-variant": "#45464d",
                        "inverse-primary": "#bec6e0",
                        "on-primary": "#ffffff",
                        "on-surface": "#191c1e",
                        "surface": "#f7f9fb",
                        "error-container": "#ffdad6",
                        "on-secondary-fixed-variant": "#38485d",
                        "on-primary-container": "#7c839b",
                        "inverse-surface": "#2d3133",
                        "tertiary-container": "#001e2c",
                        "surface-dim": "#d8dadc",
                        "surface-bright": "#f7f9fb"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "4px",
                        "gutter": "24px",
                        "sm": "8px",
                        "xs": "4px",
                        "margin": "32px",
                        "md": "16px",
                        "2xl": "48px",
                        "xl": "32px",
                        "lg": "24px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "display": ["Inter"],
                        "body-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-md": ["JetBrains Mono"]
                    },
                    "fontSize": {
                        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .sidebar-active-indicator {
            border-left: 2px solid #000000;
        }
    </style>
</head>

<body class="bg-surface text-on-surface">
    <%- include("partials/toast") %>
        <!-- Fixed SideNavBar -->
        <%- include("partials/adminSidebar") %>
            <!-- TopAppBar -->
            <%- include("partials/adminNavbar") %>
                <!-- Main Content Canvas -->
                <main class="ml-64 pt-16 min-h-screen">
                    <div class="p-xl max-w-[1440px] mx-auto">
                        <!-- Page Header -->
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-lg mb-xl">
                            <div>
                                <h2 class="font-headline-lg text-headline-lg text-on-surface">Products</h2>
                                <p class="font-body-md text-on-surface-variant">Manage football jerseys and accessories
                                    available in the ARCHIVE store.</p>
                            </div>
                            <div class="flex items-center gap-md">
                                <a href="/admin/addProducts">
                                    <button
                                        class="flex items-center gap-sm px-lg py-md bg-primary text-on-primary font-label-md rounded-lg hover:opacity-90 transition-all shadow-sm">
                                        <span class="material-symbols-outlined text-[18px]">add</span>
                                        Add Product
                                    </button>
                                </a>
                            </div>
                        </div>
                        <!-- Stats Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg mb-xl">
                            <div
                                class="bg-surface-container-lowest border border-outline-variant p-lg rounded-xl flex items-center gap-lg">
                                <div
                                    class="w-12 h-12 bg-surface-container-high rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary">inventory_2</span>
                                </div>
                                <div>
                                    <p
                                        class="font-label-md text-on-surface-variant uppercase text-[10px] tracking-widest">
                                        Total Products</p>
                                    <p class="font-headline-md text-headline-md">
                                        <%= stats.totalProducts %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-surface-container-lowest border border-outline-variant p-lg rounded-xl flex items-center gap-lg">
                                <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined text-green-600">check_circle</span>
                                </div>
                                <div>
                                    <p
                                        class="font-label-md text-on-surface-variant uppercase text-[10px] tracking-widest">
                                        Listed Products</p>
                                    <p class="font-headline-md text-headline-md">
                                        <%= stats.listedProducts %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-surface-container-lowest border border-outline-variant p-lg rounded-xl flex items-center gap-lg">
                                <div class="w-12 h-12 bg-amber-50 rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined text-amber-600">visibility_off</span>
                                </div>
                                <div>
                                    <p
                                        class="font-label-md text-on-surface-variant uppercase text-[10px] tracking-widest">
                                        Unlisted Products</p>
                                    <p class="font-headline-md text-headline-md">
                                        <%= stats.unlistedProducts %>
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-surface-container-lowest border border-outline-variant p-lg rounded-xl flex items-center gap-lg">
                                <div class="w-12 h-12 bg-red-50 rounded-lg flex items-center justify-center">
                                    <span class="material-symbols-outlined text-red-600">delete_forever</span>
                                </div>
                                <div>
                                    <p
                                        class="font-label-md text-on-surface-variant uppercase text-[10px] tracking-widest">
                                        Deleted Products</p>
                                    <p class="font-headline-md text-headline-md">
                                        <%= stats.deletedProducts %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <!-- Filters Bar -->
                        <form action="/admin/products" method="GET"
                            class="bg-white border border-gray-200 rounded-xl px-6 py-4 mb-6 flex items-center">

                            <!-- Search -->
                            <div class="relative flex-1">

                                <!-- Search Button -->
                                <button type="submit"
                                    class="absolute left-0 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black transition flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[20px]">
                                        search
                                    </span>
                                </button>

                                <input id="searchInput" type="text" name="search" placeholder="Search products..."
                                    value="<%= query.search || '' %>"
                                    class="w-full pl-10 pr-10 bg-transparent border-none outline-none shadow-none focus:ring-0 text-sm">

                                <!-- Clear Button -->
                                <button type="button" id="clearSearch"
                                    class="absolute right-0 top-1/2 -translate-y-1/2 hidden text-gray-400 hover:text-black transition">
                                    <span class="material-symbols-outlined text-[20px]">
                                        close
                                    </span>
                                </button>

                            </div>

                            <!-- Divider -->
                            <div class="w-px h-7 bg-gray-200 mx-8"></div>

                            <!-- Category -->
                            <select name="category"
                                class="border-0 bg-transparent uppercase tracking-[0.25em] text-[11px] font-medium focus:ring-0 cursor-pointer">

                                <option value="">All Category</option>

                                <% categories.forEach(category=> { %>
                                    <option value="<%= category._id %>" <%=query.category==category._id.toString()
                                        ? "selected" : "" %>>
                                        <%= category.name %>(<%= category.productCount %>)
                                    </option>
                                    <% }) %>

                            </select>

                            <!-- Divider -->
                            <div class="w-px h-7 bg-gray-200 mx-8"></div>

                            <!-- Status -->
                            <select name="status"
                                class="border-0 bg-transparent uppercase tracking-[0.25em] text-[11px] font-medium focus:ring-0 cursor-pointer">

                                <option value="">All Status</option>
                                <option value="listed" <%=query.status==="listed" ? "selected" : "" %>>
                                    Listed
                                </option>
                                <option value="unlisted" <%=query.status==="unlisted" ? "selected" : "" %>>
                                    Unlisted
                                </option>

                            </select>

                            <!-- Divider -->
                            <div class="w-px h-7 bg-gray-200 mx-8"></div>

                            <!-- Sort -->
                            <select name="sort"
                                class="border-0 bg-transparent uppercase tracking-[0.25em] text-[11px] font-medium focus:ring-0 cursor-pointer">

                                <option value="newest" <%=query.sort==="newest" ? "selected" : "" %>>
                                    Newest
                                </option>
                                <option value="oldest" <%=query.sort==="oldest" ? "selected" : "" %>>
                                    Oldest
                                </option>
                                <option value="priceAsc" <%=query.sort==="priceAsc" ? "selected" : "" %>>
                                    Price ↑
                                </option>
                                <option value="priceDesc" <%=query.sort==="priceDesc" ? "selected" : "" %>>
                                    Price ↓
                                </option>
                                <option value="a-z" <%=query.sort==="a-z" ? "selected" : "" %>>
                                    A-Z
                                </option>
                                <option value="z-a" <%=query.sort==="z-a" ? "selected" : "" %>>
                                    Z-A
                                </option>

                            </select>

                            <!-- Reset -->
                            <a href="/admin/products"
                                class="ml-8 uppercase tracking-[0.3em] text-[11px] text-gray-400 hover:text-black transition">

                                Reset Filters

                            </a>

                        </form>
                        <!-- Products Table -->
                        <div
                            class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden mb-xl">
                            <div class="overflow-x-hidden">
                                <table class="w-full text-left table-fixed border-collapse">

                                    <colgroup>
                                        <col class="w-[90px]">
                                        <col class="w-[35%]">
                                        <col class="w-[17%]">
                                        <col class="w-[15%]">
                                        <col class="w-[12%]">
                                        <col class="w-[12%]">
                                        <col class="w-[140px]">
                                    </colgroup>

                                    <thead>
                                        <tr class="bg-surface-container-low border-b border-outline-variant">

                                            <th
                                                class="w-[7%] p-md text-center font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Img
                                            </th>

                                            <th
                                                class="w-[31%] p-md font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Product
                                            </th>

                                            <th
                                                class="w-[16%] p-md font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Category
                                            </th>

                                            <th
                                                class="w-[12%] p-md text-center font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Stock
                                            </th>

                                            <th
                                                class="w-[12%] p-md text-center font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Price
                                            </th>

                                            <th
                                                class="w-[12%] p-md text-center font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Status
                                            </th>

                                            <th
                                                class="w-[10%] p-md text-center font-label-md text-on-surface-variant uppercase text-[11px] tracking-widest">
                                                Actions
                                            </th>

                                        </tr>
                                    </thead>

                                    <tbody class="divide-y divide-outline-variant">

                                        <% products.forEach(product=> { %>

                                            <tr class="hover:bg-surface-container-low transition-colors">

                                                <!-- IMAGE -->
                                                <td class="p-md text-center align-middle">
                                                    <img src="<%= product.images[0]?.url %>"
                                                        class="w-14 h-14 rounded-lg object-cover mx-auto border border-outline-variant">
                                                </td>

                                                <!-- PRODUCT -->
                                                <td class="p-md align-middle">
                                                    <div>
                                                        <p class="font-body-md font-semibold truncate">
                                                            <%= product.name %>
                                                        </p>

                                                        <p class="font-label-md text-[11px] text-on-surface-variant">
                                                            Brand: <%= product.brand %>
                                                        </p>
                                                    </div>
                                                </td>

                                                <!-- CATEGORY -->
                                                <td class="p-md align-middle">
                                                    <%= product.category?.name || "—" %>
                                                </td>

                                                <!-- STOCK -->
                                                <td class="p-md text-center align-middle">
                                                    <span class="font-body-md font-semibold">
                                                        <%= product.totalStock %>
                                                    </span>
                                                </td>

                                                <!-- PRICE -->
                                                <td class="p-md text-center align-middle whitespace-nowrap">
                                                    ₹<%= product.price.toLocaleString("en-IN") %>
                                                </td>

                                                <!-- STATUS -->
                                                <td class="p-md text-center align-middle">

                                                    <% if (product.isListed) { %>

                                                        <span class="inline-flex items-center justify-center gap-1 px-2 py-1
                         rounded-full bg-green-50 text-green-700
                         border border-green-200
                         font-label-md text-[10px] whitespace-nowrap">

                                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                                            Listed

                                                        </span>

                                                        <% } else { %>

                                                            <span class="inline-flex items-center justify-center gap-1 px-2 py-1
                         rounded-full bg-red-50 text-red-700
                         border border-red-200
                         font-label-md text-[10px] whitespace-nowrap">

                                                                <span
                                                                    class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                                                                Unlisted

                                                            </span>

                                                            <% } %>

                                                </td>

                                                <!-- ACTIONS -->
                                                <td class="p-md align-middle">
                                                    <div class="flex items-center justify-center gap-3">

                                                        <!-- LIST / UNLIST -->
                                                        <form action="/admin/products/<%= product._id %>/status"
                                                            method="POST" class="inline-flex status-form"
                                                            data-product-name="<%= product.name %>"
                                                            data-action="<%= product.isListed ? 'unlist' : 'list' %>">

                                                            <button type="button"
                                                                title="<%= product.isListed ? 'Unlist Product' : 'List Product' %>"
                                                                class="status-button material-symbols-outlined text-[21px] text-on-surface hover:opacity-60 transition-opacity">
                                                                <%= product.isListed ? 'visibility' : 'visibility_off'
                                                                    %>
                                                            </button>

                                                        </form>

                                                        <!-- EDIT -->
                                                        <a href="/admin/products/<%= product._id %>/edit"
                                                            title="Edit Product"
                                                            class="material-symbols-outlined text-[21px] text-on-surface hover:opacity-60 transition-opacity">
                                                            edit
                                                        </a>

                                                        <!-- DELETE -->
                                                        <form action="/admin/products/<%= product._id %>/delete"
                                                            method="POST" class="inline-flex delete-form"
                                                            data-product-name="<%= product.name %>">

                                                            <button type="button" title="Delete Product"
                                                                class="delete-button material-symbols-outlined text-[21px] text-red-500 hover:opacity-60">
                                                                delete
                                                            </button>

                                                        </form>

                                                    </div>
                                                </td>

                                            </tr>

                                            <% }) %>

                                    </tbody>

                                </table>
                            </div>
                            <!-- Pagination -->
                            <div class="flex items-center justify-between px-6 py-5 border-t border-outline-variant">

                                <% const start=(pagination.currentPage - 1) * pagination.limit + 1; const end=Math.min(
                                    pagination.currentPage * pagination.limit, pagination.totalProducts ); %>

                                    <p class="text-sm text-gray-500">
                                        Showing <%= start %> to <%= end %> of <%= pagination.totalProducts %> products
                                    </p>
                                    <div class="flex items-center gap-2">

                                        <!-- Previous -->

                                        <a href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || 'newest' %>&page=<%= pagination.currentPage - 1 %>"
                                            class="w-10 h-10 rounded-xl border border-outline-variant flex items-center justify-center transition hover:bg-surface-container-high
            <%= pagination.currentPage === 1 ? 'pointer-events-none opacity-40' : '' %>">

                                            <span class="material-symbols-outlined text-[20px]">
                                                chevron_left
                                            </span>

                                        </a>



                                        <% if(pagination.currentPage> 2){ %>

                                            <a href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || 'newest' %>&page=1"
                                                class="w-10 h-10 rounded-xl flex items-center justify-center hover:bg-surface-container-high">

                                                1

                                            </a>

                                            <% if(pagination.currentPage> 3){ %>

                                                <span class="px-1">...</span>

                                                <% } %>

                                                    <% } %>



                                                        <% for(let i=Math.max(1,pagination.currentPage-1); i
                                                            <=Math.min(pagination.totalPages,pagination.currentPage+1);
                                                            i++){ %>

                                                            <a href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || 'newest' %>&page=<%= i %>"
                                                                class="w-10 h-10 rounded-xl flex items-center justify-center transition
                <%= pagination.currentPage===i
                    ? 'bg-black text-white'
                    : 'border border-outline-variant hover:bg-surface-container-high' %>">

                                                                <%= i %>

                                                            </a>

                                                            <% } %>



                                                                <% if(pagination.currentPage < pagination.totalPages-1){
                                                                    %>

                                                                    <% if(pagination.currentPage <
                                                                        pagination.totalPages-2){ %>

                                                                        <span class="px-1">...</span>

                                                                        <% } %>

                                                                            <a href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || 'newest' %>&page=<%= pagination.totalPages %>"
                                                                                class="w-10 h-10 rounded-xl flex items-center justify-center hover:bg-surface-container-high">

                                                                                <%= pagination.totalPages %>

                                                                            </a>

                                                                            <% } %>



                                                                                <!-- Next -->

                                                                                <a href="?search=<%= query.search || '' %>&category=<%= query.category || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || 'newest' %>&page=<%= pagination.currentPage + 1 %>"
                                                                                    class="w-10 h-10 rounded-xl border border-outline-variant flex items-center justify-center transition hover:bg-surface-container-high
            <%= pagination.currentPage===pagination.totalPages ? 'pointer-events-none opacity-40' : '' %>">

                                                                                    <span
                                                                                        class="material-symbols-outlined text-[20px]">
                                                                                        chevron_right
                                                                                    </span>

                                                                                </a>

                                    </div>

                            </div>
                        </div>
                        <!-- Bottom Section (Grid) -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-xl">
                            <!-- Left Column: Low Stock Alerts -->

                            <!-- Right Column: Recent Product Activity -->

                        </div>
                    </div>
                </main>

                <!-- LIST / UNLIST CONFIRMATION MODAL -->
                <div id="statusModal"
                    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">

                    <div class="w-full max-w-md bg-white border border-outline-variant rounded-xl shadow-2xl p-8">

                        <!-- Icon -->
                        <div
                            class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center mb-6">
                            <span id="statusModalIcon" class="material-symbols-outlined text-2xl">
                                visibility_off
                            </span>
                        </div>

                        <!-- Heading -->
                        <h3 class="font-headline-md text-xl font-semibold text-on-surface mb-2">
                            <span id="statusModalTitle">Unlist Product?</span>
                        </h3>

                        <!-- Message -->
                        <p class="text-sm text-on-surface-variant leading-6">
                            Are you sure you want to
                            <span id="statusModalAction" class="font-semibold text-on-surface">
                                unlist
                            </span>
                            <span id="statusModalProduct" class="font-semibold text-on-surface">
                                this product
                            </span>?
                        </p>

                        <p id="statusModalDescription" class="text-xs text-on-surface-variant mt-2">
                            Unlisted products will no longer be visible to customers.
                        </p>

                        <!-- Buttons -->
                        <div class="flex justify-end gap-3 mt-8">

                            <button type="button" id="cancelStatus"
                                class="px-5 py-2.5 border border-outline-variant rounded-lg text-sm font-semibold hover:bg-surface-container transition-colors">
                                Cancel
                            </button>

                            <button type="button" id="confirmStatus"
                                class="px-5 py-2.5 bg-black text-white rounded-lg text-sm font-semibold hover:opacity-80 transition-opacity">
                                Confirm
                            </button>

                        </div>

                    </div>
                </div>
                <script>

                    // ================================
                    // DELETE PRODUCT CONFIRMATION
                    // ================================

                    document.querySelectorAll(".delete-button").forEach((button) => {
                        button.addEventListener("click", () => {
                            selectedDeleteForm = button.closest(".delete-form");

                            const productName = selectedDeleteForm.dataset.productName;

                            statusModalTitle.textContent = "Delete Product?";
                            statusModalAction.textContent = "delete";
                            statusModalProduct.textContent = `"${productName}"`;

                            statusModalIcon.textContent = "delete";

                            statusModalDescription.textContent =
                                "This product will be removed from the product list. This action cannot be undone.";

                            // Make the confirm button clearly destructive
                            confirmStatus.classList.remove("bg-black");
                            confirmStatus.classList.add("bg-red-600");

                            statusModal.classList.remove("hidden");
                            statusModal.classList.add("flex");
                        });
                    });

                    // ================================
                    // LIST / UNLIST CONFIRMATION MODAL
                    // ================================

                    const statusModal = document.getElementById("statusModal");
                    const cancelStatus = document.getElementById("cancelStatus");
                    const confirmStatus = document.getElementById("confirmStatus");

                    const statusModalTitle = document.getElementById("statusModalTitle");
                    const statusModalAction = document.getElementById("statusModalAction");
                    const statusModalProduct = document.getElementById("statusModalProduct");
                    const statusModalDescription = document.getElementById(
                        "statusModalDescription",
                    );
                    const statusModalIcon = document.getElementById("statusModalIcon");

                    let selectedStatusForm = null;
                    let selectedDeleteForm = null;

                    // Open modal
                    document.querySelectorAll(".status-button").forEach((button) => {
                        button.addEventListener("click", () => {
                            selectedStatusForm = button.closest(".status-form");

                            const productName = selectedStatusForm.dataset.productName;
                            const action = selectedStatusForm.dataset.action;

                            statusModalProduct.textContent = `"${productName}"`;

                            if (action === "unlist") {
                                statusModalTitle.textContent = "Unlist Product?";
                                statusModalAction.textContent = "unlist";
                                statusModalIcon.textContent = "visibility_off";

                                statusModalDescription.textContent =
                                    "Unlisted products will no longer be visible to customers.";
                            } else {
                                statusModalTitle.textContent = "List Product?";
                                statusModalAction.textContent = "list";
                                statusModalIcon.textContent = "visibility";

                                statusModalDescription.textContent =
                                    "This product will become visible to customers.";
                            }

                            statusModal.classList.remove("hidden");
                            statusModal.classList.add("flex");
                        });
                    });

                    // Cancel
                    cancelStatus.addEventListener("click", () => {
                        closeStatusModal();
                    });

                    // Confirm
                    confirmStatus.addEventListener("click", () => {
                        if (selectedDeleteForm) {
                            selectedDeleteForm.submit();
                            return;
                        }

                        if (selectedStatusForm) {
                            selectedStatusForm.submit();
                        }
                    });

                    // Close modal
                    function closeStatusModal() {
                        statusModal.classList.add("hidden");
                        statusModal.classList.remove("flex");

                        selectedStatusForm = null;
                        selectedDeleteForm = null;

                        // Reset confirm button
                        confirmStatus.classList.remove("bg-red-600");
                        confirmStatus.classList.add("bg-black");
                    }

                    // Close when clicking outside modal
                    statusModal.addEventListener("click", (e) => {
                        if (e.target === statusModal) {
                            closeStatusModal();
                        }
                    });

                    // Close with Escape
                    document.addEventListener("keydown", (e) => {
                        if (e.key === "Escape" && !statusModal.classList.contains("hidden")) {
                            closeStatusModal();
                        }
                    });

                    // ================================
                    // TABLE ROW HOVER EFFECT
                    // ================================
                    document.querySelectorAll("tbody tr").forEach(row => {
                        row.addEventListener("mouseenter", () => {
                            row.classList.add("bg-surface-container-low");
                        });

                        row.addEventListener("mouseleave", () => {
                            row.classList.remove("bg-surface-container-low");
                        });
                    });


                    // ================================
                    // FILTER FORM
                    // ================================
                    const filterForm = document.querySelector('form[action="/admin/products"]');

                    // Product Search Input
                    const searchInput = document.getElementById("searchInput");

                    // Clear Search Button
                    const clearSearch = document.getElementById("clearSearch");


                    // ================================
                    // SEARCH BAR FOCUS ANIMATION
                    // ================================
                    searchInput.addEventListener("focus", () => {
                        searchInput.parentElement.classList.add("scale-[1.01]");
                    });

                    searchInput.addEventListener("blur", () => {
                        searchInput.parentElement.classList.remove("scale-[1.01]");
                    });


                    // ================================
                    // AUTO SUBMIT FILTERS
                    // ================================
                    filterForm.querySelectorAll("select").forEach(select => {
                        select.addEventListener("change", () => {
                            filterForm.submit();
                        });
                    });


                    // ================================
                    // SHOW / HIDE CLEAR SEARCH BUTTON
                    // ================================
                    function toggleClearButton() {

                        if (searchInput.value.trim() !== "") {
                            clearSearch.classList.remove("hidden");
                        } else {
                            clearSearch.classList.add("hidden");
                        }

                    }

                    // Run once when page loads
                    toggleClearButton();

                    // Check whenever the user types
                    searchInput.addEventListener("input", toggleClearButton);


                    // ================================
                    // CLEAR SEARCH
                    // ================================
                    clearSearch.addEventListener("click", () => {

                        searchInput.value = "";

                        clearSearch.classList.add("hidden");

                        filterForm.submit();

                    });

                </script>




</body>

</html>