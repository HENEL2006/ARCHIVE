<!DOCTYPE html>
<html lang="en" class="light">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ARCHIVE // Refer a Friend</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;family=Syne:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet">
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#000000',
              charcoal: '#111111',
              border: '#E5E5E5',
              borderDark: '#1F1F1F',
              offwhite: '#FCF9F8',
              surfaceDim: '#F4F1F0',
              muted: '#737373',
              subtle: '#A3A3A3'
            }
          },
          "fontFamily": {
            "body-lg": ["Space Mono"],
            "mono-data": ["Space Mono"],
            "display-xl": ["Syne"],
            "headline-lg-mobile": ["Syne"],
            "headline-lg": ["Inter"],
            "headline-md": ["Inter"],
            "body-md": ["Space Mono"],
            "label-caps": ["Space Mono"],
            "display": ['"Syne"', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #FCF9F8;
      color: #000000;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      margin: 0;
      padding: 0;
    }

    .font-syne {
      font-family: 'Syne', sans-serif;
    }

    .font-mono {
      font-family: 'Space Mono', monospace;
    }

    .border-grid {
      border-color: #000000;
    }

    .subtle-border {
      border-color: #E5E5E5;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col bg-[#FCF9F8] text-black">

  <!-- TOP NAVBAR -->
  <%- include("partials/userHeader") %>
    <%- include("partials/toast") %>

      <!-- MAIN WRAPPER -->
      <main class="flex-grow max-w-[1440px] w-full mx-auto px-6 lg:px-12 py-12 lg:py-16">

        <!-- PAGE HEADER -->
        <section class="border-b border-black pb-12 lg:pb-16 mb-12">
          <div class="max-w-4xl">
            <h1
              class="font-syne text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight uppercase text-black leading-none mb-6">
              REFER A FRIEND
            </h1>
            <p class="font-syne text-xl sm:text-2xl font-bold tracking-tight text-neutral-800 mb-4">
              “Share ARCHIVE with someone who speaks football.”
            </p>
            <p class="text-sm sm:text-base text-neutral-600 font-sans max-w-2xl leading-relaxed">
              Invite a friend to discover the collection and receive your referral reward when they join ARCHIVE and
              secure their first verified piece of football heritage.
            </p>
          </div>
        </section>

        <!-- MAIN REFERRAL SECTION: TWO-COLUMN EDITORIAL SPLIT -->
        <section
          class="grid grid-cols-1 lg:grid-cols-2 border border-black divide-y lg:divide-y-0 lg:divide-x divide-black bg-white mb-16 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">

          <!-- LEFT SIDE: REFERRAL CODE -->
          <div class="p-8 lg:p-12 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-8">
                <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase">
                  01 // PERSONAL CREDENTIAL
                </span>
                <!-- <span
                  class="inline-flex items-center px-2 py-0.5 text-[10px] font-mono uppercase bg-neutral-100 text-neutral-700 border border-neutral-300">
                  ONE-TIME APPLY
                </span> -->
              </div>

              <span class="text-xs font-mono tracking-[0.18em] text-black font-bold uppercase block mb-2">
                YOUR REFERRAL CODE
              </span>

              <!-- Code Box -->
              <div class="bg-[#FAF7F6] border-2 border-black p-5 sm:p-6 mb-4 flex items-center justify-between">
                <span id="referralCodeText"
                  class="font-mono text-2xl sm:text-3xl lg:text-4xl font-bold tracking-wider text-black select-all">
                  <%= referralCode %>
                </span>
                <!-- <span class="material-symbols-outlined text-neutral-400 text-2xl hidden sm:inline">
                  qr_code_2
                </span> -->
              </div>

              <p class="text-xs text-neutral-600 font-sans leading-relaxed mb-8">
                Share this code with your friends when they create an ARCHIVE account. Applied during their registration
                or acquisition checkout.
              </p>
            </div>

            <div>
              <button id="copyCodeBtn" onclick="copyReferralCode()"
                class="w-full bg-black hover:bg-neutral-800 text-white font-mono text-xs uppercase tracking-widest py-4 px-6 border border-black flex items-center justify-center gap-2 transition-all active:scale-[0.99]">
                <span class="material-symbols-outlined text-sm" id="codeIcon">content_copy</span>
                <span id="codeBtnText" class="">COPY CODE</span>
              </button>
            </div>
          </div>

          <!-- RIGHT SIDE: REFERRAL LINK & DIRECT CHANNELS -->
          <div class="p-8 lg:p-12 flex flex-col justify-between bg-[#FCF9F8]">
            <div>
              <div class="flex items-center justify-between mb-8">
                <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase">
                  02 // DIRECT ARCHIVE URL
                </span>
                <!-- <span
                  class="inline-flex items-center px-2 py-0.5 text-[10px] font-mono uppercase bg-emerald-50 text-emerald-800 border border-emerald-300">
                  DIRECT ATTRIBUTION
                </span> -->
              </div>

              <span class="text-xs font-mono tracking-[0.18em] text-black font-bold uppercase block mb-2">
                YOUR REFERRAL LINK
              </span>

              <!-- Link Display Box -->
              <div
                class="bg-white border border-neutral-300 p-4 sm:p-5 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <span id="referralUrlText" class="font-mono text-xs sm:text-sm text-neutral-800 truncate select-all">
                  <%= referralUrl %>
                </span>
                <button id="copyUrlBtn" onclick="copyReferralUrl()"
                  class="shrink-0 bg-white hover:bg-neutral-100 text-black border border-black font-mono text-[11px] uppercase tracking-wider px-4 py-2 transition-colors flex items-center justify-center gap-1.5">
                  <span class="material-symbols-outlined text-xs" id="urlIcon">link</span>
                  <span id="urlBtnText" class="">COPY LINK</span>
                </button>
              </div>

              <p class="text-xs text-neutral-600 font-sans leading-relaxed mb-6">
                Directly leads to curated signup with your collector key auto-bound to their new member account.
              </p>
            </div>
          </div>
        </section>

        <!-- BOTTOM CTA: BUILD THE ARCHIVE -->
        <section class="border-2 border-black bg-black text-white p-10 lg:p-16 mb-16 relative overflow-hidden">
          <div class="max-w-2xl relative z-10">
            <span class="text-xs font-mono tracking-[0.25em] text-neutral-400 uppercase block mb-3">
              COLLECTIVE CURATION
            </span>
            <h2 class="font-syne text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white mb-4">
              BUILD THE ARCHIVE.
            </h2>
            <p class="font-syne text-lg sm:text-xl text-neutral-300 font-bold mb-8">
              “Football is better when shared.”
            </p>
            <a href="/products"
              class="inline-flex items-center gap-3 bg-white text-black hover:bg-neutral-200 font-mono text-xs uppercase tracking-widest py-4 px-8 border border-white transition-all">
              <span class="">EXPLORE COLLECTION</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>

          <!-- Subtle background graphic lines -->
          <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none hidden sm:block">
            <span class="font-syne text-9xl font-black text-white leading-none">ARCHIVE</span>
          </div>
        </section>

      </main>

      <!-- Footer -->
      <%- include("partials/userFooter") %>

        <!-- INTERACTIVE COPY NOTIFICATION SCRIPTS -->
        <script>
          function copyReferralCode() {
            const code = "<%= referralCode %>";
            navigator.clipboard.writeText(code).then(() => {
              const btn = document.getElementById("copyCodeBtn");
              const btnText = document.getElementById("codeBtnText");
              const icon = document.getElementById("codeIcon");

              btnText.innerText = "COPIED ✓";
              icon.innerText = "check";
              btn.classList.add("bg-neutral-900");

              setTimeout(() => {
                btnText.innerText = "COPY CODE";
                icon.innerText = "content_copy";
                btn.classList.remove("bg-neutral-900");
              }, 2200);
            }).catch(err => {
              console.error('Failed to copy code: ', err);
            });
          }

          function copyReferralUrl() {
            const url = "<%= referralUrl %>";
            navigator.clipboard.writeText(url).then(() => {
              const btn = document.getElementById("copyUrlBtn");
              const btnText = document.getElementById("urlBtnText");
              const icon = document.getElementById("urlIcon");

              if (btnText) btnText.innerText = "COPIED ✓";
              if (icon) icon.innerText = "check";

              setTimeout(() => {
                if (btnText) btnText.innerText = "COPY LINK";
                if (icon) icon.innerText = "link";
              }, 2200);
            }).catch(err => {
              console.error('Failed to copy url: ', err);
            });
          }

          function toggleEmptyState() {
            const box = document.getElementById("emptyStateBox");
            if (box.classList.contains("hidden")) {
              box.classList.remove("hidden");
            } else {
              box.classList.add("hidden");
            }
          }
        </script>







</body>

</html>