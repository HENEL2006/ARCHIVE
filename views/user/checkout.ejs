<option value="ARCHIVE10">ARCHIVE10 - 10% OFF</option>
<option value="LEGACY25">LEGACY25 - 25% OFF</option>
</select>
</div>
<div class="flex gap-0">
<input class="flex-grow bg-transparent border border-primary border-r-0 font-mono-data text-mono-data py-3 px-4 focus:ring-0" placeholder="ENTER CODE" type="text"/>
<button class="bg-primary text-on-primary font-label-caps text-label-caps px-6 py-3 hover:opacity-90 transition-opacity">APPLY</button>
</div>
</div>
<!-- Financials -->
<div class="border-t border-primary pt-6 space-y-4">
<div class="flex justify-between font-mono-data text-mono-data text-secondary">
<span>SUBTOTAL</span>
<span>$495.00</span>
</div>
<div class="flex justify-between font-mono-data text-mono-data text-secondary">
<span>SHIPPING</span>
<span>$25.00</span>
</div>
<div class="flex justify-between font-mono-data text-mono-data text-accent-success">
<span>DISCOUNT</span>
<span>-$50.00</span>
</div>
<div class="flex justify-between font-headline-md text-headline-md border-t border-primary pt-6 mt-4">
<span>TOTAL</span>
<span>$470.00</span>
</div>
</div>
