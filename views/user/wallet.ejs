                                class="border border-primary p-6 text-center cursor-pointer hover:bg-primary hover:text-on-primary transition-colors group">
                                <p class="font-label-caps text-label-caps opacity-50 mb-2">PRESET</p>
                                <p class="font-headline-md text-headline-md">₹1000</p>
                            </div>
