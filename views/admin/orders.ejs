<!DOCTYPE html>
<html class="light" lang="en" style="">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Orders Management | Heritage Kit Co.</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@500&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;family=JetBrains+Mono:wght@100..900&amp;display=swap"
        rel="stylesheet">
    <script type="application/json" id="ordersData">
    <%- JSON.stringify(
        orders.map(order => ({
           orderId: order.orderId,
        items: order.items.map(item => ({
            name: item.name,
            image: item.image,
            size: item.size,
            quantity: item.quantity
            }))
        }))
    ).replace(/</g, "\\u003c") %>
</script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary": "#505f76",
                        "on-tertiary": "#ffffff",
                        "on-surface-variant": "#45464d",
                        "primary": "#000000",
                        "outline": "#76777d",
                        "tertiary-fixed": "#c4e7ff",
                        "secondary-fixed": "#d3e4fe",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#d0e1fb",
                        "primary-fixed": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#eceef0",
                        "on-primary-fixed": "#131b2e",
                        "on-primary-fixed-variant": "#3f465c",
                        "on-background": "#191c1e",
                        "surface-tint": "#565e74",
                        "inverse-surface": "#2d3133",
                        "secondary-fixed-dim": "#b7c8e1",
                        "on-error": "#ffffff",
                        "surface-container-highest": "#e0e3e5",
                        "surface-container-high": "#e6e8ea",
                        "on-secondary-fixed": "#0b1c30",
                        "on-primary-container": "#7c839b",
                        "on-tertiary-fixed": "#001e2c",
                        "on-tertiary-container": "#008ebf",
                        "primary-container": "#131b2e",
                        "on-secondary-fixed-variant": "#38485d",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "inverse-on-surface": "#eff1f3",
                        "background": "#f7f9fb",
                        "tertiary-container": "#001e2c",
                        "surface-dim": "#d8dadc",
                        "surface-variant": "#e0e3e5",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface-container-low": "#f2f4f6",
                        "surface": "#f7f9fb",
                        "on-tertiary-fixed-variant": "#004c69",
                        "surface-bright": "#f7f9fb",
                        "primary-fixed-dim": "#bec6e0",
                        "error": "#ba1a1a",
                        "outline-variant": "#c6c6cd",
                        "on-surface": "#191c1e",
                        "tertiary": "#000000",
                        "on-secondary-container": "#54647a",
                        "on-error-container": "#93000a",
                        "inverse-primary": "#bec6e0"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "sm": "8px",
                        "xs": "4px",
                        "2xl": "48px",
                        "lg": "24px",
                        "base": "4px",
                        "xl": "32px",
                        "md": "16px",
                        "margin": "32px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "display": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-md": ["JetBrains Mono"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }
    </style>
</head>

<body class="bg-background text-on-surface">
    <%- include("partials/toast") %>
        <!-- Fixed SideNavBar -->
        <%- include("partials/adminSidebar") %>
            <!-- TopAppBar -->
            <%- include("partials/adminNavbar") %>
                <!-- Main Content Canvas -->
                <main class="ml-64 pt-24 px-xl pb-xl max-w-[1440px] mx-auto">
                    <!-- Page Header -->
                    <div class="flex flex-col md:flex-row md:items-end justify-between mb-xl gap-md">
                        <div>
                            <h2 class="font-headline-lg text-headline-lg text-on-surface">Orders</h2>
                            <p class="font-body-md text-on-surface-variant">Manage customer purchases, fulfillment, and
                                delivery status.</p>
                        </div>
                    </div>
                    <!-- Statistics Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-lg mb-xl">

                        <!-- TOTAL ORDERS -->
                        <div class="bg-white border border-outline-variant p-lg rounded-xl">
                            <p class="font-label-md text-on-surface-variant uppercase mb-xs">
                                Total Orders
                            </p>

                            <h3 class="font-display text-headline-lg">
                                <%= statistics.totalOrders.toLocaleString() %>
                            </h3>

                            <p class="text-on-surface-variant text-body-sm mt-sm">
                                All orders
                            </p>
                        </div>


                        <!-- PENDING -->
                        <div class="bg-white border border-outline-variant p-lg rounded-xl">
                            <p class="font-label-md text-on-surface-variant uppercase mb-xs">
                                Pending
                            </p>

                            <h3 class="font-display text-headline-lg">
                                <%= statistics.pending.toLocaleString() %>
                            </h3>

                            <p class="text-on-surface-variant text-body-sm mt-sm">
                                Requires attention
                            </p>
                        </div>


                        <!-- SHIPPED -->
                        <div class="bg-white border border-outline-variant p-lg rounded-xl">
                            <p class="font-label-md text-on-surface-variant uppercase mb-xs">
                                Shipped
                            </p>

                            <h3 class="font-display text-headline-lg">
                                <%= statistics.shipped.toLocaleString() %>
                            </h3>

                            <p class="text-on-surface-variant text-body-sm mt-sm">
                                In transit
                            </p>
                        </div>


                        <!-- DELIVERED -->
                        <div class="bg-white border border-outline-variant p-lg rounded-xl">
                            <p class="font-label-md text-on-surface-variant uppercase mb-xs">
                                Delivered
                            </p>

                            <h3 class="font-display text-headline-lg">
                                <%= statistics.delivered.toLocaleString() %>
                            </h3>

                            <p class="text-on-surface-variant text-body-sm mt-sm">
                                Successfully delivered
                            </p>
                        </div>


                        <!-- CANCELLED -->
                        <div class="bg-white border border-outline-variant p-lg rounded-xl">
                            <p class="font-label-md text-on-surface-variant uppercase mb-xs">
                                Cancelled
                            </p>

                            <h3 class="font-display text-headline-lg">
                                <%= statistics.cancelled.toLocaleString() %>
                            </h3>

                            <p class="text-on-surface-variant text-body-sm mt-sm">
                                Cancelled orders
                            </p>
                        </div>

                    </div>
                    <div class="gap-lg">
                        <!-- Main Orders Column -->
                        <div class="col-span-12 space-y-lg">
                            <!-- Search & Filters -->
                            <div class="mb-10 rounded-lg border border-neutral-200 bg-white">
                                <form action="/admin/orders" method="GET">
                                    <div class="flex h-16 items-center px-6">

                                        <!-- Search -->
                                        <div class="relative flex-1 min-w-[240px] flex items-center gap-sm">

                                            <span class="material-symbols-outlined text-neutral-400">
                                                search
                                            </span>

                                            <input id="orderSearch" type="text" name="search"
                                                value="<%= search || '' %>"
                                                placeholder="Search orders, customers, or products..."
                                                class="w-full border-none bg-transparent p-0 pr-8 text-sm text-black placeholder:text-neutral-400 focus:outline-none focus:ring-0">

                                            <button type="button" id="clearOrderSearch"
                                                class="<%= search ? 'absolute right-0 flex' : 'absolute right-0 hidden' %> p-1 text-neutral-400 hover:text-black">

                                                <span class="material-symbols-outlined text-[18px]">
                                                    close
                                                </span>

                                            </button>

                                        </div>


                                        <!-- Divider -->
                                        <div class="mx-6 h-6 w-px bg-neutral-200"></div>


                                        <!-- Order Status -->
                                        <select name="status" onchange="this.form.submit()"
                                            class="border-none bg-transparent text-xs font-semibold uppercase tracking-[0.25em] text-neutral-700 focus:outline-none focus:ring-0">

                                            <option value="ALL" <%=currentStatus==="ALL" ? "selected" : "" %>>
                                                All Status
                                            </option>

                                            <option value="PLACED" <%=currentStatus==="PLACED" ? "selected" : "" %>>
                                                Placed
                                            </option>

                                            <option value="CONFIRMED" <%=currentStatus==="CONFIRMED" ? "selected" : ""
                                                %>>
                                                Confirmed
                                            </option>

                                            <option value="SHIPPED" <%=currentStatus==="SHIPPED" ? "selected" : "" %>>
                                                Shipped
                                            </option>

                                            <option value="DELIVERED" <%=currentStatus==="DELIVERED" ? "selected" : ""
                                                %>>
                                                Delivered
                                            </option>

                                            <option value="CANCELLED" <%=currentStatus==="CANCELLED" ? "selected" : ""
                                                %>>
                                                Cancelled
                                            </option>

                                            <option value="RETURN_REQUESTED" <%=currentStatus==="RETURN_REQUESTED"
                                                ? "selected" : "" %>>
                                                Return Requested
                                            </option>

                                            <option value="RETURNED" <%=currentStatus==="RETURNED" ? "selected" : "" %>>
                                                Returned
                                            </option>

                                        </select>


                                        <!-- Divider -->
                                        <div class="mx-6 h-6 w-px bg-neutral-200"></div>


                                        <!-- Payment Status -->
                                        <select name="paymentStatus" onchange="this.form.submit()"
                                            class="border-none bg-transparent text-xs font-semibold uppercase tracking-[0.25em] text-neutral-700 focus:outline-none focus:ring-0">

                                            <option value="ALL" <%=currentPaymentStatus==="ALL" ? "selected" : "" %>>
                                                Payment: All
                                            </option>

                                            <option value="PENDING" <%=currentPaymentStatus==="PENDING" ? "selected"
                                                : "" %>
                                                >
                                                Payment: Pending
                                            </option>

                                            <option value="PAID" <%=currentPaymentStatus==="PAID" ? "selected" : "" %>>
                                                Payment: Paid
                                            </option>

                                            <option value="FAILED" <%=currentPaymentStatus==="FAILED" ? "selected" : ""
                                                %>>
                                                Payment: Failed
                                            </option>

                                        </select>


                                        <!-- Divider -->
                                        <div class="mx-6 h-6 w-px bg-neutral-200"></div>


                                        <!-- Reset -->
                                        <a href="/admin/orders"
                                            class="ml-2 text-xs font-medium uppercase tracking-[0.25em] text-neutral-400 transition hover:text-black whitespace-nowrap">
                                            Reset Filters
                                        </a>

                                    </div>
                                </form>
                            </div>
                            <!-- Orders Table Card -->
                            <div class="bg-white border border-outline-variant rounded-xl overflow-hidden">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="border-b border-outline-variant bg-surface-container-lowest">
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider">
                                                    Order ID</th>
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider">
                                                    Customer</th>
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider">
                                                    Products</th>
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider text-right">
                                                    Amount</th>
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider">
                                                    Status</th>
                                                <th
                                                    class="px-lg py-md font-label-md text-on-surface-variant uppercase tracking-wider text-center">
                                                    Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-outline-variant">

                                            <% if (!orders || orders.length===0) { %>

                                                <tr>
                                                    <td colspan="6"
                                                        class="px-lg py-xl text-center text-on-surface-variant">
                                                        NO ORDERS FOUND
                                                    </td>
                                                </tr>

                                                <% } else { %>

                                                    <% orders.forEach(order=> { %>

                                                        <% const firstItem=order.items?.[0]; const
                                                            remainingItems=Math.max((order.items?.length || 0) - 1, 0);
                                                            const customerName=order.deliveryAddress?.fullName
                                                            || "UNKNOWN CUSTOMER" ; %>

                                                            <tr
                                                                class="hover:bg-surface-container-lowest transition-colors">

                                                                <!-- ORDER ID -->
                                                                <td class="px-lg py-md font-label-md text-primary">
                                                                    <%= order.orderId %>
                                                                </td>


                                                                <!-- CUSTOMER -->
                                                                <td class="px-lg py-md">

                                                                    <div class="flex flex-col">

                                                                        <span class="font-body-md font-medium">
                                                                            <%= customerName %>
                                                                        </span>

                                                                        <span
                                                                            class="text-body-sm text-on-surface-variant">
                                                                            <%= order.deliveryAddress?.phone
                                                                                || "NO PHONE" %>
                                                                        </span>

                                                                    </div>

                                                                </td>


                                                                <!-- PRODUCTS -->
                                                                <td class="px-lg py-md">

                                                                    <div class="flex items-center gap-2">

                                                                        <!-- First Product -->
                                                                        <span class="font-body-md text-on-surface">
                                                                            <%= order.items[0]?.name || "No products" %>

                                                                                <% if (order.items[0]?.size) { %>
                                                                                    (<%= order.items[0].size %>)
                                                                                        <% } %>
                                                                        </span>

                                                                        <% if (order.items.length> 1) { %>

                                                                            <button type="button"
                                                                                class="view-more-products text-primary font-semibold text-sm hover:underline"
                                                                                data-order-id="<%= order.orderId %>">

                                                                                + <%= order.items.length - 1 %> more

                                                                            </button>

                                                                            <% } %>

                                                                    </div>

                                                                </td>


                                                                <!-- AMOUNT -->
                                                                <td
                                                                    class="px-lg py-md font-body-md font-semibold text-right">
                                                                    ₹<%= Number(order.total ||
                                                                        0).toLocaleString("en-IN") %>
                                                                </td>


                                                                <!-- STATUS -->
                                                                <td class="px-lg py-md">

                                                                    <% if (order.orderStatus==="RETURN_REQUESTED" ) { %>

                                                                        <span
                                                                            class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] uppercase font-bold bg-blue-100 text-blue-700 border border-blue-200">
                                                                            Return Requested
                                                                        </span>

                                                                        <% } else if (order.orderStatus==="RETURNED" ) {
                                                                            %>

                                                                            <span
                                                                                class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] uppercase font-bold bg-purple-100 text-purple-700 border border-purple-200">
                                                                                Returned
                                                                            </span>

                                                                            <% } else { %>

                                                                                <form
                                                                                    action="/admin/orders/<%= order.orderId %>/status"
                                                                                    method="POST">

                                                                                    <select name="status"
                                                                                        onchange="this.form.submit()"
                                                                                        class="px-sm py-xs rounded font-label-md text-[10px] uppercase font-bold border border-outline-variant bg-white focus:outline-none focus:ring-1 focus:ring-primary">

                                                                                        <option value="PLACED"
                                                                                            <%=order.orderStatus==="PLACED"
                                                                                            ? "selected" : "" %>>
                                                                                            Placed
                                                                                        </option>

                                                                                        <option value="CONFIRMED"
                                                                                            <%=order.orderStatus==="CONFIRMED"
                                                                                            ? "selected" : "" %>>
                                                                                            Confirmed
                                                                                        </option>

                                                                                        <option value="SHIPPED"
                                                                                            <%=order.orderStatus==="SHIPPED"
                                                                                            ? "selected" : "" %>>
                                                                                            Shipped
                                                                                        </option>

                                                                                        <option value="DELIVERED"
                                                                                            <%=order.orderStatus==="DELIVERED"
                                                                                            ? "selected" : "" %>>
                                                                                            Delivered
                                                                                        </option>

                                                                                        <option value="CANCELLED"
                                                                                            <%=order.orderStatus==="CANCELLED"
                                                                                            ? "selected" : "" %>>
                                                                                            Cancelled
                                                                                        </option>

                                                                                    </select>

                                                                                </form>

                                                                                <% } %>

                                                                </td>


                                                                <!-- ACTIONS -->
                                                                <td class="px-lg py-md">

                                                                    <div class="flex justify-center gap-sm">

                                                                        <a href="/admin/orders/<%= order.orderId %>"
                                                                            class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors text-[20px]"
                                                                            title="View order">
                                                                            visibility
                                                                        </a>

                                                                    </div>

                                                                </td>

                                                            </tr>

                                                            <% }) %>

                                                                <% } %>

                                        </tbody>
                                    </table>
                                </div>
                                <div
                                    class="bg-surface-container-lowest px-lg py-md border-t border-outline-variant flex items-center justify-between">

                                    <% const startOrder=totalOrders===0 ? 0 : ((currentPage - 1) * perPage) + 1; const
                                        endOrder=Math.min(currentPage * perPage, totalOrders); %>

                                        <span class="font-body-sm text-on-surface-variant">

                                            Showing
                                            <%= startOrder %>
                                                -
                                                <%= endOrder %>
                                                    of
                                                    <%= totalOrders %>
                                                        orders

                                        </span>


                                        <div class="flex gap-sm">

                                            <% if (currentPage> 1) { %>

                                                <a href="/admin/orders?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= currentStatus %>&paymentStatus=<%= currentPaymentStatus %>"
                                                    class="px-md py-sm border border-outline-variant rounded-lg text-body-sm hover:bg-surface-container-low">
                                                    Previous
                                                </a>

                                                <% } else { %>

                                                    <span
                                                        class="px-md py-sm border border-outline-variant rounded-lg text-body-sm opacity-40">
                                                        Previous
                                                    </span>

                                                    <% } %>


                                                        <% if (currentPage < totalPages) { %>

                                                            <a href="/admin/orders?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= currentStatus %>&paymentStatus=<%= currentPaymentStatus %>"
                                                                class="px-md py-sm bg-primary text-on-primary rounded-lg text-body-sm hover:opacity-90">
                                                                Next
                                                            </a>

                                                            <% } else { %>

                                                                <span
                                                                    class="px-md py-sm border border-outline-variant rounded-lg text-body-sm opacity-40">
                                                                    Next
                                                                </span>

                                                                <% } %>

                                        </div>

                                </div>
                            </div>
                        </div>
                        <!-- Side Widgets Column -->

                    </div>
                </main>

                <!-- MULTIPLE PRODUCTS MODAL -->
                <div id="productsModal"
                    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 px-4">

                    <!-- Modal -->
                    <div id="productsModalContent"
                        class="w-full max-w-3xl bg-white border border-neutral-300 rounded-lg shadow-xl overflow-hidden">

                        <!-- Header -->
                        <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-200">

                            <div>
                                <p class="text-[10px] uppercase tracking-[0.25em] text-neutral-400 font-semibold">
                                    ORDER PRODUCTS
                                </p>

                                <h2 class="mt-1 text-xl font-semibold text-black">
                                    All Products
                                </h2>
                            </div>

                            <button type="button" id="closeProductsModal"
                                class="flex items-center justify-center w-9 h-9 border border-neutral-300 text-neutral-500 hover:text-black hover:border-black transition">

                                <span class="material-symbols-outlined text-[20px]">
                                    close
                                </span>

                            </button>

                        </div>


                        <!-- Products -->
                        <div id="productsModalList" class="max-h-[60vh] overflow-y-auto divide-y divide-neutral-200">
                        </div>


                        <!-- Footer -->
                        <div
                            class="px-6 py-5 bg-neutral-50 border-t border-neutral-200 flex items-center justify-between">

                            <span id="productsModalCount" class="text-xs uppercase tracking-[0.2em] text-neutral-400">
                            </span>

                            <button type="button" id="closeProductsModalBottom"
                                class="px-5 py-2.5 border border-black bg-black text-white text-xs uppercase tracking-[0.18em] hover:bg-neutral-800 transition">

                                Close

                            </button>

                        </div>

                    </div>

                </div>

                <script id="ordersData" type="application/json">
    <%- JSON.stringify(orders) %>
</script>
                <script>

                    const ordersDataElement = document.getElementById("ordersData");

                    const ordersData = JSON.parse(
                        ordersDataElement.textContent
                    );

                    console.log("Orders data:", ordersData);
                    // ==========================================
                    // MODAL ELEMENTS
                    // ==========================================

                    const productsModal =
                        document.getElementById("productsModal");

                    const productsModalList =
                        document.getElementById("productsModalList");

                    const productsModalCount =
                        document.getElementById("productsModalCount");

                    const closeProductsModal =
                        document.getElementById("closeProductsModal");

                    const closeProductsModalBottom =
                        document.getElementById("closeProductsModalBottom");


                    // ==========================================
                    // SAFETY CHECK
                    // ==========================================

                    console.log("Orders data:", ordersData);
                    console.log(
                        "View more buttons:",
                        document.querySelectorAll(".view-more-products").length
                    );


                    // ==========================================
                    // STATUS STYLES
                    // ==========================================




                    // ==========================================
                    // OPEN MODAL
                    // ==========================================

                    document
                        .querySelectorAll(".view-more-products")
                        .forEach(button => {

                            button.addEventListener("click", function () {

                                console.log("VIEW MORE CLICKED");

                                const orderId =
                                    this.dataset.orderId;

                                console.log("Order ID:", orderId);


                                // Find order
                                const order =
                                    ordersData.find(
                                        order => order.orderId === orderId
                                    );


                                if (!order) {

                                    console.error(
                                        "Order not found:",
                                        orderId
                                    );

                                    return;
                                }


                                const products = order.items;


                                if (!products || products.length === 0) {

                                    console.error(
                                        "No products found for:",
                                        orderId
                                    );

                                    return;
                                }


                                console.log(
                                    "Products:",
                                    products
                                );


                                // ==========================================
                                // CLEAR OLD PRODUCTS
                                // ==========================================

                                productsModalList.innerHTML = "";


                                // ==========================================
                                // RENDER PRODUCTS
                                // ==========================================

                                products.forEach(product => {


                                    const productRow = document.createElement("div");

                                    productRow.className =
                                        "flex items-center gap-4 px-6 py-5 border-b border-neutral-200 last:border-b-0";

                                    productRow.innerHTML = `
    <div class="w-16 h-16 bg-neutral-100 border border-neutral-200 flex-shrink-0">
        <img
            src="${escapeHtml(product.image || "")}"
            alt="${escapeHtml(product.name || "Product")}"
            class="w-full h-full object-cover"
        >
    </div>

    <div class="flex-1 min-w-0">

        <p class="text-sm font-semibold text-black truncate">
            ${escapeHtml(product.name || "Unknown Product")}
        </p>

        <div class="flex items-center gap-4 mt-2 text-xs text-neutral-500">

            <span>
                SIZE:
                ${escapeHtml(product.size || "-")}
            </span>

            <span>
                QTY:
                ${product.quantity || 0}
            </span>

        </div>

    </div>
`;

                                    productsModalList.appendChild(productRow);

                                });


                                // ==========================================
                                // PRODUCT COUNT
                                // ==========================================

                                productsModalCount.textContent =
                                    `${products.length} PRODUCTS`;




                                // Hide cancelled row if nothing was cancelled


                                productsModal.classList.remove("hidden");
                                productsModal.classList.add("flex");



                                // ==========================================
                                // SHOW MODAL
                                // ==========================================

                                productsModal.classList.remove("hidden");

                                productsModal.classList.add("flex");

                                document.body.classList.add(
                                    "overflow-hidden"
                                );

                            });

                        });


                    // ==========================================
                    // CLOSE MODAL
                    // ==========================================

                    function closeProductsModalFunction() {

                        productsModal.classList.add("hidden");

                        productsModal.classList.remove("flex");

                        document.body.classList.remove(
                            "overflow-hidden"
                        );

                        productsModalList.innerHTML = "";

                    }


                    // ==========================================
                    // CLOSE X BUTTON
                    // ==========================================

                    closeProductsModal.addEventListener(
                        "click",
                        closeProductsModalFunction
                    );


                    // ==========================================
                    // CLOSE BOTTOM BUTTON
                    // ==========================================

                    closeProductsModalBottom.addEventListener(
                        "click",
                        closeProductsModalFunction
                    );


                    // ==========================================
                    // CLICK OUTSIDE MODAL
                    // ==========================================

                    productsModal.addEventListener(
                        "click",
                        function (event) {

                            if (
                                event.target === productsModal
                            ) {

                                closeProductsModalFunction();

                            }

                        }
                    );


                    // ==========================================
                    // ESC KEY
                    // ==========================================

                    document.addEventListener(
                        "keydown",
                        function (event) {

                            if (
                                event.key === "Escape" &&
                                !productsModal.classList.contains("hidden")
                            ) {

                                closeProductsModalFunction();

                            }

                        }
                    );


                    // ==========================================
                    // HTML ESCAPE
                    // ==========================================

                    function escapeHtml(value) {

                        const div =
                            document.createElement("div");

                        div.textContent =
                            value ?? "";

                        return div.innerHTML;

                    }

                </script>
</body>

</html>