    <style>
        body {
            background-color: #fcf9f8;
            color: #1c1b1b;
            -webkit-font-smoothing: antialiased;
        }

        .border-grid {
            border: 1px solid #000000;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 48;
        }

        .btn-hover-invert:hover {
            background-color: #000000;
            color: #ffffff;
        }
    </style>
</head>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body class="font-body-md">
    <%- include("partials/userHeader") %>
    <%- include("partials/toast") %>

    <main class="pt-32 pb-20 px-mobile-margin md:px-container-padding max-w-[1440px] mx-auto min-h-screen">
        <!-- Header Section -->
        <section class="border-grid p-8 md:p-16 mb-[-1px] relative overflow-hidden bg-white">
            <div class="relative z-10">
                <div class="mb-8 w-16 h-16 border-grid flex items-center justify-center">
                    <span class="material-symbols-outlined text-4xl" data-icon="close"
                        style="opacity: 0.4;">close</span>
                </div>
                <h1 class="font-display-xl text-headline-lg-mobile md:text-display-xl mb-4 leading-none">PAYMENT FAILED
                </h1>
                <p class="font-headline-md text-headline-md max-w-2xl">We were unable to complete your archive
                    acquisition.</p>
                <div class="mt-8 border-t border-black pt-8 max-w-xl">
                    <p class="font-body-lg text-body-lg text-on-surface-variant">Your payment could not be processed. No
                        amount has been charged successfully. Please review your payment method and try again.</p>
                </div>
            </div>
            <!-- Decorative Brutalist element -->
            <div
                class="absolute top-0 right-0 w-1/4 h-full border-l border-black hidden lg:flex items-center justify-center pointer-events-none opacity-5">
                <span class="font-display-xl text-[200px] leading-none select-none">✕</span>
            </div>
        </section>
        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 border-grid border-t-0">
            <!-- Left Column: Product Summary -->
            <div class="lg:col-span-5 border-r border-black p-4 md:p-6">
                <div class="font-label-caps text-label-caps mb-4 border-b border-black pb-2">ARCHIVE ITEM</div>
                <% if (items && items.length > 0) { %>
                    <% items.forEach(item=> { %>
                        <div class="flex items-center gap-4 border-grid p-4 bg-white mb-4">
                            <div class="w-[100px] h-[100px] flex-shrink-0 border-grid overflow-hidden">
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-grow">
                                <h3 class="font-headline-md text-body-lg leading-tight">
                                    <%= item.name %>
                                </h3>
                                <p class="font-mono-data text-[10px] text-on-surface-variant uppercase">
                                    Size <%= item.size %> / Qty <%= item.quantity %>
                                </p>
                                <p class="font-mono-data text-body-md font-bold mt-2">
                                    ₹<%= Number(item.price).toLocaleString("en-IN") %>
                                </p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="font-mono-data text-secondary">No item details available.</p>
                <% } %>
            </div>
            <!-- Right Column: Failure Summary & Actions -->
            <div class="lg:col-span-7 flex flex-col">
                <!-- Data Table -->
                <div class="p-8 md:p-12 border-b border-black flex-grow">
                    <div class="font-label-caps text-label-caps mb-8 border-b border-black pb-2">FAILURE SUMMARY</div>
                    <div class="space-y-0 border-grid overflow-hidden">
                        <div class="grid grid-cols-2 border-b border-black">
                            <div class="p-4 border-r border-black bg-surface-container-low font-label-caps text-[10px]">
                                ORDER REFERENCE</div>
                            <div class="p-4 font-mono-data text-mono-data">#<%= orderId || "PENDING" %>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 border-b border-black">
                            <div class="p-4 border-r border-black bg-surface-container-low font-label-caps text-[10px]">
                                PAYMENT METHOD</div>
                            <div class="p-4 font-mono-data text-mono-data uppercase">
                                <%= paymentMethod || "RAZORPAY" %>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 border-b border-black">
                            <div class="p-4 border-r border-black bg-surface-container-low font-label-caps text-[10px]">
                                AMOUNT</div>
                            <div class="p-4 font-mono-data text-mono-data font-bold">₹<%= Number(amount ||
                                    0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                                    %>
                            </div>
                        </div>
                        <div class="grid grid-cols-2">
                            <div
                                class="p-4 border-r border-black bg-surface-container-low font-label-caps text-[10px] text-error">
                                FAILURE REASON</div>
                            <div class="p-4 font-mono-data text-mono-data text-error uppercase">
                                <%= reason || "Payment failed" %>
                            </div>
                        </div>
                    </div>
                    <!-- Help Section -->
                    <div class="mt-12 p-6 border-grid border-dashed border-primary">
                        <p class="font-body-md text-body-md">
                            <span class="font-bold">Need assistance?</span> If the issue persists, contact our support
                            team and include your order reference number for faster assistance.
                        </p>
                    </div>
                </div>
                <!-- Actions Section -->
                <div class="p-8 md:p-12 bg-white">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                        <% if (orderId) { %>
                            <button onclick="retryPayment('<%= orderId %>')"
                                class="border-grid bg-primary text-on-primary p-6 font-label-caps text-label-caps transition-all hover:bg-on-surface-variant text-center cursor-pointer">
                                TRY PAYMENT AGAIN
                            </button>
                        <% } else { %>
                            <a href="/cart"
                                class="border-grid bg-primary text-on-primary p-6 font-label-caps text-label-caps transition-all hover:bg-on-surface-variant text-center">
                                RETURN TO CART
                            </a>
                        <% } %>
                        <a href="/orders"
                            class="border-grid text-primary p-6 font-label-caps text-label-caps btn-hover-invert transition-all text-center">
                            VIEW ORDER HISTORY
                        </a>
                    </div>
                    <div class="flex flex-col md:flex-row gap-6 justify-between items-center">
                        <div class="flex gap-8">
                            <a class="font-label-caps text-[11px] underline underline-offset-4 hover:no-underline transition-all"
                                href="/cart">RETURN TO CART</a>
                            <a class="font-label-caps text-[11px] underline underline-offset-4 hover:no-underline transition-all"
                                href="/products">CONTINUE BROWSING</a>
                        </div>
                        <span
                            class="font-mono-data text-[10px] text-on-surface-variant uppercase tracking-widest">A01-PROTOCOL-FAIL</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer Notice -->
        <footer class="mt-[-1px] border-grid p-8 text-center bg-surface-container-low">
            <p class="font-body-md text-body-md max-w-3xl mx-auto">
                Every archive piece remains reserved for a limited time. You may retry payment without losing your
                selection.
            </p>
        </footer>
    </main>

    <%- include("partials/userFooter") %>

    <script>
        async function retryPayment(orderId) {
            if (!orderId) {
                window.location.href = '/checkout';
                return;
            }
            try {
                const response = await fetch(`/checkout/retry-payment/${orderId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    showToast(data.message || 'FAILED TO RETRY PAYMENT', 'error');
                    return;
                }

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    name: "ARCHIVE",
                    description: "ARCHIVE Jersey Store",
                    order_id: data.razorpayOrderId,
                    handler: async function (paymentResponse) {
                        try {
                            const res = await fetch("/checkout/verify-retry-payment", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({
                                    razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                    razorpay_order_id: paymentResponse.razorpay_order_id,
                                    razorpay_signature: paymentResponse.razorpay_signature,
                                    orderId: orderId
                                })
                            });
                            const resData = await res.json();
                            if (!res.ok || !resData.success) {
                                throw new Error(resData.message || "VERIFICATION FAILED");
                            }
                            window.location.href = `/order-success/${resData.orderId}`;
                        } catch (err) {
                            showToast(err.message || "PAYMENT VERIFICATION FAILED", "error");
                        }
                    },
                    theme: { color: "#000000" }
                };
                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                showToast(err.message || "FAILED TO RETRY PAYMENT", "error");
            }
        }
    </script>
</body>

</html>