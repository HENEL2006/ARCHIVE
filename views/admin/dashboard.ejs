<!DOCTYPE html>
<html class="light" lang="en">

<head></head>

<body class="font-body-md text-body-md overflow-x-hidden">

    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>ARCHIVE | Admin Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@500&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-background": "#191c1e",
                        "surface-tint": "#565e74",
                        "inverse-on-surface": "#eff1f3",
                        "on-tertiary-fixed-variant": "#004c69",
                        "primary-container": "#131b2e",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "primary": "#000000",
                        "tertiary": "#000000",
                        "on-tertiary-container": "#008ebf",
                        "on-primary": "#ffffff",
                        "surface-bright": "#f7f9fb",
                        "on-surface-variant": "#45464d",
                        "secondary-container": "#d0e1fb",
                        "on-primary-fixed": "#131b2e",
                        "surface-container-high": "#e6e8ea",
                        "tertiary-container": "#001e2c",
                        "surface-container-low": "#f2f4f6",
                        "outline-variant": "#c6c6cd",
                        "surface-container": "#eceef0",
                        "on-error": "#ffffff",
                        "secondary-fixed-dim": "#b7c8e1",
                        "on-secondary": "#ffffff",
                        "on-tertiary": "#ffffff",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#c4e7ff",
                        "surface": "#f7f9fb",
                        "surface-dim": "#d8dadc",
                        "surface-variant": "#e0e3e5",
                        "on-secondary-fixed-variant": "#38485d",
                        "secondary-fixed": "#d3e4fe",
                        "error": "#ba1a1a",
                        "secondary": "#505f76",
                        "inverse-primary": "#bec6e0",
                        "primary-fixed": "#dae2fd",
                        "on-error-container": "#93000a",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-fixed": "#001e2c",
                        "background": "#f7f9fb",
                        "on-primary-container": "#7c839b",
                        "surface-container-highest": "#e0e3e5",
                        "outline": "#76777d",
                        "on-secondary-fixed": "#0b1c30",
                        "on-surface": "#191c1e",
                        "on-primary-fixed-variant": "#3f465c",
                        "inverse-surface": "#2d3133",
                        "on-secondary-container": "#54647a",
                        "primary-fixed-dim": "#bec6e0"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "8px",
                        "xl": "8px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "xl": "32px",
                        "2xl": "48px",
                        "sm": "8px",
                        "lg": "24px",
                        "xs": "4px",
                        "md": "16px",
                        "base": "4px",
                        "margin": "32px"
                    },
                    "fontFamily": {
                        "label-md": ["JetBrains Mono"],
                        "headline-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "display": ["Inter"]
                    },
                    "fontSize": {
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }],
                        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        body {
            background-color: #F7F9FB;
            color: #191C1E;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
        }

        .sharp-border {
            border: 1px solid #e0e3e5;
        }
    </style>
    <!-- SideNavBar (Shared Component) -->

    <%- include("partials/toast") %>
        <aside
            class="fixed h-screen w-64 left-0 top-0 bg-surface-container-lowest border-r border-outline-variant flex flex-col py-xl px-md z-50 overflow-x-hidden">
            <div class="mb-2xl px-sm">
                <h1 class="font-display text-display text-on-surface tracking-tighter">ARCHIVE</h1>
                <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest mt-xs">Heritage
                    Kit Co.</p>
            </div>
            <nav class="flex-1 space-y-sm overflow-y-auto overflow-x-hidden">
                <a class="flex items-center gap-md bg-surface-container text-on-surface font-semibold border-l-2 border-primary px-md py-sm transition-all"
                    href="/admin/dashboard">
                    <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                    <span class="font-label-md">Dashboard</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/products">
                    <span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
                    <span class="font-label-md">Products</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/category">
                    <span class="material-symbols-outlined" data-icon="category">category</span>
                    <span class="font-label-md">Categories</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/orders">
                    <span class="material-symbols-outlined" data-icon="receipt_long">receipt_long</span>
                    <span class="font-label-md">Orders</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/return">
                    <span class="material-symbols-outlined" data-icon="assignment_return">assignment_return</span>
                    <span class="font-label-md">Returns</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/customers" style="transform: translateX(0px);">
                    <span class="material-symbols-outlined" data-icon="group">group</span>
                    <span class="font-label-md">Customers</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/coupons">
                    <span class="material-symbols-outlined" data-icon="local_offer">local_offer</span>
                    <span class="font-label-md">Coupons</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/offers">
                    <span class="material-symbols-outlined" data-icon="local_offer">percent</span>
                    <span class="text-[14px] font-medium">Offers</span>
                </a>
                <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="/admin/salesReport">
                    <span class="material-symbols-outlined" data-icon="local_offer">monitoring</span>
                    <span class="text-[14px] font-medium">Sales Report</span>
                </a>


                <!-- <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-md py-sm rounded-lg transition-all duration-200"
                    href="#">
                    <span class="material-symbols-outlined" data-icon="settings">settings</span>
                    <span class="font-label-md">Settings</span>
                </a> -->
            </nav>
            <div class="mt-auto pt-lg border-t border-outline-variant space-y-sm">
                <button
                    class="w-full text-left flex items-center gap-md text-on-surface-variant hover:text-on-surface px-md py-sm transition-all">
                    <span class="material-symbols-outlined" data-icon="help">help</span>
                    <span class="font-label-md">Support</span>
                </button>
                <a href="/admin/logout"
                    class="w-full text-left flex items-center gap-md text-error hover:bg-error-container/20 px-md py-sm rounded-lg transition-all">
                    <span class="material-symbols-outlined" data-icon="logout">logout</span>
                    <span class="font-label-md">Log Out</span>
                </a>
            </div>
        </aside>
        <!-- Main Content Area -->
        <main class="ml-64 min-h-screen">
            <!-- TopNavBar (Shared Component) -->
            <header
                class="fixed top-0 right-0 w-[calc(100%-256px)] h-16 flex justify-between items-center px-xl z-40 bg-surface/80 backdrop-blur-md border-b border-outline-variant">
                <div class="flex items-center flex-1 max-w-lg">
                    <div class="relative w-full">
                        <span
                            class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]"
                            data-icon="search">search</span>
                        <input
                            class="w-full bg-surface-container-low border-none rounded-lg pl-10 pr-4 py-2 focus:ring-1 focus:ring-primary text-body-md transition-all"
                            placeholder="Search orders, kits, or customers..." type="text">
                    </div>
                </div>
                <div class="flex items-center gap-lg">

                    <div class="flex items-center gap-md text-on-surface-variant">
                        <button class="hover:bg-surface-container-high p-2 rounded-lg transition-all relative">
                            <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
                            <span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"></span>
                        </button>
                        <div class="h-8 w-[1px] bg-outline-variant"></div>
                        <div
                            class="flex items-center gap-sm cursor-pointer hover:bg-surface-container-high p-1 rounded-lg transition-all">
                            <img alt="Admin Profile" class="w-8 h-8 rounded-full border border-outline-variant"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuD8wLwORVf-XDgaH-eMImwN5A9873e60Xp0ZW00JE6nwJqEGia7NZuP0S4oTn8fNPkJThWa8ZOu8TYv68uZVuqwsEzEERA_bcKCs5LpnuDGfCjJhDyXRNzTzC5W-5pjGBI40ZfjHWvH5F2wqQuK4K2qbT1Fy5rtFEPfSUSwkC2BlJ3H5wzmaEIz-ZTNZEnxHBGj9gsPPOZ342KWuh51iLCTqqJRbD5hfW7OaaS_OWek4EKGg1jYBBM9iwl7qMNVFSocT_cxx3NA0bg">
                            <span class="font-label-md hidden lg:block">Admin</span>
                        </div>
                    </div>
                </div>
            </header>
            <!-- Page Content -->
            <div class="pt-24 px-xl pb-xl max-w-[1440px] mx-auto">
                <!-- Page Header -->
                <div class="mb-xl">
                    <h2 class="font-headline-lg text-headline-lg">Dashboard</h2>
                    <p class="text-on-surface-variant font-body-md">Store performance overview</p>
                </div>
                <!-- Top Metric Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg mb-xl">

                    <!-- Total Revenue -->
                    <div class="bg-surface-container-lowest p-lg sharp-border rounded-lg">
                        <p class="text-on-surface-variant font-label-md uppercase tracking-wider mb-sm">
                            Total Revenue
                        </p>

                        <div class="flex items-baseline gap-sm mb-xs">
                            <h3 class="font-display text-[28px] font-bold">
                                ₹<%= Number(statistics.totalRevenue || 0).toLocaleString("en-IN") %>
                            </h3>
                        </div>

                        <p class="text-on-surface-variant text-body-sm">
                            Net revenue
                        </p>
                    </div>


                    <!-- Total Orders -->
                    <div class="bg-surface-container-lowest p-lg sharp-border rounded-lg">
                        <p class="text-on-surface-variant font-label-md uppercase tracking-wider mb-sm">
                            Total Orders
                        </p>

                        <div class="flex items-baseline gap-sm mb-xs">
                            <h3 class="font-display text-[28px] font-bold">
                                <%= Number(statistics.totalOrders || 0).toLocaleString("en-IN") %>
                            </h3>
                        </div>

                        <p class="text-on-surface-variant text-body-sm">
                            All orders
                        </p>
                    </div>


                    <!-- Customers -->
                    <div class="bg-surface-container-lowest p-lg sharp-border rounded-lg">
                        <p class="text-on-surface-variant font-label-md uppercase tracking-wider mb-sm">
                            Customers
                        </p>

                        <div class="flex items-baseline gap-sm mb-xs">
                            <h3 class="font-display text-[28px] font-bold">
                                <%= Number(statistics.totalCustomers || 0).toLocaleString("en-IN") %>
                            </h3>
                        </div>

                        <p class="text-on-surface-variant text-body-sm">
                            Registered customers
                        </p>
                    </div>


                    <!-- Products -->
                    <div class="bg-surface-container-lowest p-lg sharp-border rounded-lg">
                        <p class="text-on-surface-variant font-label-md uppercase tracking-wider mb-sm">
                            Products
                        </p>

                        <div class="flex items-baseline gap-sm mb-xs">
                            <h3 class="font-display text-[28px] font-bold">
                                <%= Number(statistics.totalProducts || 0).toLocaleString("en-IN") %>
                            </h3>
                        </div>

                        <p class="text-on-surface-variant text-body-sm">
                            Active products
                        </p>
                    </div>

                </div>
                <!-- Revenue Analytics -->
                <div class="bg-surface-container-lowest p-xl sharp-border rounded-lg mb-xl">

                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-md mb-xl">

                        <div>
                            <h4 class="font-headline-md text-headline-md">
                                Revenue Analytics
                            </h4>

                            <p class="text-body-sm text-on-surface-variant">
                                Performance trend across selected timeframe
                            </p>
                        </div>


                        <!-- RANGE BUTTONS -->

                        <div class="flex bg-surface-container-low p-1 rounded-lg border border-outline-variant">

                            <a href="/admin/dashboard?range=today" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'today'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                Today
                            </a>


                            <a href="/admin/dashboard?range=thisWeek" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'thisWeek'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                This Week
                            </a>


                            <a href="/admin/dashboard?range=lastWeek" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'lastWeek'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                Last Week
                            </a>


                            <a href="/admin/dashboard?range=thisMonth" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'thisMonth'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                This Month
                            </a>


                            <a href="/admin/dashboard?range=lastMonth" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'lastMonth'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                Last Month
                            </a>


                            <a href="/admin/dashboard?range=thisYear" class="px-md py-1 text-label-md rounded transition-colors
                <%= selectedRange === 'thisYear'
                    ? 'bg-surface-container-lowest shadow-sm'
                    : 'hover:bg-surface-container'
                %>">
                                This Year
                            </a>

                        </div>

                    </div>


                    <!-- CHART -->

                    <div class="chart-container">

                        <svg id="revenueChart" class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 1000 320">

                            <!-- Horizontal grid lines -->

                            <line opacity="0.1" stroke="#000000" x1="0" x2="1000" y1="80" y2="80" />

                            <line opacity="0.1" stroke="#000000" x1="0" x2="1000" y1="160" y2="160" />

                            <line opacity="0.1" stroke="#000000" x1="0" x2="1000" y1="240" y2="240" />


                            <!-- Revenue line -->

                            <polyline id="revenueLine" fill="none" stroke="#000000" stroke-width="3"
                                stroke-linejoin="round" stroke-linecap="round">
                            </polyline>


                            <!-- Revenue points -->

                            <g id="revenuePoints"></g>

                        </svg>

                    </div>


                    <!-- Dynamic labels -->

                    <div id="chartLabels"
                        class="flex justify-between mt-md font-label-md text-on-surface-variant border-t border-outline-variant pt-md">
                    </div>

                </div>
                <!-- Secondary Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">
                    <!-- Recent Orders Table -->
                    <div
                        class="lg:col-span-2 bg-surface-container-lowest sharp-border rounded-lg overflow-hidden flex flex-col">
                        <div class="p-lg border-b border-outline-variant flex justify-between items-center">
                            <h4 class="font-headline-md text-headline-md">Recent Orders</h4>
                            <a class="text-primary font-label-md hover:underline" href="/admin/orders">View All</a>
                        </div>
                        <div class="overflow-x-auto flex-1">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="border-b border-outline-variant bg-surface-container-low/50">
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant">
                                            Order ID</th>
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant">
                                            Customer</th>
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant">
                                            Product</th>
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant">
                                            Date</th>
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant">
                                            Status</th>
                                        <th
                                            class="px-lg py-md font-label-md text-[11px] uppercase tracking-wider text-on-surface-variant text-right">
                                            Amount</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant">

                                    <% if (recentOrders && recentOrders.length> 0) { %>

                                        <% recentOrders.forEach(order=> { %>

                                            <tr class="hover:bg-surface-container-low transition-colors group">

                                                <!-- Order ID -->
                                                <td class="px-lg py-lg font-label-md">
                                                    #<%= order.orderId %>
                                                </td>

                                                <!-- Customer -->
                                                <td class="px-lg py-lg text-body-sm font-semibold">
                                                    <%= order.userId?.username || "Unknown" %>
                                                </td>

                                                <!-- Product -->
                                                <td class="px-lg py-lg text-body-sm">
                                                    <%= order.items?.[0]?.name || "Product" %>

                                                        <% if (order.items?.length> 1) { %>
                                                            <span class="text-on-surface-variant">
                                                                +<%= order.items.length - 1 %> more
                                                            </span>
                                                            <% } %>
                                                </td>

                                                <!-- Date -->
                                                <td class="px-lg py-lg text-body-sm text-on-surface-variant">
                                                    <%= new Date(order.createdAt).toLocaleDateString("en-IN", {
                                                        day: "2-digit" , month: "short" , year: "numeric" }) %>
                                                </td>

                                                <!-- Status -->
                                                <td class="px-lg py-lg">
                                                    <span
                                                        class="px-md py-1 border border-secondary text-secondary text-[10px] font-label-md uppercase rounded">
                                                        <%= order.orderStatus %>
                                                    </span>
                                                </td>

                                                <!-- Amount -->
                                                <td class="px-lg py-lg font-label-md text-right">
                                                    ₹<%= Number(order.total || 0).toLocaleString("en-IN") %>
                                                </td>

                                            </tr>

                                            <% }) %>

                                                <% } else { %>

                                                    <tr>
                                                        <td colspan="6"
                                                            class="px-lg py-xl text-center text-on-surface-variant">
                                                            No orders found
                                                        </td>
                                                    </tr>

                                                    <% } %>

                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Right Column -->
                    <div class="flex flex-col gap-lg">
                        <!-- Low Stock Alerts -->
                        <div class="bg-surface-container-lowest p-lg sharp-border rounded-lg">
                            <h4 class="font-headline-md text-headline-md mb-lg">Low Stock Alerts</h4>
                            <div class="space-y-md">

                                <% if (lowStockItems && lowStockItems.length> 0) { %>

                                    <% lowStockItems.forEach(item=> { %>

                                        <div
                                            class="flex justify-between items-center border-b border-outline-variant pb-md">

                                            <div>
                                                <p class="font-label-md text-on-surface">
                                                    <%= item.productName %>
                                                </p>

                                                <p class="text-body-sm text-on-surface-variant">
                                                    Size: <%= item.size %>
                                                </p>
                                            </div>

                                            <span class="text-error font-label-md">
                                                <%= item.stock %> Left
                                            </span>

                                        </div>

                                        <% }) %>

                                            <% } else { %>

                                                <div class="py-md text-body-sm text-on-surface-variant">
                                                    No low stock items
                                                </div>

                                                <% } %>

                            </div>
                        </div>
                        <!-- Return Requests -->

                        <!-- Quick Actions -->

                    </div>
                </div>
            </div>
        </main>
        <script>
            document.querySelectorAll('aside nav a').forEach(link => {
                link.addEventListener('mouseenter', () => {
                    if (!link.classList.contains('bg-surface-container')) {
                        link.style.transform = 'translateX(4px)';
                    }
                });
                link.addEventListener('mouseleave', () => {
                    link.style.transform = 'translateX(0)';
                });
            });




            /*
             * Revenue chart data from dashboardService.js
             */

            const revenueData = <%- JSON.stringify(revenueChart || []) %>;

            const chartWidth = 1000;
            const chartHeight = 320;

            const paddingX = 20;
            const paddingY = 30;


            function renderRevenueChart(data) {

                const revenueLine =
                    document.getElementById("revenueLine");

                const revenuePoints =
                    document.getElementById("revenuePoints");

                const revenueLabels =
                    document.getElementById("chartLabels");


                /*
                 * Clear previous chart
                 */

                revenuePoints.innerHTML = "";
                revenueLabels.innerHTML = "";


                /*
                 * No data
                 */

                if (!data || data.length === 0) {

                    revenueLine.setAttribute(
                        "points",
                        ""
                    );

                    revenueLabels.innerHTML = `
                <span class="w-full text-center">
                    No revenue data available
                </span>
            `;

                    return;
                }


                /*
                 * Find maximum revenue
                 */

                const maxRevenue = Math.max(
                    ...data.map(
                        item => Number(item.revenue) || 0
                    ),
                    1
                );


                /*
                 * Create chart points
                 */

                const points = data.map(
                    (item, index) => {

                        let x;


                        /*
                         * If there is only one point,
                         * keep it in the center.
                         */

                        if (data.length === 1) {

                            x =
                                chartWidth / 2;

                        } else {

                            x =
                                paddingX +
                                (
                                    index *
                                    (
                                        chartWidth -
                                        paddingX * 2
                                    )
                                ) /
                                (data.length - 1);

                        }


                        const revenue =
                            Number(item.revenue) || 0;


                        /*
                         * Convert revenue
                         * into SVG Y coordinate.
                         */

                        const y =
                            chartHeight -
                            paddingY -
                            (
                                revenue /
                                maxRevenue
                            ) *
                            (
                                chartHeight -
                                paddingY * 2
                            );


                        return {
                            x,
                            y,
                            revenue,
                            label: item.label
                        };

                    }
                );


                /*
                 * Draw line
                 */

                revenueLine.setAttribute(
                    "points",
                    points
                        .map(
                            point =>
                                `${point.x},${point.y}`
                        )
                        .join(" ")
                );


                /*
                 * Draw points
                 */

                points.forEach(
                    (point) => {

                        const circle =
                            document.createElementNS(
                                "http://www.w3.org/2000/svg",
                                "circle"
                            );


                        circle.setAttribute(
                            "cx",
                            point.x
                        );

                        circle.setAttribute(
                            "cy",
                            point.y
                        );

                        circle.setAttribute(
                            "r",
                            "4"
                        );

                        circle.setAttribute(
                            "fill",
                            "#000000"
                        );


                        /*
                         * Hover effect
                         */

                        circle.addEventListener(
                            "mouseenter",
                            () => {

                                circle.setAttribute(
                                    "r",
                                    "6"
                                );

                            }
                        );


                        circle.addEventListener(
                            "mouseleave",
                            () => {

                                circle.setAttribute(
                                    "r",
                                    "4"
                                );

                            }
                        );


                        revenuePoints.appendChild(
                            circle
                        );

                    }
                );


                /*
                 * Bottom labels
                 */

                points.forEach((point, index) => {

                    let showLabel = true;

                    if (data.length === 24) {
                        // Today → every 3 hours
                        showLabel = index % 3 === 0;
                    }
                    else if (data.length === 7) {
                        // Week → every day
                        showLabel = true;
                    }
                    else if (data.length > 20) {
                        // Month → every 5 days approximately
                        showLabel = index % 5 === 0;
                    }
                    else if (data.length === 12) {
                        // Year → every month
                        showLabel = true;
                    }

                    if (!showLabel) {
                        return;
                    }

                    const label = document.createElement("span");

                    label.textContent = point.label;

                    revenueLabels.appendChild(label);
                });

            }


            /*
             * Render chart
             */

            renderRevenueChart(
                revenueData
            );


        </script>



</body>

</html>