<body class="bg-surface text-primary selection:bg-primary selection:text-on-primary font-body-md overflow-x-hidden">
<!-- TopNavBar -->
    <%- include("./partials/userHeader") %>
        <%- include("partials/toast") %>
<!-- Main Content Canvas -->
<main class="w-full">
<div class="grid grid-cols-1 md:grid-cols-12 w-full min-h-screen">
<!-- Left Column (70%) -->
<div class="md:col-span-8 border-r border-primary">
<section class="p-container-padding">
<h1 class="font-display-xl text-display-xl uppercase mb-12">CHECKOUT</h1>
<!-- Section 01 / Delivery -->
<div class="mb-20">
<div class="flex items-baseline gap-4 mb-8">
<span class="font-mono-data text-mono-data">01 /</span>
<h2 class="font-headline-lg text-headline-lg uppercase">Delivery</h2>
</div>
<div class="border border-primary p-8 mb-6 max-w-2xl">
<div class="flex justify-between items-start mb-6">
<span class="font-label-caps text-label-caps px-3 py-1 bg-primary text-on-primary">DEFAULT ADDRESS</span>
</div>
<div class="space-y-1">
<h3 class="font-headline-md text-headline-md uppercase">Julian Rossi</h3>
<p class="font-mono-data text-mono-data text-secondary">+44 7700 900077</p>
<p class="font-body-md text-body-md mt-4 leading-relaxed">
                    Studio 12, Archival House<br/>
                    Great Eastern St, London<br/>
                    EC2A 3NT, United Kingdom
</p>
</div>
</div>
<div class="flex gap-4">
<button class="font-label-caps text-label-caps border border-primary px-6 py-3 hover:bg-primary hover:text-on-primary transition-colors uppercase">Change Address</button>
<button class="font-label-caps text-label-caps border border-primary px-6 py-3 hover:bg-primary hover:text-on-primary transition-colors uppercase">Add New Address</button>
</div>
</div>
<!-- Section 02 / Payment -->
<div class="mb-20">
<div class="flex items-baseline gap-4 mb-8">
<span class="font-mono-data text-mono-data">02 /</span>
<h2 class="font-headline-lg text-headline-lg uppercase">Payment</h2>
</div>
<div class="space-y-0 border-t border-primary max-w-2xl">
<!-- Razorpay Row -->
<label class="flex items-center justify-between p-6 border-b border-l border-r border-primary cursor-pointer hover:bg-surface-container transition-colors group">
<div class="flex items-center gap-6">
<input checked="" class="w-4 h-4 text-primary focus:ring-0" name="payment" type="radio"/>
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-xl">payments</span>
<span class="font-label-caps text-label-caps uppercase">Razorpay</span>
</div>
</div>
<span class="font-mono-data text-mono-data text-secondary">UPI / CARDS / NETBANKING</span>
</label>
<!-- COD Row -->
<label class="flex items-center justify-between p-6 border-b border-l border-r border-primary cursor-pointer hover:bg-surface-container transition-colors group">
<div class="flex items-center gap-6">
<input class="w-4 h-4 text-primary focus:ring-0" name="payment" type="radio"/>
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-xl">local_shipping</span>
<span class="font-label-caps text-label-caps uppercase">Cash On Delivery</span>
</div>
</div>
<span class="font-mono-data text-mono-data text-secondary">ELIGIBLE ORDERS ONLY</span>
</label>
</div>
</div>
<!-- Wallet Section -->
<div class="p-8 border border-primary max-w-2xl bg-surface-container-low">
<div class="flex justify-between items-center">
<div>
<h4 class="font-label-caps text-label-caps mb-1">WALLET BALANCE</h4>
<p class="font-headline-md text-headline-md tracking-tighter">₹450.00</p>
</div>
<label class="flex items-center gap-3 cursor-pointer">
<input class="w-5 h-5 text-primary focus:ring-0" type="checkbox"/>
<span class="font-label-caps text-label-caps">USE WALLET BALANCE</span>
</label>
</div>
</div>
</section>
</div>
<!-- Right Column (30%) -->
<div class="md:col-span-4 bg-surface h-full">
