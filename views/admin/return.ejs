<!DOCTYPE html>
<html class="light" lang="en" style="">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Returns Management | ARCHIVE Admin Panel</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-fixed-dim": "#bec6e0",
                        "on-surface": "#191c1e",
                        "on-secondary-fixed-variant": "#38485d",
                        "tertiary": "#000000",
                        "outline": "#76777d",
                        "on-error-container": "#93000a",
                        "on-tertiary": "#ffffff",
                        "surface-dim": "#d8dadc",
                        "surface-variant": "#e0e3e5",
                        "surface-container-high": "#e6e8ea",
                        "error": "#ba1a1a",
                        "surface-container-low": "#f2f4f6",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "primary-container": "#131b2e",
                        "surface-container-highest": "#e0e3e5",
                        "on-primary-fixed-variant": "#3f465c",
                        "outline-variant": "#c6c6cd",
                        "on-secondary-fixed": "#0b1c30",
                        "on-primary-container": "#7c839b",
                        "surface-tint": "#565e74",
                        "primary": "#000000",
                        "secondary-container": "#d0e1fb",
                        "secondary": "#505f76",
                        "tertiary-container": "#001e2c",
                        "secondary-fixed-dim": "#b7c8e1",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#eceef0",
                        "secondary-fixed": "#d3e4fe",
                        "primary-fixed": "#dae2fd",
                        "surface": "#f7f9fb",
                        "on-surface-variant": "#45464d",
                        "background": "#f7f9fb",
                        "on-tertiary-container": "#008ebf",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#001e2c",
                        "inverse-on-surface": "#eff1f3",
                        "inverse-primary": "#bec6e0",
                        "on-primary-fixed": "#131b2e",
                        "inverse-surface": "#2d3133",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#004c69",
                        "tertiary-fixed": "#c4e7ff",
                        "surface-bright": "#f7f9fb",
                        "on-error": "#ffffff",
                        "on-secondary": "#ffffff",
                        "on-background": "#191c1e",
                        "on-secondary-container": "#54647a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "32px",
                        "lg": "24px",
                        "sm": "8px",
                        "margin": "32px",
                        "base": "4px",
                        "md": "16px",
                        "gutter": "24px",
                        "xs": "4px",
                        "2xl": "48px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["JetBrains Mono"],
                        "headline-md": ["Inter"],
                        "display": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "body-lg": ["Inter"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        .font-mono-data {
            font-family: 'JetBrains Mono', monospace;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-background text-on-surface">

    <%- include("partials/toast") %>

        <!-- Fixed SideNavBar -->
        <%- include("partials/adminSidebar") %>

            <!-- TopAppBar -->
            <%- include("partials/adminNavbar") %>

                <!-- Main Content Area -->
                <main class="ml-64 mt-16 p-lg bg-background min-h-screen overflow-y-auto">
                    <div class="max-w-[1440px] mx-auto flex flex-col gap-lg">
                        <!-- Page Header -->
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-md">
                            <div>
                                <h2 class="font-headline-lg text-headline-lg text-primary">Returns Management</h2>
                                <p class="font-body-md text-on-surface-variant">Review, approve, reject, and process
                                    customer return requests.</p>
                            </div>
                        </div>
                        <!-- Statistics Grid -->
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-md">

                            <!-- Total Returns -->
                            <div class="bg-surface-container-lowest p-md rounded-lg border border-outline-variant">

                                <p class="font-label-md text-on-surface-variant uppercase tracking-wider mb-2">
                                    Total Returns
                                </p>

                                <p class="font-display text-display text-primary">
                                    <%= statistics.totalReturns %>
                                </p>

                            </div>


                            <!-- Pending Review -->
                            <div class="bg-surface-container-lowest p-md rounded-lg border border-outline-variant">

                                <p class="font-label-md text-on-surface-variant uppercase tracking-wider mb-2">
                                    Pending Review
                                </p>

                                <p class="font-display text-display text-tertiary-container text-[#008ebf]">
                                    <%= statistics.pendingReturns %>
                                </p>

                            </div>


                            <!-- Approved -->
                            <div class="bg-surface-container-lowest p-md rounded-lg border border-outline-variant">

                                <p class="font-label-md text-on-surface-variant uppercase tracking-wider mb-2">
                                    Approved
                                </p>

                                <p class="font-display text-display text-primary">
                                    <%= statistics.approvedReturns %>
                                </p>

                            </div>


                            <!-- Rejected -->
                            <div class="bg-surface-container-lowest p-md rounded-lg border border-outline-variant">

                                <p class="font-label-md text-on-surface-variant uppercase tracking-wider mb-2">
                                    Rejected
                                </p>

                                <p class="font-display text-display text-error">
                                    <%= statistics.rejectedReturns %>
                                </p>

                            </div>

                        </div>
                        <!-- Filters & Main Table Section -->
                        <!-- Filters -->
                        <div class="mb-4 rounded-lg border border-neutral-200 bg-white">

                            <form action="/admin/return" method="GET">

                                <div class="flex h-16 items-center px-6">

                                    <!-- Search -->
                                    <div class="relative flex flex-1 items-center gap-3">

                                        <span class="material-symbols-outlined text-[20px] text-neutral-400">
                                            search
                                        </span>

                                        <input id="returnSearch" type="text" name="search"
                                            value="<%= typeof search !== 'undefined' ? search : '' %>"
                                            placeholder="Search orders, customers, products..."
                                            class="w-full border-none bg-transparent p-0 pr-8 text-sm text-black placeholder:text-neutral-400 focus:outline-none focus:ring-0">

                                        <!-- Clear Search -->
                                        <button type="button" id="clearReturnSearch"
                                            class="absolute right-0 hidden p-1 text-neutral-400 transition hover:text-black">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M6 6l12 12M18 6L6 18" />
                                            </svg>
                                        </button>

                                    </div>


                                    <!-- Divider -->
                                    <div class="mx-6 h-6 w-px bg-neutral-200"></div>


                                    <!-- Return Status -->
                                    <select name="status" onchange="this.form.submit()"
                                        class="border-none bg-transparent text-xs font-semibold uppercase tracking-[0.25em] text-neutral-700 focus:outline-none focus:ring-0">

                                        <option value="" <%=typeof status==="undefined" || status==="" ? "selected" : ""
                                            %>
                                            >
                                            All Status
                                        </option>

                                        <option value="RETURN_REQUESTED" <%=typeof status !=="undefined" &&
                                            status==="RETURN_REQUESTED" ? "selected" : "" %>
                                            >
                                            Pending Review
                                        </option>

                                        <option value="RETURNED" <%=typeof status !=="undefined" && status==="RETURNED"
                                            ? "selected" : "" %>
                                            >
                                            Approved
                                        </option>

                                        <option value="RETURN_REJECTED" <%=typeof status !=="undefined" &&
                                            status==="RETURN_REJECTED" ? "selected" : "" %>
                                            >
                                            Rejected
                                        </option>

                                    </select>


                                    <!-- Divider -->
                                    <div class="mx-6 h-6 w-px bg-neutral-200"></div>


                                    <!-- Sort -->
                                    <select name="sort" onchange="this.form.submit()"
                                        class="border-none bg-transparent text-xs font-semibold uppercase tracking-[0.25em] text-neutral-700 focus:outline-none focus:ring-0">

                                        <option value="newest" <%=typeof sort==="undefined" || sort==="newest"
                                            ? "selected" : "" %>
                                            >
                                            Newest
                                        </option>

                                        <option value="oldest" <%=typeof sort !=="undefined" && sort==="oldest"
                                            ? "selected" : "" %>
                                            >
                                            Oldest
                                        </option>

                                    </select>


                                    <!-- Reset -->
                                    <a href="/admin/return"
                                        class="ml-8 whitespace-nowrap text-xs font-medium uppercase tracking-[0.25em] text-neutral-400 transition hover:text-black">
                                        Reset Filters
                                    </a>

                                </div>

                            </form>

                        </div>
                        <div class="overflow-hidden rounded-lg border border-neutral-200 bg-white">

                            <div class="overflow-x-auto w-full">
                                <table class="w-full text-left border-collapse">
                                    <thead class="bg-surface-container-low border-b border-outline-variant">
                                        <tr class="text-left">
                                            <th
                                                class="w-[12%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
                                                Order ID</th>
                                            <th
                                                class="w-[18%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
                                                Customer</th>
                                            <th
                                                class="w-[26%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
                                                Product</th>
                                            <th
                                                class="w-[16%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
                                                Reason</th>
                                            <th
                                                class="w-[12%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-right">
                                                Status</th>
                                            <th
                                                class="w-[16%] px-md py-3 font-label-md text-label-md text-on-surface-variant uppercase tracking-wider text-right">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-outline-variant/30">

                                        <% if (returnRequests.length===0) { %>

                                            <tr>
                                                <td colspan="6"
                                                    class="px-md py-12 text-center text-sm text-on-surface-variant">

                                                    No return requests found.

                                                </td>
                                            </tr>

                                            <% } else { %>

                                                <% returnRequests.forEach((request)=> { %>

                                                    <tr class="hover:bg-surface-container-high transition-colors">

                                                        <!-- Order ID -->
                                                        <td
                                                            class="px-md py-4 font-mono-data text-body-sm text-on-surface-variant">

                                                            <%= request.orderId %>

                                                        </td>


                                                        <!-- Customer -->
                                                        <td class="px-md py-4 font-body-sm font-bold text-primary">

                                                            <%= request.customerName %>

                                                        </td>


                                                        <!-- Product -->
                                                        <td class="px-md py-4 font-body-sm text-on-surface">

                                                            <%= request.productName %>

                                                        </td>


                                                        <!-- Reason -->
                                                        <td class="px-md py-4 font-body-sm text-on-surface-variant">

                                                            <%= request.reason %>

                                                        </td>


                                                        <!-- Status -->
                                                        <td class="px-md py-4 text-right">

                                                            <% if (request.status==="RETURN_REQUESTED" ) { %>

                                                                <span
                                                                    class="inline-block px-2 py-1 rounded bg-tertiary-fixed text-on-tertiary-fixed-variant text-[10px] font-bold uppercase tracking-wider">
                                                                    Pending Review
                                                                </span>

                                                                <% } else if (request.status==="RETURNED" ) { %>

                                                                    <span
                                                                        class="inline-block px-2 py-1 rounded bg-green-100 text-green-700 text-[10px] font-bold uppercase tracking-wider">
                                                                        Approved
                                                                    </span>

                                                                    <% } else if (request.status==="RETURN_REJECTED" ) {
                                                                        %>

                                                                        <span
                                                                            class="inline-block px-2 py-1 rounded bg-error-container text-error text-[10px] font-bold uppercase tracking-wider">
                                                                            Rejected
                                                                        </span>

                                                                        <% } %>

                                                        </td>


                                                        <!-- Actions -->
                                                        <td class="px-md py-4 text-right">

                                                            <div class="flex items-center justify-end gap-1">

                                                                <!-- Approve -->
                                                                <button type="button" title="Approve"
                                                                    data-action="approve"
                                                                    data-order-id="<%= request.orderId %>"
                                                                    data-item-id="<%= request.itemId %>"
                                                                    data-customer="<%= request.customerName %>"
                                                                    data-product="<%= request.productName %>"
                                                                    class="p-1 text-primary hover:bg-surface-container rounded transition-colors">
                                                                    <span class="material-symbols-outlined text-[18px]">
                                                                        check_circle
                                                                    </span>
                                                                </button>


                                                                <!-- Reject -->
                                                                <button type="button" title="Reject"
                                                                    data-action="reject"
                                                                    data-order-id="<%= request.orderId %>"
                                                                    data-item-id="<%= request.itemId %>"
                                                                    data-customer="<%= request.customerName %>"
                                                                    data-product="<%= request.productName %>"
                                                                    class="p-1 text-error hover:bg-error-container rounded transition-colors">
                                                                    <span class="material-symbols-outlined text-[18px]">
                                                                        cancel
                                                                    </span>
                                                                </button>


                                                                <!-- View Details -->
                                                                <a href="/admin/orders/<%= encodeURIComponent(request.orderId) %>"
                                                                    title="View Details"
                                                                    class="p-1 text-on-surface-variant hover:bg-surface-container rounded transition-colors">
                                                                    <span class="material-symbols-outlined text-[18px]">
                                                                        visibility
                                                                    </span>
                                                                </a>

                                                            </div>

                                                        </td>

                                                    </tr>

                                                    <% }) %>

                                                        <% } %>

                                    </tbody>
                                </table>
                            </div>
                            <div
                                class="p-md bg-surface-container-low border-t border-outline-variant flex justify-between items-center">

                                <!-- Results Count -->
                                <% const startItem=totalRequests===0 ? 0 : (currentPage - 1) * limit + 1; const
                                    endItem=Math.min(currentPage * limit, totalRequests); %>

                                    <p class="text-body-sm text-on-surface-variant">
                                        Showing <%= startItem %>-<%= endItem %> of <%= totalRequests %> returns
                                    </p>


                                    <!-- Pagination Controls -->
                                    <div class="flex gap-2">

                                        <!-- Previous -->
                                        <% if (currentPage> 1) { %>

                                            <a href="/admin/return?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>&sort=<%= encodeURIComponent(sort) %>&page=<%= currentPage - 1 %>"
                                                class="p-1 border border-outline-variant rounded hover:bg-white transition-colors">
                                                <span class="material-symbols-outlined">
                                                    chevron_left
                                                </span>
                                            </a>

                                            <% } else { %>

                                                <button
                                                    class="p-1 border border-outline-variant rounded opacity-30 cursor-not-allowed"
                                                    disabled>
                                                    <span class="material-symbols-outlined">
                                                        chevron_left
                                                    </span>
                                                </button>

                                                <% } %>


                                                    <!-- Next -->
                                                    <% if (currentPage < totalPages) { %>

                                                        <a href="/admin/return?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>&sort=<%= encodeURIComponent(sort) %>&page=<%= currentPage + 1 %>"
                                                            class="p-1 border border-outline-variant rounded hover:bg-white transition-colors">
                                                            <span class="material-symbols-outlined">
                                                                chevron_right
                                                            </span>
                                                        </a>

                                                        <% } else { %>

                                                            <button
                                                                class="p-1 border border-outline-variant rounded opacity-30 cursor-not-allowed"
                                                                disabled>
                                                                <span class="material-symbols-outlined">
                                                                    chevron_right
                                                                </span>
                                                            </button>

                                                            <% } %>

                                    </div>

                            </div>

                        </div>
                </main>


                <!-- Return Confirmation Modal -->
                <div id="returnConfirmationModal"
                    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">

                    <div class="w-full max-w-md rounded-lg bg-white shadow-2xl">

                        <!-- Modal Header -->
                        <div class="border-b border-neutral-200 px-6 py-5">

                            <div class="flex items-center justify-between">

                                <h3 id="returnModalTitle" class="font-headline-lg text-lg font-semibold text-black">
                                    Confirm Action
                                </h3>

                                <button type="button" id="closeReturnModal"
                                    class="text-neutral-400 transition hover:text-black">
                                    <span class="material-symbols-outlined">
                                        close
                                    </span>
                                </button>

                            </div>

                        </div>


                        <!-- Modal Body -->
                        <div class="px-6 py-6">

                            <div class="mb-5 flex items-center gap-3">

                                <div id="returnModalIcon"
                                    class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-100">
                                    <span id="returnModalIconSymbol" class="material-symbols-outlined">
                                        help
                                    </span>
                                </div>

                                <div>

                                    <p id="returnModalMessage" class="text-sm font-semibold text-black">
                                        Are you sure you want to continue?
                                    </p>

                                    <p class="mt-1 text-xs text-neutral-500">
                                        This action will update the return request status.
                                    </p>

                                </div>

                            </div>


                            <!-- Return Details -->
                            <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4">

                                <div class="grid grid-cols-2 gap-4">

                                    <div>
                                        <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">
                                            Order ID
                                        </p>

                                        <p id="returnModalOrderId" class="mt-1 font-mono text-sm text-black">
                                            -
                                        </p>
                                    </div>


                                    <div>
                                        <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">
                                            Customer
                                        </p>

                                        <p id="returnModalCustomer" class="mt-1 text-sm text-black">
                                            -
                                        </p>
                                    </div>


                                    <div class="col-span-2">

                                        <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">
                                            Product
                                        </p>

                                        <p id="returnModalProduct" class="mt-1 text-sm text-black">
                                            -
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Modal Footer -->
                        <div class="flex justify-end gap-3 border-t border-neutral-200 px-6 py-4">

                            <button type="button" id="cancelReturnModal"
                                class="rounded border border-neutral-300 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-neutral-600 transition hover:bg-neutral-100">
                                Cancel
                            </button>


                            <form id="returnConfirmationForm" method="POST">

                                <button type="submit" id="confirmReturnAction"
                                    class="rounded bg-black px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-neutral-800">
                                    Confirm
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        // Hover effect on table rows
                        const rows = document.querySelectorAll('tbody tr');
                        rows.forEach(row => {
                            row.addEventListener('click', () => {
                                // Reset all
                                rows.forEach(r => {
                                    r.classList.remove('bg-secondary-container/20', 'border-l-2', 'border-primary');
                                });
                                // Set active
                                row.classList.add('bg-secondary-container/20', 'border-l-2', 'border-primary');
                            });
                        });
                    });

                    const returnSearch = document.getElementById("returnSearch");
                    const clearReturnSearch = document.getElementById("clearReturnSearch");

                    // Show / hide clear button
                    const updateClearButton = () => {

                        if (returnSearch.value.trim()) {
                            clearReturnSearch.classList.remove("hidden");
                        } else {
                            clearReturnSearch.classList.add("hidden");
                        }

                    };


                    // Update clear button while typing
                    returnSearch.addEventListener("input", updateClearButton);


                    // Clear search
                    clearReturnSearch.addEventListener("click", () => {

                        returnSearch.value = "";

                        updateClearButton();

                        returnSearch.focus();

                    });


                    // Set correct state when page loads
                    updateClearButton();

                    const returnModal = document.getElementById("returnConfirmationModal");
                    const returnConfirmationForm = document.getElementById(
                        "returnConfirmationForm",
                    );

                    const returnModalTitle = document.getElementById("returnModalTitle");
                    const returnModalMessage = document.getElementById("returnModalMessage");
                    const returnModalOrderId = document.getElementById("returnModalOrderId");
                    const returnModalCustomer = document.getElementById("returnModalCustomer");
                    const returnModalProduct = document.getElementById("returnModalProduct");
                    const returnModalIcon = document.getElementById("returnModalIcon");
                    const returnModalIconSymbol = document.getElementById(
                        "returnModalIconSymbol",
                    );
                    const confirmReturnAction = document.getElementById("confirmReturnAction");

                    const closeReturnModal = () => {
                        returnModal.classList.add("hidden");
                        returnModal.classList.remove("flex");
                    };

                    const openReturnModal = (button) => {
                        const action = button.dataset.action;
                        const orderId = button.dataset.orderId;
                        const itemId = button.dataset.itemId;
                        const customer = button.dataset.customer;
                        const product = button.dataset.product;

                        returnModalOrderId.textContent = orderId;
                        returnModalCustomer.textContent = customer;
                        returnModalProduct.textContent = product;

                        if (action === "approve") {
                            returnModalTitle.textContent = "Approve Return";
                            returnModalMessage.textContent =
                                "Are you sure you want to approve this return request?";

                            returnModalIcon.className =
                                "flex h-10 w-10 items-center justify-center rounded-full bg-green-100";

                            returnModalIconSymbol.textContent = "check_circle";
                            returnModalIconSymbol.className =
                                "material-symbols-outlined text-green-600";

                            confirmReturnAction.textContent = "Approve";
                            confirmReturnAction.className =
                                "rounded bg-black px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-neutral-800";

                            returnConfirmationForm.action =
                                `/admin/return/${encodeURIComponent(orderId)}/${encodeURIComponent(itemId)}/approve`;
                        }

                        if (action === "reject") {
                            returnModalTitle.textContent = "Reject Return";
                            returnModalMessage.textContent =
                                "Are you sure you want to reject this return request?";

                            returnModalIcon.className =
                                "flex h-10 w-10 items-center justify-center rounded-full bg-red-100";

                            returnModalIconSymbol.textContent = "cancel";
                            returnModalIconSymbol.className =
                                "material-symbols-outlined text-red-600";

                            confirmReturnAction.textContent = "Reject";
                            confirmReturnAction.className =
                                "rounded bg-error px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white transition hover:opacity-90";

                            returnConfirmationForm.action =
                                `/admin/return/${encodeURIComponent(orderId)}/${encodeURIComponent(itemId)}/reject`;
                        }

                        returnModal.classList.remove("hidden");
                        returnModal.classList.add("flex");
                    };

                    document
                        .querySelectorAll("[data-action='approve'], [data-action='reject']")
                        .forEach((button) => {
                            button.addEventListener("click", () => {
                                openReturnModal(button);
                            });
                        });

                    document
                        .getElementById("closeReturnModal")
                        .addEventListener("click", closeReturnModal);

                    document
                        .getElementById("cancelReturnModal")
                        .addEventListener("click", closeReturnModal);

                    returnModal.addEventListener("click", (event) => {
                        if (event.target === returnModal) {
                            closeReturnModal();
                        }
                    });
                </script>
</body>

</html>