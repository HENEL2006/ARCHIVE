<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&amp;family=Syne:wght@700;800&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed-dim": "#c6c6c6",
                        "tertiary": "#000000",
                        "on-surface-variant": "#4c4546",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#dfe0e0",
                        "secondary-fixed-dim": "#c6c6c7",
                        "outline-variant": "#cfc4c5",
                        "background": "#fcf9f8",
                        "on-error": "#ffffff",
                        "inverse-primary": "#c6c6c6",
                        "primary-fixed-dim": "#c6c6c6",
                        "on-surface": "#1c1b1b",
                        "surface-container-high": "#ebe7e7",
                        "primary-fixed": "#e2e2e2",
                        "on-secondary-fixed-variant": "#454747",
                        "on-primary-fixed": "#1b1b1b",
                        "surface-container": "#f0edec",
                        "inverse-on-surface": "#f3f0ef",
                        "secondary-fixed": "#e2e2e2",
                        "secondary": "#5d5f5f",
                        "on-secondary-fixed": "#1a1c1c",
                        "surface-container-low": "#f6f3f2",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed-variant": "#474747",
                        "on-tertiary-fixed": "#1b1b1b",
                        "surface": "#fcf9f8",
                        "surface-container-highest": "#e5e2e1",
                        "tertiary-fixed": "#e2e2e2",
                        "on-secondary-container": "#616363",
                        "on-tertiary-container": "#848484",
                        "error": "#ba1a1a",
                        "on-primary-container": "#848484",
                        "inverse-surface": "#313030",
                        "surface-tint": "#5e5e5e",
                        "on-error-container": "#93000a",
                        "primary-container": "#1b1b1b",
                        "tertiary-container": "#1b1b1b",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#474747",
                        "outline": "#7e7576",
                        "surface-variant": "#e5e2e1",
                        "primary": "#000000",
                        "surface-dim": "#dcd9d9",
                        "error-container": "#ffdad6",
                        "surface-container-lowest": "#ffffff",
                        "accent-success": "#22CD5B",
                        "on-background": "#1c1b1b",
                        "surface-bright": "#fcf9f8"
                    },
                    "borderRadius": {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "section-gap": "128px",
                        "grid-gutter": "0px",
                        "unit": "8px",
                        "container-padding": "64px",
                        "mobile-margin": "20px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .grid-line-v {
            border-right: 1px solid #000000;
        }

        .grid-line-h {
            border-bottom: 1px solid #000000;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-background text-on-background font-body-md selection:bg-primary selection:text-on-primary">
    <!-- TopNavBar -->
    <%- include("partials/userHeader") %>
        <%- include("partials/toast") %>
            <main class="pt-16 min-h-screen">
                <!-- Hero Section -->
                <header class="px-container-padding pt-24 pb-12 border-b border-primary">
                    <h1 class="font-display-xl text-display-xl mb-4">MY ORDERS</h1>
                    <p>Total orders: <%= totalOrders %></p>
                    <p class="font-body-lg text-body-lg text-secondary max-w-xl">Track and manage your archive
                        acquisitions.</p>
                </header>
                <section class="px-container-padding py-8 border-b border-primary bg-background">
                    <div class="max-w-7xl mx-auto relative">

                        <div class="flex items-stretch border border-primary bg-background">

                            <!-- Search -->
                            <form action="/orders" method="GET" id="searchForm" class="flex-1">
                                <div class="flex items-center gap-4 px-4 py-3 h-full">
                                    <span class="material-symbols-outlined text-primary">
                                        search
                                    </span>

                                    <input id="orderSearch" name="search" value="<%= search || '' %>"
                                        class="w-full bg-transparent border-none p-0 focus:ring-0 font-body-md text-primary placeholder:text-secondary placeholder:opacity-50"
                                        placeholder="Search by order number, jersey name, or club..." type="text">
                                </div>
                            </form>

                            <!-- Filter Button -->
                            <button id="filterButton" type="button"
                                class="flex items-center gap-2 px-5 py-4 border-l border-primary font-label-caps text-label-caps hover:bg-primary hover:text-white transition-none">
                                FILTER

                                <span id="filterIcon" class="material-symbols-outlined text-[18px]">
                                    expand_more
                                </span>
                            </button>

                        </div>

                        <!-- Filter Dropdown -->
                        <div id="filterDropdown"
                            class="hidden absolute right-0 top-full mt-2 w-56 border border-primary bg-background z-50">

                            <button data-filter="ALL"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                ALL ORDERS
                            </button>

                            <button data-filter="PLACED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                PLACED
                            </button>

                            <button data-filter="CONFIRMED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                CONFIRMED
                            </button>

                            <button data-filter="SHIPPED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                SHIPPED
                            </button>

                            <button data-filter="DELIVERED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                DELIVERED
                            </button>

                            <button data-filter="CANCELLED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps border-b border-primary hover:bg-surface-container">
                                CANCELLED
                            </button>

                            <button data-filter="RETURNED"
                                class="filter-option w-full text-left px-4 py-4 font-label-caps text-label-caps hover:bg-surface-container">
                                RETURNED
                            </button>

                        </div>

                    </div>
                </section>
                <!-- Order List -->
                <section class="px-container-padding py-12">
                    <div class="max-w-7xl mx-auto flex flex-col gap-4">

                        <% orders.forEach(order=> { %>

                            <% const firstItem=order.items[0]; const remainingItems=order.items.length - 1; %>

                                <div
                                    class="border border-primary bg-white flex items-center p-4 gap-6 hover:bg-surface-container-low transition-all duration-75">

                                    <!-- PRODUCT IMAGE -->
                                    <div class="w-20 h-20 border border-primary flex-shrink-0 overflow-hidden">

                                        <img src="<%= firstItem.image %>" alt="<%= firstItem.name %>"
                                            class="w-full h-full object-cover">

                                    </div>


                                    <!-- ORDER INFORMATION -->
                                    <div class="flex-grow grid grid-cols-6 items-center gap-4">

                                        <!-- PRODUCT -->
                                        <div class="flex flex-col min-w-0">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Product
                                            </span>

                                            <span class="font-mono-data text-mono-data font-bold truncate">

                                                <%= firstItem.name %>

                                                    <% if (remainingItems> 0) { %>
                                                        <span class="text-secondary font-normal">
                                                            +<%= remainingItems %> more
                                                        </span>
                                                        <% } %>

                                            </span>

                                        </div>


                                        <!-- ORDER NUMBER -->
                                        <div class="flex flex-col">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Ref
                                            </span>

                                            <span class="font-mono-data text-mono-data">
                                                #<%= order.orderId %>
                                            </span>

                                        </div>


                                        <!-- DATE -->
                                        <div class="flex flex-col">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Date
                                            </span>

                                            <span class="font-mono-data text-mono-data">

                                                <%= new Date(order.createdAt).toLocaleDateString("en-GB") %>

                                            </span>

                                        </div>


                                        <!-- TOTAL -->
                                        <div class="flex flex-col">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Total
                                            </span>

                                            <span class="font-mono-data text-mono-data font-bold">

                                                ₹<%= Number(order.total).toFixed(2) %>

                                            </span>

                                        </div>


                                        <!-- PAYMENT -->
                                        <div class="flex flex-col">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Payment
                                            </span>

                                            <span class="font-mono-data text-mono-data">

                                                <%= order.paymentStatus %>

                                            </span>

                                        </div>


                                        <!-- STATUS -->
                                        <div class="flex flex-col">

                                            <span
                                                class="font-mono-data text-[10px] text-secondary uppercase opacity-50">
                                                Status
                                            </span>

                                            <span class="font-mono-data text-mono-data font-bold">

                                                <%= order.orderStatus %>

                                            </span>

                                        </div>

                                    </div>


                                    <!-- ACTIONS -->
                                    <div class="flex items-center gap-2 flex-shrink-0">

                                        <!-- DETAILS -->
                                        <a href="/order/<%= order.orderId %>"
                                            class="border border-black px-5 py-3 text-xs tracking-wider hover:bg-black hover:text-white transition">

                                            DETAILS

                                        </a>


                                        <% if (order.orderStatus==="DELIVERED" ) { %>

                                            <!-- RETURN -->
                                            <button type="button"
                                                onclick="openReturnModal('<%= order.orderId %>', '<%= order.items[0]._id %>')"
                                                class="border border-primary bg-transparent text-primary px-5 py-2.5 text-sm font-medium
           hover:bg-primary hover:text-white transition-colors duration-200">
                                                RETURN
                                            </button>


                                            <% } else if ( order.orderStatus==="PLACED" ||
                                                order.orderStatus==="CONFIRMED" ) { %>

                                                <!-- CANCEL -->
                                                <button type="button"
                                                    class="cancel-order-button border border-black px-5 py-3 text-xs tracking-wider hover:bg-black hover:text-white transition"
                                                    data-order-id="<%= order.orderId %>">

                                                    CANCEL

                                                </button>


                                                <% } else if (order.orderStatus==="RETURNED" ) { %>

                                                    <button type="button" disabled
                                                        class="border border-black px-5 py-3 text-xs tracking-wider opacity-60 cursor-default">

                                                        COMPLETED

                                                    </button>


                                                    <% } else if (order.orderStatus==="CANCELLED" ) { %>

                                                        <button type="button" disabled
                                                            class="border border-black px-5 py-3 text-xs tracking-wider opacity-60 cursor-default">

                                                            CANCELLED

                                                        </button>

                                                        <% } %>

                                    </div>

                                </div>

                                <% }) %>

                    </div>
                </section>
                <section class="px-container-padding py-12 border-t border-primary">
                    <div class="max-w-7xl mx-auto flex justify-between items-center">

                        <!-- PREVIOUS -->
                        <div>
                            <% if (currentPage> 1) { %>

                                <a href="/orders?page=<%= page %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(currentStatus || '') %>"
                                    class="font-label-caps text-label-caps flex items-center gap-2 text-secondary hover:text-primary transition-none">

                                    <span class="material-symbols-outlined text-[16px]">
                                        arrow_back
                                    </span>

                                    PREVIOUS

                                </a>

                                <% } else { %>

                                    <span
                                        class="font-label-caps text-label-caps flex items-center gap-2 text-secondary opacity-30 cursor-not-allowed">

                                        <span class="material-symbols-outlined text-[16px]">
                                            arrow_back
                                        </span>

                                        PREVIOUS

                                    </span>

                                    <% } %>
                        </div>


                        <!-- PAGE NUMBERS -->
                        <div class="flex gap-6">

                            <% for (let page=1; page <=totalPages; page++) { %>

                                <% if (page===currentPage) { %>

                                    <span
                                        class="font-label-caps text-label-caps text-primary border-b border-primary pb-1">

                                        <%= page %>

                                    </span>

                                    <% } else { %>

                                        <a href="/orders?page=<%= page %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(currentStatus || '') %>"
                                            class="font-label-caps text-label-caps text-secondary hover:text-primary transition-none">

                                            <%= page %>

                                        </a>

                                        <% } %>

                                            <% } %>

                        </div>


                        <!-- NEXT -->
                        <div>
                            <% if (currentPage> 1) { %>

                                <a href="/orders?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(currentStatus || '') %>"
                                    class="font-label-caps text-label-caps text-secondary hover:text-primary transition-none">
                                    PREVIOUS
                                </a>

                                <% } %>


                                    <span class="font-label-caps text-label-caps text-primary">
                                        <%= currentPage %>
                                    </span>


                                    <% if (currentPage < totalPages) { %>

                                        <a href="/orders?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(currentStatus || '') %>"
                                            class="font-label-caps text-label-caps flex items-center gap-2 text-secondary hover:text-primary transition-none">
                                            NEXT
                                        </a>

                                        <% } %>
                        </div>

                    </div>
                </section>
            </main>

            <!-- Cancel Order Modal -->
            <div id="cancelOrderModal" class="fixed inset-0 z-[100] hidden items-center justify-center">
                <!-- Backdrop -->
                <div id="cancelModalBackdrop" class="absolute inset-0 bg-black/40">
                </div>

                <!-- Modal -->
                <div class="relative w-full max-w-lg mx-4 bg-background border border-primary">

                    <!-- Header -->
                    <div class="p-8 border-b border-primary">

                        <div class="flex justify-between items-start">

                            <div>
                                <span class="font-label-caps text-label-caps text-secondary block mb-2">
                                    ORDER CANCELLATION
                                </span>

                                <h2 class="font-headline-md text-headline-md uppercase">
                                    CANCEL ORDER?
                                </h2>
                            </div>

                            <button type="button" id="closeCancelModal"
                                class="text-secondary hover:text-primary transition-none">

                                <span class="material-symbols-outlined">
                                    close
                                </span>

                            </button>

                        </div>

                    </div>


                    <!-- Content -->
                    <div class="p-8">

                        <p class="font-body-md text-primary mb-6">
                            Please tell us why you want to cancel this order.
                        </p>

                        <label for="cancellationReason" class="font-label-caps text-[10px] text-secondary block mb-2">
                            CANCELLATION REASON
                        </label>

                        <textarea id="cancellationReason" rows="4" placeholder="ENTER YOUR REASON..."
                            class="w-full bg-background border border-primary p-4 resize-none focus:outline-none focus:ring-0 font-body-md text-primary placeholder:text-secondary placeholder:opacity-50"></textarea>

                        <p id="cancelReasonError" class="hidden mt-2 font-label-caps text-[10px] text-red-500">
                            PLEASE ENTER A REASON
                        </p>

                    </div>


                    <!-- Actions -->
                    <div class="flex border-t border-primary">

                        <button type="button" id="keepOrderButton"
                            class="flex-1 py-5 border-r border-primary font-label-caps text-label-caps text-secondary hover:bg-surface-container hover:text-primary transition-none">
                            KEEP ORDER
                        </button>

                        <button type="button" id="confirmCancelButton"
                            class="flex-1 py-5 font-label-caps text-label-caps bg-primary text-on-primary hover:bg-secondary transition-none">
                            CANCEL ORDER
                        </button>

                    </div>

                </div>

            </div>

            <div id="returnModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">

                <div class="w-full max-w-md bg-white border border-black p-6">

                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold">
                            RETURN PRODUCT
                        </h2>

                        <button type="button" onclick="closeReturnModal()" class="text-2xl">
                            ×
                        </button>
                    </div>

                    <form id="returnForm" method="POST">

                        <label class="block mb-2 font-medium">
                            Reason for return
                        </label>

                        <textarea id="returnReason" name="returnReason" required
                            placeholder="Enter your reason for returning this product..."
                            class="w-full border border-outline-variant rounded p-3">
</textarea>

                        <div class="flex justify-end gap-3 mt-6">

                            <button type="button" onclick="closeReturnModal()" class="border border-black px-5 py-3">
                                CANCEL
                            </button>

                            <button type="submit" class="bg-black text-white px-5 py-3">
                                SUBMIT REQUEST
                            </button>

                        </div>

                    </form>
                </div>
            </div>

            <!-- Footer -->
            <%- include("partials/userFooter") %>
                <script>


                    // ==========================================
                    // return modal
                    // ==========================================

                    function openReturnModal(orderId, itemId) {
                        const modal = document.getElementById("returnModal");
                        const form = document.getElementById("returnForm");
                        const reason = document.getElementById("returnReason");

                        form.action = `/orders/${orderId}/items/${itemId}/return`;
                        reason.value = "";

                        modal.classList.remove("hidden");
                        modal.classList.add("flex");

                        reason.focus();
                    }

                    function closeReturnModal() {
                        const modal = document.getElementById("returnModal");

                        modal.classList.add("hidden");
                        modal.classList.remove("flex");
                    }

                    // ==========================================
                    // FILTER DROPDOWN
                    // ==========================================

                    const filterButton =
                        document.getElementById("filterButton");

                    const filterDropdown =
                        document.getElementById("filterDropdown");

                    const filterIcon =
                        document.getElementById("filterIcon");

                    const filterOptions =
                        document.querySelectorAll(".filter-option");


                    // ==========================================
                    // SAFETY CHECK
                    // ==========================================

                    if (filterButton && filterDropdown) {


                        // ==========================================
                        // OPEN / CLOSE DROPDOWN
                        // ==========================================

                        filterButton.addEventListener("click", (event) => {

                            event.stopPropagation();

                            filterDropdown.classList.toggle("hidden");

                            if (filterDropdown.classList.contains("hidden")) {

                                filterIcon.textContent = "expand_more";

                            } else {

                                filterIcon.textContent = "expand_less";

                            }

                        });


                        // ==========================================
                        // SELECT FILTER
                        // ==========================================

                        filterOptions.forEach((option) => {

                            option.addEventListener("click", () => {

                                const selectedFilter =
                                    option.dataset.filter;

                                console.log(
                                    "Selected filter:",
                                    selectedFilter
                                );


                                // ==========================================
                                // GET CURRENT SEARCH VALUE
                                // ==========================================

                                const searchInput =
                                    document.getElementById("orderSearch");

                                const search =
                                    searchInput
                                        ? searchInput.value.trim()
                                        : "";


                                // ==========================================
                                // CLOSE DROPDOWN
                                // ==========================================

                                filterDropdown.classList.add("hidden");

                                filterIcon.textContent = "expand_more";


                                // ==========================================
                                // BUILD QUERY PARAMETERS
                                // ==========================================

                                const params =
                                    new URLSearchParams();


                                // Add status
                                if (selectedFilter !== "ALL") {

                                    params.set(
                                        "status",
                                        selectedFilter
                                    );

                                }


                                // Keep search while filtering
                                if (search) {

                                    params.set(
                                        "search",
                                        search
                                    );

                                }


                                // ==========================================
                                // UPDATE FILTER BUTTON
                                // ==========================================

                                if (selectedFilter === "ALL") {

                                    filterButton.firstChild.textContent =
                                        "FILTER ";

                                } else {

                                    filterButton.firstChild.textContent =
                                        selectedFilter + " ";

                                }


                                // ==========================================
                                // REDIRECT
                                // ==========================================

                                const queryString =
                                    params.toString();


                                if (queryString) {

                                    window.location.href =
                                        `/orders?${queryString}`;

                                } else {

                                    window.location.href =
                                        "/orders";

                                }

                            });

                        });


                        // ==========================================
                        // CLOSE WHEN CLICKING OUTSIDE
                        // ==========================================

                        document.addEventListener("click", (event) => {

                            if (
                                !filterButton.contains(event.target) &&
                                !filterDropdown.contains(event.target)
                            ) {

                                filterDropdown.classList.add("hidden");

                                filterIcon.textContent =
                                    "expand_more";

                            }

                        });

                    }

                    // ==========================================
                    // CANCEL ORDER
                    // ==========================================

                    const cancelOrderButtons =
                        document.querySelectorAll(".cancel-order-button");

                    const cancelOrderModal =
                        document.getElementById("cancelOrderModal");

                    const cancelModalBackdrop =
                        document.getElementById("cancelModalBackdrop");

                    const closeCancelModal =
                        document.getElementById("closeCancelModal");

                    const keepOrderButton =
                        document.getElementById("keepOrderButton");

                    const confirmCancelButton =
                        document.getElementById("confirmCancelButton");

                    const cancellationReason =
                        document.getElementById("cancellationReason");

                    const cancelReasonError =
                        document.getElementById("cancelReasonError");

                    let selectedOrderId = null;


                    // ==========================================
                    // OPEN CANCEL MODAL
                    // ==========================================

                    cancelOrderButtons.forEach((button) => {

                        button.addEventListener("click", () => {

                            selectedOrderId = button.dataset.orderId;

                            cancellationReason.value = "";

                            cancelReasonError.classList.add("hidden");

                            cancelOrderModal.classList.remove("hidden");
                            cancelOrderModal.classList.add("flex");

                        });

                    });


                    // ==========================================
                    // CLOSE MODAL
                    // ==========================================

                    function closeCancelModalFunction() {

                        cancelOrderModal.classList.add("hidden");
                        cancelOrderModal.classList.remove("flex");

                        selectedOrderId = null;

                        cancellationReason.value = "";

                        cancelReasonError.classList.add("hidden");
                    }


                    // ==========================================
                    // CLOSE BUTTON
                    // ==========================================

                    closeCancelModal.addEventListener(
                        "click",
                        closeCancelModalFunction
                    );


                    // ==========================================
                    // KEEP ORDER
                    // ==========================================

                    keepOrderButton.addEventListener(
                        "click",
                        closeCancelModalFunction
                    );


                    // ==========================================
                    // CLICK BACKDROP
                    // ==========================================

                    cancelModalBackdrop.addEventListener(
                        "click",
                        closeCancelModalFunction
                    );


                    // ==========================================
                    // CONFIRM CANCEL
                    // ==========================================

                    confirmCancelButton.addEventListener("click", async () => {

                        const reason = cancellationReason.value.trim();

                        // Validate reason
                        if (!reason) {

                            cancelReasonError.classList.remove("hidden");

                            cancellationReason.focus();

                            return;
                        }

                        cancelReasonError.classList.add("hidden");

                        // Disable button while request is processing
                        confirmCancelButton.disabled = true;

                        try {

                            const response = await fetch(
                                `/orders/${selectedOrderId}/cancel`,
                                {
                                    method: "PATCH",

                                    headers: {
                                        "Content-Type": "application/json"
                                    },

                                    body: JSON.stringify({
                                        cancellationReason: reason
                                    })
                                }
                            );

                            const data = await response.json();

                            if (!response.ok || !data.success) {

                                throw new Error(
                                    data.message || "FAILED TO CANCEL ORDER"
                                );

                            }

                            // Close modal
                            closeCancelModalFunction();

                            // Reload orders page so status changes to CANCELLED
                            window.location.reload();

                        } catch (error) {

                            console.error("Cancel order error:", error);

                            alert(error.message);

                        } finally {

                            confirmCancelButton.disabled = false;

                        }

                    });
                </script>
</body>

</html>