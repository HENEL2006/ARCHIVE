<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>ARCHIVE | CREATE NEW PASSWORD</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-container": "#f0edec",
            "surface-dim": "#dcd9d9",
            "on-error": "#ffffff",
            "secondary-fixed-dim": "#c6c6c7",
            "on-primary": "#ffffff",
            "on-secondary-fixed": "#1a1c1c",
            tertiary: "#000000",
            "surface-tint": "#5e5e5e",
            secondary: "#5d5f5f",
            "on-tertiary-fixed-variant": "#474747",
            "surface-container-low": "#f6f3f2",
            "on-tertiary-fixed": "#1b1b1b",
            "surface-bright": "#fcf9f8",
            "on-secondary-fixed-variant": "#454747",
            "on-primary-fixed": "#1b1b1b",
            "on-surface-variant": "#4c4546",
            "on-secondary": "#ffffff",
            "on-primary-fixed-variant": "#474747",
            "secondary-container": "#dfe0e0",
            primary: "#000000",
            "on-secondary-container": "#616363",
            "on-primary-container": "#848484",
            "on-background": "#1c1b1b",
            "on-tertiary-container": "#848484",
            "surface-container-highest": "#e5e2e1",
            "primary-container": "#1b1b1b",
            "error-container": "#ffdad6",
            "primary-fixed": "#e2e2e2",
            "surface-container-high": "#ebe7e7",
            surface: "#fcf9f8",
            error: "#ba1a1a",
            background: "#fcf9f8",
            "tertiary-container": "#1b1b1b",
            "accent-success": "#22CD5B",
            "outline-variant": "#cfc4c5",
            "inverse-on-surface": "#f3f0ef",
            "surface-variant": "#e5e2e1",
            "tertiary-fixed-dim": "#c6c6c6",
            "on-surface": "#1c1b1b",
            "inverse-surface": "#313030",
            "secondary-fixed": "#e2e2e2",
            outline: "#7e7576",
            "on-error-container": "#93000a",
            "inverse-primary": "#c6c6c6",
            "on-tertiary": "#ffffff",
            "tertiary-fixed": "#e2e2e2",
            "surface-container-lowest": "#ffffff",
            "primary-fixed-dim": "#c6c6c6",
          },
          borderRadius: {
            DEFAULT: "0px",
            lg: "0px",
            xl: "0px",
            full: "9999px",
          },
          spacing: {
            "section-gap": "128px",
            "mobile-margin": "20px",
            "grid-gutter": "0px",
            unit: "8px",
            "container-padding": "64px",
          },
          fontFamily: {
            "label-caps": ["Space Mono"],
            "headline-md": ["Syne"],
            "headline-lg": ["Syne"],
            "display-xl": ["Syne"],
            "mono-data": ["Space Mono"],
            "headline-lg-mobile": ["Syne"],
            "body-md": ["Space Mono"],
            "body-lg": ["Space Mono"],
          },
          fontSize: {
            "label-caps": [
              "12px",
              {
                lineHeight: "1.0",
                letterSpacing: "0.1em",
                fontWeight: "700",
              },
            ],
            "headline-md": [
              "24px",
              {
                lineHeight: "1.2",
                letterSpacing: "0.03em",
                fontWeight: "700",
              },
            ],
            "headline-lg": [
              "48px",
              {
                lineHeight: "1.1",
                letterSpacing: "0.04em",
                fontWeight: "700",
              },
            ],
            "display-xl": [
              "80px",
              {
                lineHeight: "1.0",
                letterSpacing: "0.05em",
                fontWeight: "800",
              },
            ],
            "mono-data": [
              "12px",
              {
                lineHeight: "1.0",
                letterSpacing: "-0.02em",
                fontWeight: "400",
              },
            ],
            "headline-lg-mobile": [
              "32px",
              {
                lineHeight: "1.1",
                letterSpacing: "0.04em",
                fontWeight: "700",
              },
            ],
            "body-md": [
              "14px",
              { lineHeight: "1.6", letterSpacing: "0em", fontWeight: "400" },
            ],
            "body-lg": [
              "16px",
              { lineHeight: "1.6", letterSpacing: "0em", fontWeight: "400" },
            ],
          },
        },
      },
    };
  </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings:
        "FILL" 0,
        "wght" 400,
        "GRAD" 0,
        "opsz" 24;
      display: inline-block;
      vertical-align: middle;
    }

    .grid-line-v {
      width: 1px;
      background-color: #000;
    }

    .grid-line-h {
      height: 1px;
      background-color: #000;
    }

    ::-webkit-scrollbar {
      width: 4px;
    }

    ::-webkit-scrollbar-track {
      background: #fcf9f8;
    }

    ::-webkit-scrollbar-thumb {
      background: #000;
    }

    input:focus {
      outline: none !important;
      border-color: transparent !important;
      box-shadow: none !important;
    }

    input {
      -webkit-tap-highlight-color: transparent;
    }

    .bg-text-overlay {
      user-select: none;
      pointer-events: none;
      opacity: 0.03;
      white-space: nowrap;
      position: absolute;
      z-index: 0;
      line-height: 0.8;
    }
  </style>
</head>

<body class="bg-background text-primary font-body-md overflow-x-hidden">
  <!-- Main Shell -->
  <main class="min-h-screen flex flex-col md:flex-row border-b border-primary">
    <!-- Left Side: Editorial Image -->
    <section class="w-full md:w-1/2 h-[50vh] md:h-screen sticky top-0 border-r border-primary overflow-hidden group">
      <img alt="Editorial model portrait"
        class="w-full h-full object-cover grayscale brightness-90 group-hover:scale-105 transition-transform duration-1000"
        src="/images/login-img.jpg" />
      <div class="absolute inset-0 bg-primary/10 mix-blend-multiply"></div>
      <div class="absolute bottom-10 left-10 z-10"></div>
    </section>
    <!-- Right Side: Interaction Canvas -->
    <section class="w-full md:w-1/2 bg-background flex flex-col relative overflow-hidden">
      <!-- Faded Background Typography -->
      <div class="bg-text-overlay font-display-xl top-1/4 -left-20 rotate-90 origin-top-left"
        style="transform: translateY(11.8438px) rotate(90deg)">
        FOOTBALL. CULTURE. MEMORY.
      </div>
      <!-- Content Container -->
      <div class="flex-grow flex flex-col px-container-padding py-20 relative z-10 max-w-3xl mx-auto w-full">
        <!-- Header -->
        <header class="mb-16">
          <h1
            class="font-headline-lg text-headline-lg md:font-headline-lg md:text-headline-lg uppercase mb-4 leading-none">
            SECURE YOUR ACCOUNT
          </h1>
          <p class="font-body-lg text-body-lg text-secondary max-w-md">
            Create a new password to regain access to your archive. Ensure the
            integrity of your personal history.
          </p>
        </header>
        <!-- Reset Form -->
        <form id="reset-form" class="space-y-12" action="/reset-password" method="post">
          <div class="space-y-8">
            <div class="border-b border-primary pb-2 flex flex-col">
              <label class="font-label-caps text-label-caps mb-4 text-primary/60" for="new_password">NEW
                PASSWORD</label>
              <input
                class="bg-transparent border-none p-0 font-mono-data text-headline-md tracking-widest placeholder:text-surface-dim"
                id="new_password" placeholder="••••••••" type="password" , name="password" />
            </div>
            <div class="border-b border-primary pb-2 flex flex-col">
              <label class="font-label-caps text-label-caps mb-4 text-primary/60" for="confirm_password">CONFIRM
                PASSWORD</label>
              <input
                class="bg-transparent border-none p-0 font-mono-data text-headline-md tracking-widest placeholder:text-surface-dim"
                id="confirm_password" placeholder="••••••••" type="password" , name="confirmPassword" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 border border-primary p-6">
            <div id="length-rule" class="flex items-center gap-2 text-surface-dim">
              <span class="material-symbols-outlined text-[14px]">
                circle
              </span>
              <span class="font-mono-data text-mono-data">
                MIN. 6 CHARACTERS
              </span>
            </div>

            <div id="uppercase-rule" class="flex items-center gap-2 text-surface-dim">
              <span class="material-symbols-outlined text-[14px]">
                circle
              </span>
              <span class="font-mono-data text-mono-data">
                ONE UPPERCASE
              </span>
            </div>

            <div id="number-rule" class="flex items-center gap-2 text-surface-dim">
              <span class="material-symbols-outlined text-[14px]">
                circle
              </span>
              <span class="font-mono-data text-mono-data"> ONE NUMBER </span>
            </div>

            <div id="special-rule" class="flex items-center gap-2 text-surface-dim">
              <span class="material-symbols-outlined text-[14px]">
                circle
              </span>
              <span class="font-mono-data text-mono-data">
                SPECIAL CHARACTER
              </span>
            </div>
          </div>
          <div class="space-y-6">

            <div class="h-5 flex items-center justify-center">
              <% if(error && error !=="INVALID_PASSWORD" ){ %>
                <p class="text-center text-[10px] tracking-[0.2em] uppercase text-red-500">
                  <%= error %>
                </p>
                <% } %>
            </div>

            <button
              class="w-full bg-primary text-on-primary py-6 font-label-caps text-label-caps hover:bg-surface-container-highest hover:text-primary transition-colors border border-primary active:bg-on-background"
              type="submit">
              UPDATE PASSWORD
            </button>
            <a class="block w-full text-center font-label-caps text-label-caps text-secondary hover:text-primary transition-colors uppercase"
              href="/login">
              BACK TO SIGN IN
            </a>
          </div>
        </form>
        <!-- Security Info -->
        <div class="mt-16 pt-8 border-t border-primary/20">
          <p class="font-mono-data text-mono-data text-secondary-fixed-dim leading-relaxed italic">
            "Your new password should be unique and different from previously
            used passwords. Access logs are monitored for security."
          </p>
        </div>
        <!-- Quote -->
        <div class="mt-12"></div>
      </div>
      <!-- Benefits Section (Bottom Grid) -->
    </section>
  </main>
  <!-- Footer -->
  <footer class="bg-background border-b border-primary"></footer>
  <script>
    const passwordInput = document.getElementById("new_password");
    const form = document.getElementById("reset-form");

    const rules = {
      "length-rule": () => passwordInput.value.length >= 6,
      "uppercase-rule": () => /[A-Z]/.test(passwordInput.value),
      "number-rule": () => /[0-9]/.test(passwordInput.value),
      "special-rule": () =>
        /[!@#$%^&*(),.?":{}|<>]/.test(passwordInput.value),
    };

    passwordInput.addEventListener("input", () => {

      Object.keys(rules).forEach((ruleId) => {
        updateRule(
          ruleId,
          rules[ruleId](),
          false
        );
      });

    });

    form.addEventListener("submit", (e) => {

      let allValid = true;

      Object.keys(rules).forEach((ruleId) => {

        const valid = rules[ruleId]();

        updateRule(
          ruleId,
          valid,
          true
        );

        if (!valid) {
          allValid = false;
        }

      });

      if (!allValid) {
        e.preventDefault();
      }

    });

    function updateRule(
      ruleId,
      valid,
      submitted
    ) {

      const rule =
        document.getElementById(ruleId);

      const icon =
        rule.querySelector(
          ".material-symbols-outlined"
        );

      rule.classList.remove(
        "text-surface-dim",
        "text-primary",
        "text-red-500"
      );

      if (valid) {

        icon.textContent =
          "check_circle";

        rule.classList.add(
          "text-primary"
        );

      }
      else {

        icon.textContent =
          "circle";

        if (submitted) {

          rule.classList.add(
            "text-red-500"
          );

        }
        else {

          rule.classList.add(
            "text-surface-dim"
          );

        }

      }
    }
  </script>

  <% if(error==="INVALID_PASSWORD" ){ %>
    <script>
      window.addEventListener(
        "DOMContentLoaded",
        () => {

          document
            .getElementById(
              "reset-form"
            )
            .dispatchEvent(
              new Event(
                "submit"
              )
            );

        }
      );
    </script>
    <% } %>

</body>

</html>