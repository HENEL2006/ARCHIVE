<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>RESET PASSWORD | ARCHIVE</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Custom scrollbar for brutalist aesthetic */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #fcf9f8;
        }

        ::-webkit-scrollbar-thumb {
            background: #000000;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container-lowest": "#ffffff",
                        "primary": "#000000",
                        "tertiary-container": "#1b1b1b",
                        "on-primary-container": "#848484",
                        "tertiary-fixed": "#e2e2e2",
                        "secondary-container": "#dfe0e0",
                        "surface-bright": "#fcf9f8",
                        "outline": "#7e7576",
                        "surface": "#fcf9f8",
                        "on-primary-fixed": "#1b1b1b",
                        "on-tertiary-fixed": "#1b1b1b",
                        "inverse-surface": "#313030",
                        "secondary-fixed-dim": "#c6c6c7",
                        "secondary": "#5d5f5f",
                        "surface-container": "#f0edec",
                        "primary-fixed": "#e2e2e2",
                        "surface-container-highest": "#e5e2e1",
                        "surface-variant": "#e5e2e1",
                        "on-error": "#ffffff",
                        "background": "#fcf9f8",
                        "error-container": "#ffdad6",
                        "surface-dim": "#dcd9d9",
                        "outline-variant": "#cfc4c5",
                        "surface-container-low": "#f6f3f2",
                        "inverse-on-surface": "#f3f0ef",
                        "surface-tint": "#5e5e5e",
                        "on-tertiary": "#ffffff",
                        "on-surface": "#1c1b1b",
                        "tertiary": "#000000",
                        "surface-container-high": "#ebe7e7",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-surface-variant": "#4c4546",
                        "on-secondary-container": "#616363",
                        "secondary-fixed": "#e2e2e2",
                        "accent-success": "#22CD5B",
                        "on-tertiary-container": "#848484",
                        "inverse-primary": "#c6c6c6",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#474747",
                        "on-secondary-fixed": "#1a1c1c",
                        "on-background": "#1c1b1b",
                        "primary-container": "#1b1b1b",
                        "primary-fixed-dim": "#c6c6c6",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed-variant": "#474747",
                        "on-secondary-fixed-variant": "#454747",
                        "error": "#ba1a1a",
                        "on-primary": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "unit": "8px",
                        "grid-gutter": "0px",
                        "section-gap": "128px",
                        "mobile-margin": "20px",
                        "container-padding": "64px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
</head>

<body class="bg-surface text-primary font-body-md min-h-screen selection:bg-primary selection:text-surface">
    <%- include('./partials/header') %>
        <!-- Top Navigation (Shell suppressed for Transactional focus as per instructions, but placeholder provided for context if user navigates back) -->

        <main class="h-[calc(100vh-81px)] flex flex-col md:flex-row overflow-hidden">
            <!-- Left Column: Editorial Image -->
            <section class="hidden md:block w-full md:w-1/2 h-full relative border-r border-primary overflow-hidden">
                <img alt="High-contrast black and white editorial photography of a model wearing a vintage AC Milan jersey, standing against a raw concrete brutalist wall. The lighting is harsh and directional, creating dramatic shadows. The aesthetic is cold, premium, and authoritative, matching the Hyper-Luxury Brutalist design system."
                    class="w-full h-full object-cover grayscale contrast-125 brightness-90" src="/images/login-img.jpg">
                <div class="absolute inset-0 flex items-end p-container-padding pointer-events-none">
                    <div class="opacity-10 pointer-events-none select-none">
                        <p
                            class="font-syne text-headline-lg uppercase leading-none transform -rotate-90 origin-left -translate-x-full mb-20 whitespace-nowrap">
                            FOOTBALL. CULTURE. MEMORY.
                        </p>
                    </div>
                </div>
            </section>
            <!-- Right Column: Authentication Canvas -->
            <section class="w-full md:w-1/2 flex flex-col">
                <!-- Mobile Image (Visible only on mobile) -->
                <div class="md:hidden w-full h-80 overflow-hidden border-b border-primary">
                    <img alt="Editorial image" class="w-full h-full object-cover grayscale" src="/images/login-img.jpg">
                </div>
                <div class="flex-1 flex items-center px-mobile-margin md:px-container-padding py-10 overflow-hidden">
                    <!-- Back Link -->
                    <div class="max-w-xl w-full">

                        <a href="/login"
                            class="inline-flex items-center gap-2 mb-10 text-[11px] tracking-[0.18em] uppercase font-bold hover:opacity-60 transition-opacity">
                            <span class="material-symbols-outlined text-[16px]">
                                arrow_back
                            </span>

                            Back to Sign In
                        </a>

                        <h1 class="font-headline-lg text-headline-lg uppercase mb-6">
                            RESET PASSWORD
                        </h1>
                        <!-- Reset Form Content -->
                        <div class="max-w-xl">
                            <h1
                                class="font-headline-lg text-headline-lg md:font-headline-lg md:text-headline-lg mb-6 uppercase">
                                RESET PASSWORD</h1>
                            <p class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-md">
                                Enter your email address and we'll send a verification code to securely reset your
                                password.
                            </p>
                            <form action="/forgot-password" method="post" class="space-y-8">
                                <div class="flex flex-col space-y-2">
                                    <label class="font-label-caps text-label-caps text-primary">EMAIL ADDRESS</label>
                                    <input
                                        class="bg-transparent border border-primary px-4 py-4 font-body-md focus:ring-0 focus:border-primary placeholder:opacity-50 placeholder:font-body-md"
                                        placeholder="Enter your email address" name="email" type="email">
                                </div>

                                <% if(error){ %>
                                    <div class="flex items-center justify-center">
                                        <p class="text-center text-[10px] tracking-[0.2em] uppercase text-red-500">
                                            <%= error %>
                                        </p>
                                    </div>
                                    <% } %>

                                        <button
                                            class="w-full bg-primary text-surface py-6 font-label-caps text-label-caps hover:bg-surface hover:text-primary border border-primary transition-none flex justify-between items-center px-6"
                                            type="submit">
                                            SEND VERIFICATION CODE
                                            <span class="material-symbols-outlined">chevron_right</span>
                                        </button>
                            </form>
                            <div class="mt-8 p-6 border border-primary/10 bg-surface-container-low">
                                <div class="flex gap-4">
                                    <span class="material-symbols-outlined text-primary">info</span>
                                    <p class="font-mono-data text-mono-data text-on-surface-variant">
                                        For security reasons, password reset instructions will only be sent to
                                        registered
                                        email addresses. If you do not receive an email, please contact ARCHIVE support.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Editorial Quote Section -->

                    </div>
                    <!-- Footer Segment -->

            </section>
        </main>
        <!-- Micro-interaction Script -->
        <script>
            document.querySelectorAll('input').forEach(input => {
                input.addEventListener('focus', () => {
                    input.parentElement.querySelector('label').classList.add('text-primary');
                });
                input.addEventListener('blur', () => {
                    if (!input.value) {
                        input.parentElement.querySelector('label').classList.remove('text-primary');
                    }
                });
            });
        </script>


</body>

</html>