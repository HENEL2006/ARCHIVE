<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>CHECKOUT | ARCHIVE</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:ital,wght@0,400;0,700;1,400&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface": "#fcf9f8",
                        "primary-fixed-dim": "#c6c6c6",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed": "#1b1b1b",
                        "error": "#ba1a1a",
                        "on-primary-fixed-variant": "#474747",
                        "secondary-fixed": "#e2e2e2",
                        "on-error": "#ffffff",
                        "on-primary-container": "#848484",
                        "surface-container-high": "#ebe7e7",
                        "primary": "#000000",
                        "on-primary": "#ffffff",
                        "outline-variant": "#cfc4c5",
                        "on-secondary-container": "#616363",
                        "on-secondary-fixed": "#1a1c1c",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "tertiary-fixed": "#e2e2e2",
                        "secondary-container": "#dfe0e0",
                        "inverse-on-surface": "#f3f0ef",
                        "primary-container": "#1b1b1b",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#e5e2e1",
                        "on-background": "#1c1b1b",
                        "surface-container-highest": "#e5e2e1",
                        "on-primary-fixed": "#1b1b1b",
                        "inverse-surface": "#313030",
                        "on-tertiary-fixed-variant": "#474747",
                        "inverse-primary": "#c6c6c6",
                        "tertiary": "#000000",
                        "on-error-container": "#93000a",
                        "surface-dim": "#dcd9d9",
                        "background": "#fcf9f8",
                        "surface-bright": "#fcf9f8",
                        "on-tertiary-container": "#848484",
                        "accent-success": "#22CD5B",
                        "secondary": "#5d5f5f",
                        "secondary-fixed-dim": "#c6c6c7",
                        "error-container": "#ffdad6",
                        "outline": "#7e7576",
                        "primary-fixed": "#e2e2e2",
                        "on-surface-variant": "#4c4546",
                        "tertiary-container": "#1b1b1b",
                        "surface-tint": "#5e5e5e",
                        "on-surface": "#1c1b1b",
                        "on-secondary-fixed-variant": "#454747",
                        "surface-container-low": "#f6f3f2",
                        "on-tertiary": "#ffffff",
                        "surface-container": "#f0edec"
                    },
                    "borderRadius": {
                        "DEFAULT": "0rem",
                        "lg": "0rem",
                        "xl": "0rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "section-gap": "128px",
                        "container-padding": "64px",
                        "mobile-margin": "20px",
                        "unit": "8px",
                        "grid-gutter": "0px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        input[type="checkbox"] {
            border-radius: 0;
            border: 1px solid #000;
        }

        input[type="checkbox"]:checked {
            background-color: #000;
            border-color: #000;
        }

        select {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23000' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.5rem center;
            background-repeat: no-repeat;
            background-size: 1.5em 1.5em;
            padding-right: 2.5rem;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }
    </style>
</head>

<body class="bg-surface text-primary selection:bg-primary selection:text-on-primary font-body-md overflow-x-hidden">
    <!-- TopNavBar -->
    <%- include("./partials/userHeader") %>
        <%- include("partials/toast") %>
            <!-- Main Content Canvas -->
            <main class="w-full pt-[80px]">
                <form id="checkoutForm" action="/checkout/place-order" method="POST">

                    <% const defaultAddress=addresses.find(address=> address.isDefault); %>

                        <input type="hidden" name="addressId" id="selectedAddressId"
                            value="<%= defaultAddress ? defaultAddress._id : "" %>">

                        <div class="grid grid-cols-1 md:grid-cols-12 w-full min-h-screen">
                            <!-- Left Column (70%) -->
                            <div class="md:col-span-8 border-r border-primary">
                                <section class="p-container-padding">
                                    <h1 class="font-display-xl text-display-xl uppercase mb-12">CHECKOUT</h1>
                                    <!-- Section 01 / Delivery -->
                                    <div class="mb-20">

                                        <div class="flex items-baseline gap-4 mb-8">
                                            <span class="font-mono-data text-mono-data">01 /</span>
                                            <h2 class="font-headline-lg text-headline-lg uppercase">
                                                Delivery
                                            </h2>
                                        </div>



                                        <% if (defaultAddress) { %>

                                            <div class="border border-primary p-8 mb-6 max-w-2xl">

                                                <div class="flex justify-between items-start mb-6">

                                                    <span
                                                        class="font-label-caps text-label-caps px-3 py-1 bg-primary text-on-primary">
                                                        DEFAULT ADDRESS
                                                    </span>

                                                </div>

                                                <div class="space-y-1">

                                                    <h3 id="checkoutAddressName"
                                                        class="font-headline-md text-headline-md uppercase">
                                                        <%= defaultAddress.fullName %>
                                                    </h3>

                                                    <p id="checkoutAddressPhone"
                                                        class="font-mono-data text-mono-data text-secondary">
                                                        <%= defaultAddress.phone %>
                                                    </p>

                                                    <p id="checkoutAddressDetails"
                                                        class="font-body-md text-body-md mt-4 leading-relaxed">

                                                        <%= defaultAddress.addressLine1 %><br />

                                                            <% if (defaultAddress.addressLine2) { %>
                                                                <%= defaultAddress.addressLine2 %><br />
                                                                    <% } %>

                                                                        <%= defaultAddress.city %>,
                                                                            <%= defaultAddress.state %><br />

                                                                                <%= defaultAddress.postalCode %>,
                                                                                    <%= defaultAddress.country %>

                                                    </p>

                                                </div>

                                            </div>

                                            <% } else { %>

                                                <div class="border border-primary p-8 mb-6 max-w-2xl">

                                                    <h3 class="font-headline-md text-headline-md uppercase">
                                                        NO ADDRESS FOUND
                                                    </h3>

                                                    <p class="font-body-md text-body-md text-secondary mt-4">
                                                        Please add a delivery address before placing your order.
                                                    </p>

                                                </div>

                                                <% } %>


                                                    <div class="flex gap-4">

                                                        <button type="button" id="changeAddressBtn"
                                                            class="font-label-caps text-label-caps border border-primary px-6 py-3 hover:bg-primary hover:text-on-primary transition-colors uppercase">
                                                            CHANGE ADDRESS
                                                        </button>

                                                        <a href="/address/add"
                                                            class="font-label-caps text-label-caps border border-primary px-6 py-3 hover:bg-primary hover:text-on-primary transition-colors uppercase">
                                                            ADD NEW ADDRESS
                                                        </a>

                                                    </div>

                                    </div>
                                    <!-- Section 02 / Payment -->
                                    <div class="mb-20">
                                        <div class="flex items-baseline gap-4 mb-8">
                                            <span class="font-mono-data text-mono-data">02 /</span>
                                            <h2 class="font-headline-lg text-headline-lg uppercase">Payment</h2>
                                        </div>
                                        <div class="space-y-0 border-t border-primary max-w-2xl">
                                            <!-- Razorpay Row -->
                                            <label
                                                class="flex items-center justify-between p-6 border-b border-l border-r border-primary cursor-pointer hover:bg-surface-container transition-colors group">
                                                <div class="flex items-center gap-6">
                                                    <input class="w-4 h-4 text-primary focus:ring-0" name="payment"
                                                        type="radio" value="RAZORPAY" />
                                                    <div class="flex items-center gap-4">
                                                        <span class="material-symbols-outlined text-xl">payments</span>
                                                        <span
                                                            class="font-label-caps text-label-caps uppercase">Razorpay</span>
                                                    </div>
                                                </div>
                                                <span class="font-mono-data text-mono-data text-secondary">UPI / CARDS /
                                                    NETBANKING</span>
                                            </label>
                                            <!-- COD Row -->
                                            <label
                                                class="flex items-center justify-between p-6 border-b border-l border-r border-primary cursor-pointer hover:bg-surface-container transition-colors group">
                                                <div class="flex items-center gap-6">
                                                    <input checked class="w-4 h-4 text-primary focus:ring-0"
                                                        name="payment" type="radio" value="COD" />
                                                    <div class="flex items-center gap-4">
                                                        <span
                                                            class="material-symbols-outlined text-xl">local_shipping</span>
                                                        <span class="font-label-caps text-label-caps uppercase">Cash On
                                                            Delivery</span>
                                                    </div>
                                                </div>
                                                <span class="font-mono-data text-mono-data text-secondary">ELIGIBLE
                                                    ORDERS
                                                    ONLY</span>
                                            </label>
                                        </div>
                                    </div>
                                    <!-- Wallet Section -->
                                    <div class="p-8 border border-primary max-w-2xl bg-surface-container-low">
                                        <div class="flex justify-between items-center">
                                            <div>
                                                <h4 class="font-label-caps text-label-caps mb-1">
                                                    WALLET BALANCE
                                                </h4>

                                                <p class="font-headline-md text-headline-md tracking-tighter">
                                                    ₹<%= wallet.balance.toFixed(2) %>
                                                </p>
                                            </div>

                                            <label
                                                class="flex items-center gap-3 <%= wallet.balance > 0 ? 'cursor-pointer' : 'cursor-not-allowed' %>">
                                                <input class="w-5 h-5 text-primary focus:ring-0" type="radio"
                                                    name="payment" value="WALLET" <%=wallet.balance <=0 ? "disabled"
                                                    : "" %>
                                                />

                                                <span class="font-label-caps text-label-caps">
                                                    USE WALLET
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <!-- Right Column (30%) -->
                            <div class="md:col-span-4 bg-surface h-full">
                                <div class="sticky top-20 p-container-padding">
                                    <h2
                                        class="font-headline-md text-headline-md uppercase mb-8 tracking-tighter border-b border-primary pb-4">
                                        Order Summary</h2>
                                    <!-- Items List -->
                                    <div class="space-y-6 mb-8">

                                        <% cart.items.slice(0,3).forEach((item)=> { %>

                                            <div class="flex gap-4 items-start">

                                                <div
                                                    class="w-[60px] h-[60px] border border-primary flex-shrink-0 overflow-hidden">

                                                    <img alt="<%= item.product.name %>"
                                                        class="w-full h-full object-cover"
                                                        src="<%= item.product.images[0].url %>" />

                                                </div>

                                                <div class="flex-grow">

                                                    <h4 class="font-label-caps text-label-caps leading-none mb-1">
                                                        <%= item.product.name %>
                                                    </h4>

                                                    <p class="font-mono-data text-mono-data text-secondary">
                                                        SIZE: <%= item.size %> / QTY: <%= item.quantity %>
                                                    </p>

                                                    <% if (item.offer) { %>
                                                        <div class="mt-1 space-y-1">

                                                            <div class="flex items-center gap-2">
                                                                <span class="font-mono-data text-mono-data">
                                                                    ₹<%= (item.price *
                                                                        item.quantity).toLocaleString("en-IN", {
                                                                        maximumFractionDigits: 0 }) %>
                                                                </span>

                                                                <span
                                                                    class="font-mono-data text-[10px] text-secondary line-through">
                                                                    ₹<%= (item.originalPrice *
                                                                        item.quantity).toLocaleString("en-IN", {
                                                                        maximumFractionDigits: 0 }) %>
                                                                </span>
                                                            </div>

                                                            <p class="font-mono-data text-[10px] text-accent-success">
                                                                SAVE ₹<%= (item.discountAmount *
                                                                    item.quantity).toLocaleString("en-IN", {
                                                                    maximumFractionDigits: 0 }) %>

                                                                    <% if (item.offer.discountType==="PERCENTAGE" ) { %>
                                                                        · <%= item.offer.discountValue %>% OFF
                                                                            <% } %>
                                                            </p>

                                                        </div>
                                                        <% } else { %>

                                                            <p class="font-mono-data text-mono-data mt-1">
                                                                ₹<%= (item.price *
                                                                    item.quantity).toLocaleString("en-IN", {
                                                                    maximumFractionDigits: 0 }) %>
                                                            </p>

                                                            <% } %>

                                                </div>

                                            </div>

                                            <% }) %>

                                    </div>

                                    <% if (cart.items.length> 3) { %>

                                        <div class="flex justify-between items-center mb-8">

                                            <span class="font-mono-data text-mono-data text-secondary uppercase">
                                                +<%= cart.items.length - 3 %> MORE ITEMS
                                            </span>

                                            <a href="/cart"
                                                class="font-label-caps text-label-caps underline hover:no-underline">
                                                VIEW ALL ITEMS
                                            </a>

                                        </div>

                                        <% } %>


                                            <!-- Promo Code -->
                                            <div id="couponSection" class="mb-10 space-y-4">

                                                <% if (!appliedCoupon) { %>

                                                    <!-- Available Coupons -->
                                                    <div class="relative">
                                                        <select id="availableCouponSelect"
                                                            class="w-full appearance-none bg-transparent border border-primary font-mono-data text-mono-data py-3 px-4 pr-10 focus:ring-0 outline-none">
                                                            <option value="">AVAILABLE COUPONS</option>

                                                            <% availableCoupons.forEach(coupon=> { %>
                                                                <option value="<%= coupon.code %>">
                                                                    <%= coupon.code %> -
                                                                        <%= coupon.discountType==="PERCENTAGE" ?
                                                                            `${coupon.discountValue}% OFF` :
                                                                            `₹${coupon.discountValue} OFF` %>
                                                                </option>
                                                                <% }) %>
                                                        </select>

                                                        <span
                                                            class="material-symbols-outlined pointer-events-none absolute right-4 top-1/2 -translate-y-1/2">
                                                            expand_more
                                                        </span>
                                                    </div>

                                                    <!-- Apply Selected Coupon -->
                                                    <button type="button" id="applySelectedCouponBtn"
                                                        class="w-full bg-primary text-on-primary font-label-caps text-label-caps px-6 py-3">
                                                        APPLY SELECTED COUPON
                                                    </button>

                                                    <!-- Manual Coupon -->
                                                    <div class="flex gap-0">
                                                        <input id="couponCode"
                                                            class="flex-grow bg-transparent border border-primary border-r-0 font-mono-data text-mono-data py-3 px-4 focus:ring-0 uppercase"
                                                            placeholder="ENTER CODE" type="text" />

                                                        <button type="button" id="applyCouponBtn"
                                                            class="bg-primary text-on-primary font-label-caps text-label-caps px-6 py-3">
                                                            APPLY
                                                        </button>
                                                    </div>

                                                    <% } else { %>

                                                        <!-- Applied Coupon -->
                                                        <div class="border border-primary p-4">

                                                            <div class="flex justify-between items-center gap-4">

                                                                <div>
                                                                    <p
                                                                        class="font-label-caps text-label-caps text-secondary mb-2">
                                                                        APPLIED COUPON
                                                                    </p>

                                                                    <p class="font-mono-data text-mono-data font-bold">
                                                                        <%= appliedCoupon.code %>
                                                                    </p>
                                                                </div>

                                                                <button type="button" id="removeCouponBtn"
                                                                    class="font-label-caps text-label-caps border border-primary px-4 py-2">
                                                                    REMOVE
                                                                </button>

                                                            </div>

                                                        </div>

                                                        <% } %>

                                            </div>
                                            <!-- Financials -->
                                            <div class="border-t border-primary pt-6 space-y-4">

                                                <div
                                                    class="flex justify-between font-mono-data text-mono-data text-secondary">
                                                    <span>SUBTOTAL</span>
                                                    <span>₹<%= subtotal.toLocaleString("en-IN") %></span>
                                                </div>

                                                <div
                                                    class="flex justify-between font-mono-data text-mono-data text-secondary">
                                                    <span>SHIPPING</span>
                                                    <span>₹<%= shipping.toLocaleString("en-IN") %></span>
                                                </div>

                                                <div
                                                    class="flex justify-between font-mono-data text-mono-data text-accent-success">

                                                    <span id="discountLabel">
                                                        <%= appliedCoupon ? `COUPON — ${appliedCoupon.code}`
                                                            : "DISCOUNT" %>
                                                    </span>

                                                    <span id="discountAmount">
                                                        -₹<%= discount.toLocaleString("en-IN") %>
                                                    </span>

                                                </div>

                                                <div
                                                    class="flex justify-between font-headline-md text-headline-md border-t border-primary pt-6 mt-4">

                                                    <span>TOTAL</span>

                                                    <span id="checkoutTotal">
                                                        ₹<%= total.toLocaleString("en-IN") %>
                                                    </span>

                                                </div>

                                            </div>
                                            <!-- CTA -->
                                            <button type="submit" id="placeOrderBtn"
                                                class="w-full bg-primary text-on-primary font-label-caps text-label-caps py-6 mt-12 hover:opacity-90 transition-opacity tracking-widest text-lg">
                                                PLACE ORDER
                                            </button>
                                </div>
                            </div>
                        </div>
                </form>
            </main>
            <!-- Footer -->
            <%- include("partials/userFooter") %>

                <!-- CHANGE ADDRESS MODAL -->

                <div id="addressModal"
                    class="fixed inset-0 z-50 hidden bg-black/50 flex items-center justify-center p-6">

                    <div class="bg-surface border border-primary w-full max-w-4xl max-h-[85vh] overflow-y-auto">

                        <!-- Modal Header -->

                        <div class="flex justify-between items-center border-b border-primary p-6">

                            <div>
                                <span class="font-mono-data text-mono-data">
                                    DELIVERY
                                </span>

                                <h2 class="font-headline-md text-headline-md uppercase mt-2">
                                    Select Address
                                </h2>
                            </div>

                            <button type="button" id="closeAddressModal"
                                class="w-10 h-10 border border-primary flex items-center justify-center text-xl hover:bg-primary hover:text-on-primary">
                                ×
                            </button>

                        </div>


                        <!-- Addresses -->

                        <div class="grid grid-cols-1 md:grid-cols-2">

                            <% addresses.forEach((address)=> { %>

                                <label
                                    class="relative border-b border-r border-primary p-8 cursor-pointer hover:bg-surface-container transition-colors">

                                    <!-- Radio -->

                                    <input type="radio" name="checkoutAddress" value="<%= address._id %>"
                                        data-full-name="<%= address.fullName %>" data-phone="<%= address.phone %>"
                                        data-address-line1="<%= address.addressLine1 %>"
                                        data-address-line2="<%= address.addressLine2 || "" %>"
                                        data-city="<%= address.city %>" data-state="<%= address.state %>"
                                        data-postal-code="<%= address.postalCode %>"
                                        data-country="<%= address.country %>"
                                        class="absolute top-8 right-8 w-5 h-5 accent-black" <%=address.isDefault
                                        ? "checked" : "" %>
                                    >

                                    <!-- Address Type -->

                                    <div class="mb-8">

                                        <span
                                            class="font-label-caps text-label-caps px-3 py-1 <%= address.isDefault ? 'bg-primary text-on-primary' : 'border border-primary' %>">
                                            <%= address.isDefault ? "DEFAULT" : "SHIPPING ADDRESS" %>
                                        </span>

                                    </div>


                                    <!-- Full Name -->

                                    <div class="mb-6">

                                        <p class="font-label-caps text-label-caps text-secondary mb-2">
                                            FULL NAME
                                        </p>

                                        <h3 class="font-headline-md text-headline-md">
                                            <%= address.fullName %>
                                        </h3>

                                    </div>


                                    <!-- Contact -->

                                    <div class="mb-6">

                                        <p class="font-label-caps text-label-caps text-secondary mb-2">
                                            CONTACT
                                        </p>

                                        <p class="font-mono-data text-mono-data">
                                            <%= address.phone %>
                                        </p>

                                    </div>


                                    <!-- Shipping Details -->

                                    <div>

                                        <p class="font-label-caps text-label-caps text-secondary mb-2">
                                            SHIPPING DETAILS
                                        </p>

                                        <p class="font-mono-data text-mono-data leading-relaxed">

                                            <%= address.addressLine1 %>

                                                <% if (address.addressLine2) { %>
                                                    <br>
                                                    <%= address.addressLine2 %>
                                                        <% } %>

                                                            <br>
                                                            <%= address.city %>
                                                                <br>
                                                                <%= address.state %>
                                                                    <br>
                                                                    <%= address.postalCode %>
                                                                        <br>
                                                                        <%= address.country %>

                                        </p>

                                    </div>

                                </label>

                                <% }) %>

                        </div>


                        <!-- Modal Footer -->

                        <div class="border-t border-primary p-6 flex justify-between items-center">

                            <a href="/address/add"
                                class="font-label-caps text-label-caps border border-primary px-6 py-3 hover:bg-primary hover:text-on-primary transition-colors uppercase">
                                ADD NEW ADDRESS
                            </a>

                            <button type="button" id="confirmAddressBtn"
                                class="bg-primary text-on-primary font-label-caps text-label-caps px-8 py-3 hover:opacity-90">
                                USE THIS ADDRESS
                            </button>

                        </div>

                    </div>

                </div>


                <script>

                    function attachSelectedCoupon() {
                        const applySelectedCouponBtn = document.getElementById(
                            "applySelectedCouponBtn"
                        );

                        if (!applySelectedCouponBtn) return;

                        applySelectedCouponBtn.addEventListener("click", () => {
                            const availableCouponSelect = document.getElementById(
                                "availableCouponSelect"
                            );

                            const couponCodeInput = document.getElementById("couponCode");
                            const applyCouponBtn = document.getElementById("applyCouponBtn");

                            const selectedCoupon = availableCouponSelect.value;

                            if (!selectedCoupon) {
                                showToast("PLEASE SELECT A COUPON", "error");
                                return;
                            }

                            couponCodeInput.value = selectedCoupon;

                            applyCouponBtn.click();
                        });
                    }



                    const addressModal = document.getElementById("addressModal");
                    const changeAddressBtn = document.getElementById("changeAddressBtn");
                    const closeAddressModal = document.getElementById("closeAddressModal");
                    const confirmAddressBtn = document.getElementById("confirmAddressBtn");

                    // Open modal

                    changeAddressBtn.addEventListener("click", () => {

                        addressModal.classList.remove("hidden");

                    });


                    // Close modal

                    closeAddressModal.addEventListener("click", () => {

                        addressModal.classList.add("hidden");

                    });


                    // Close when clicking outside modal

                    addressModal.addEventListener("click", (event) => {

                        if (event.target === addressModal) {

                            addressModal.classList.add("hidden");

                        }

                    });


                    // Confirm selected address

                    confirmAddressBtn.addEventListener("click", () => {

                        const selectedAddress = document.querySelector(
                            'input[name="checkoutAddress"]:checked'
                        );

                        if (!selectedAddress) {

                            showToast("PLEASE SELECT AN ADDRESS", "error");

                            return;
                        }

                        document.getElementById("selectedAddressId").value =
                            selectedAddress.value;

                        const name = selectedAddress.dataset.fullName;
                        const phone = selectedAddress.dataset.phone;
                        const addressLine1 = selectedAddress.dataset.addressLine1;
                        const addressLine2 = selectedAddress.dataset.addressLine2;
                        const city = selectedAddress.dataset.city;
                        const state = selectedAddress.dataset.state;
                        const postalCode = selectedAddress.dataset.postalCode;
                        const country = selectedAddress.dataset.country;


                        // Update name

                        document.getElementById("checkoutAddressName").textContent = name;


                        // Update phone

                        document.getElementById("checkoutAddressPhone").textContent = phone;


                        // Update address

                        const addressDetails =
                            document.getElementById("checkoutAddressDetails");

                        addressDetails.innerHTML = `
                        ${addressLine1}<br>
                
                        ${addressLine2 ? `${addressLine2}<br>` : ""}
                
                        ${city}, ${state}<br>
                
                        ${postalCode}, ${country}
                    `;


                        // Close modal

                        addressModal.classList.add("hidden");


                        showToast("DELIVERY ADDRESS UPDATED", "success");

                    });

                    const checkoutForm = document.getElementById("checkoutForm");
                    const placeOrderBtn = document.getElementById("placeOrderBtn");

                    checkoutForm.addEventListener("submit", async (event) => {
                        const selectedPayment = document.querySelector(
                            'input[name="payment"]:checked'
                        );

                        if (!selectedPayment) {
                            event.preventDefault();
                            showToast("PLEASE SELECT A PAYMENT METHOD", "error");
                            return;
                        }

                        // Let the existing form submission handle COD and WALLET
                        if (
                            selectedPayment.value === "COD" ||
                            selectedPayment.value === "WALLET"
                        ) {
                            return;
                        }

                        // Razorpay payment
                        if (selectedPayment.value === "RAZORPAY") {
                            event.preventDefault();

                            const addressId =
                                document.getElementById("selectedAddressId").value;

                            if (!addressId) {
                                showToast("PLEASE SELECT A DELIVERY ADDRESS", "error");
                                return;
                            }

                            try {
                                placeOrderBtn.disabled = true;
                                placeOrderBtn.textContent = "PROCESSING...";

                                const response = await fetch(
                                    "/checkout/create-razorpay-order",
                                    {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/json",
                                        },
                                        body: JSON.stringify({
                                            addressId,
                                        }),
                                    }
                                );

                                const data = await response.json();

                                if (!response.ok || !data.success) {
                                    throw new Error(
                                        data.message || "FAILED TO CREATE PAYMENT"
                                    );
                                }

                                const options = {
                                    key: data.key,
                                    amount: data.amount,
                                    currency: data.currency,
                                    name: "ARCHIVE",
                                    description: "ARCHIVE Jersey Store",
                                    order_id: data.razorpayOrderId,

                                    handler: async function (paymentResponse) {
                                        console.log(
                                            "RAZORPAY PAYMENT RESPONSE:",
                                            paymentResponse
                                        );

                                        try {
                                            const response = await fetch(
                                                "/checkout/verify-razorpay-payment",
                                                {
                                                    method: "POST",
                                                    headers: {
                                                        "Content-Type": "application/json",
                                                    },
                                                    body: JSON.stringify({
                                                        razorpay_payment_id:
                                                            paymentResponse.razorpay_payment_id,

                                                        razorpay_order_id:
                                                            paymentResponse.razorpay_order_id,

                                                        razorpay_signature:
                                                            paymentResponse.razorpay_signature,

                                                        addressId:
                                                            document.getElementById(
                                                                "selectedAddressId"
                                                            ).value,
                                                    }),
                                                }
                                            );

                                            const data = await response.json();

                                            if (!response.ok || !data.success) {
                                                throw new Error(
                                                    data.message || "PAYMENT VERIFICATION FAILED"
                                                );
                                            }

                                            window.location.href =
                                                `/order-success/${data.orderId}`;
                                        } catch (error) {
                                            console.log(error);

                                            placeOrderBtn.disabled = false;
                                            placeOrderBtn.textContent = "PLACE ORDER";

                                            showToast(
                                                error.message || "PAYMENT VERIFICATION FAILED",
                                                "error"
                                            );
                                        }
                                    },

                                    modal: {
                                        ondismiss: function () {
                                            window.location.href = "/payment-failed";
                                        }
                                    },

                                    prefill: {
                                        name: "<%= defaultAddress ? defaultAddress.fullName : '' %>",
                                        contact: "<%= defaultAddress ? defaultAddress.phone : '' %>",
                                    },

                                    theme: {
                                        color: "#000000",
                                    },

                                    modal: {
                                        ondismiss: function () {
                                            placeOrderBtn.disabled = false;
                                            placeOrderBtn.textContent = "PLACE ORDER";

                                            showToast(
                                                "PAYMENT CANCELLED",
                                                "error"
                                            );
                                        },
                                    },
                                };

                                const razorpay = new Razorpay(options);

                                razorpay.open();
                            } catch (error) {
                                console.log(error);

                                placeOrderBtn.disabled = false;
                                placeOrderBtn.textContent = "PLACE ORDER";

                                showToast(
                                    error.message || "PAYMENT INITIALIZATION FAILED",
                                    "error"
                                );
                            }
                        }
                    });

                    // COUPONS >>>>>>>>


                    function attachApplyCoupon() {

                        const applyCouponBtn =
                            document.getElementById("applyCouponBtn");

                        if (!applyCouponBtn) {
                            return;
                        }

                        applyCouponBtn.addEventListener("click", async () => {

                            const couponCodeInput =
                                document.getElementById("couponCode");

                            const code = couponCodeInput.value.trim();

                            if (!code) {
                                showToast("PLEASE ENTER A COUPON CODE", "error");
                                return;
                            }

                            try {

                                applyCouponBtn.disabled = true;
                                applyCouponBtn.textContent = "APPLYING...";

                                const response = await fetch(
                                    "/checkout/apply-coupon",
                                    {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/json",
                                        },
                                        body: JSON.stringify({
                                            code,
                                        }),
                                    }
                                );

                                const data = await response.json();

                                if (!response.ok || !data.success) {
                                    throw new Error(
                                        data.message || "FAILED TO APPLY COUPON"
                                    );
                                }

                                const discount =
                                    Number(data.coupon.discount);

                                const subtotal = <%= subtotal %>;
                                const shipping = <%= shipping %>;
                                const tax = 0;

                                const total =
                                    subtotal + shipping + tax - discount;

                                document.getElementById(
                                    "discountLabel"
                                ).textContent =
                                    `COUPON — ${data.coupon.code}`;

                                document.getElementById(
                                    "discountAmount"
                                ).textContent =
                                    `-₹${discount.toLocaleString("en-IN")}`;

                                document.getElementById(
                                    "checkoutTotal"
                                ).textContent =
                                    `₹${total.toLocaleString("en-IN")}`;

                                document.getElementById("couponSection").innerHTML = `
    <div class="relative">

        <select
            id="availableCouponSelect"
            class="w-full appearance-none bg-transparent border border-primary font-mono-data text-mono-data py-3 px-4 pr-10 focus:ring-0 outline-none"
        >
            <option value="">AVAILABLE COUPONS</option>

            <% availableCoupons.forEach(coupon => { %>
                <option value="<%= coupon.code %>">
                    <%= coupon.code %> -
                    <%= coupon.discountType === "PERCENTAGE"
                        ? `${ coupon.discountValue }% OFF`
                        : `₹${ coupon.discountValue } OFF`
                    %>
                </option>
            <% }) %>
        </select>

        <span
            class="material-symbols-outlined pointer-events-none absolute right-4 top-1/2 -translate-y-1/2"
        >
            expand_more
        </span>

    </div>

    <button
        type="button"
        id="applySelectedCouponBtn"
        class="w-full bg-primary text-on-primary font-label-caps text-label-caps px-6 py-3"
    >
        APPLY SELECTED COUPON
    </button>

    <div class="flex gap-0">

        <input
            id="couponCode"
            class="flex-grow bg-transparent border border-primary border-r-0 font-mono-data text-mono-data py-3 px-4 focus:ring-0 uppercase"
            placeholder="ENTER CODE"
            type="text"
        />

        <button
            type="button"
            id="applyCouponBtn"
            class="bg-primary text-on-primary font-label-caps text-label-caps px-6 py-3"
        >
            APPLY
        </button>

    </div>
`;

                                attachApplyCoupon();
                                attachSelectedCoupon();

                                attachRemoveCoupon();

                                showToast(
                                    "COUPON APPLIED SUCCESSFULLY",
                                    "success"
                                );

                            } catch (error) {

                                console.log(error);

                                showToast(
                                    error.message || "FAILED TO APPLY COUPON",
                                    "error"
                                );

                                applyCouponBtn.disabled = false;
                                applyCouponBtn.textContent = "APPLY";
                            }
                        });
                    }

                    function attachRemoveCoupon() {

                        const removeCouponBtn =
                            document.getElementById("removeCouponBtn");

                        if (!removeCouponBtn) {
                            return;
                        }

                        removeCouponBtn.addEventListener("click", async () => {

                            try {

                                removeCouponBtn.disabled = true;
                                removeCouponBtn.textContent = "REMOVING...";

                                const response = await fetch(
                                    "/checkout/remove-coupon",
                                    {
                                        method: "POST",
                                    }
                                );

                                const data = await response.json();

                                if (!response.ok || !data.success) {
                                    throw new Error(
                                        data.message || "FAILED TO REMOVE COUPON"
                                    );
                                }

                                // Reset discount
                                const subtotal = <%= subtotal %>;
                                const shipping = <%= shipping %>;
                                const tax = 0;

                                const total = subtotal + shipping + tax;

                                document.getElementById("discountLabel").textContent =
                                    "DISCOUNT";

                                document.getElementById("discountAmount").textContent =
                                    "-₹0";

                                document.getElementById("checkoutTotal").textContent =
                                    `₹${total.toLocaleString("en-IN")}`;

                                // Restore coupon input
                                document.getElementById("couponSection").innerHTML = `
    <div class="border border-primary p-4">

        <div class="flex justify-between items-center gap-4">

            <div>
                <p class="font-label-caps text-label-caps text-secondary mb-2">
                    APPLIED COUPON
                </p>

                <p class="font-mono-data text-mono-data font-bold">
                    ${data.coupon.code}
                </p>
            </div>

            <button
                type="button"
                id="removeCouponBtn"
                class="font-label-caps text-label-caps border border-primary px-4 py-2"
            >
                REMOVE
            </button>

        </div>

    </div>
`;

                                // Reattach Apply event
                                attachApplyCoupon();

                                showToast(
                                    "COUPON REMOVED SUCCESSFULLY",
                                    "success"
                                );

                            } catch (error) {

                                console.log(error);

                                showToast(
                                    error.message || "FAILED TO REMOVE COUPON",
                                    "error"
                                );

                                removeCouponBtn.disabled = false;
                                removeCouponBtn.textContent = "REMOVE";
                            }
                        });
                    }

                    attachApplyCoupon();
                    attachRemoveCoupon();
                    attachSelectedCoupon();

                </script>
</body>

</html>