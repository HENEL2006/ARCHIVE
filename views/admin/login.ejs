<!DOCTYPE html><html class="light" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>ARCHIVE | Admin Login</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "primary-fixed-dim": "#bec6e0",
                    "on-surface": "#191c1e",
                    "on-secondary-fixed-variant": "#38485d",
                    "on-error-container": "#93000a",
                    "tertiary": "#000000",
                    "outline": "#76777d",
                    "on-tertiary": "#ffffff",
                    "surface-dim": "#d8dadc",
                    "surface-variant": "#e0e3e5",
                    "surface-container-high": "#e6e8ea",
                    "error": "#ba1a1a",
                    "surface-container-low": "#f2f4f6",
                    "tertiary-fixed-dim": "#7bd0ff",
                    "primary-container": "#131b2e",
                    "on-primary-fixed-variant": "#3f465c",
                    "surface-container-highest": "#e0e3e5",
                    "outline-variant": "#c6c6cd",
                    "on-secondary-fixed": "#0b1c30",
                    "on-primary-container": "#7c839b",
                    "surface-tint": "#565e74",
                    "primary": "#000000",
                    "secondary-container": "#d0e1fb",
                    "secondary": "#505f76",
                    "tertiary-container": "#001e2c",
                    "secondary-fixed-dim": "#b7c8e1",
                    "surface-container": "#eceef0",
                    "surface-container-lowest": "#ffffff",
                    "secondary-fixed": "#d3e4fe",
                    "primary-fixed": "#dae2fd",
                    "surface": "#f7f9fb",
                    "on-surface-variant": "#45464d",
                    "background": "#f7f9fb",
                    "on-tertiary-container": "#008ebf",
                    "on-primary": "#ffffff",
                    "on-tertiary-fixed": "#001e2c",
                    "inverse-on-surface": "#eff1f3",
                    "inverse-primary": "#bec6e0",
                    "inverse-surface": "#2d3133",
                    "on-primary-fixed": "#131b2e",
                    "error-container": "#ffdad6",
                    "on-tertiary-fixed-variant": "#004c69",
                    "surface-bright": "#f7f9fb",
                    "tertiary-fixed": "#c4e7ff",
                    "on-error": "#ffffff",
                    "on-secondary": "#ffffff",
                    "on-background": "#191c1e",
                    "on-secondary-container": "#54647a"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "sm": "8px",
                    "base": "4px",
                    "margin": "32px",
                    "xl": "32px",
                    "lg": "24px",
                    "gutter": "24px",
                    "xs": "4px",
                    "2xl": "48px",
                    "md": "16px"
            },
            "fontFamily": {
                    "headline-lg": ["Inter"],
                    "body-md": ["Inter"],
                    "headline-md": ["Inter"],
                    "label-md": ["JetBrains Mono"],
                    "display": ["Inter"],
                    "body-sm": ["Inter"],
                    "headline-lg-mobile": ["Inter"],
                    "body-lg": ["Inter"]
            },
            "fontSize": {
                    "headline-lg": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "display": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "600"}],
                    "body-sm": ["12px", {"lineHeight": "16px", "fontWeight": "400"}],
                    "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .premium-shadow {
            box-shadow: 0px 4px 6px -1px rgba(0, 0, 0, 0.05), 0px 2px 4px -2px rgba(0, 0, 0, 0.05);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background text-on-surface antialiased overflow-hidden h-screen font-body-md">

    <%- include("partials/toast") %>

<!-- TopNavBar - Rendered as per JSON but without Global Nav Links as it's a transactional page -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-margin py-lg bg-transparent dark:bg-transparent">
<div class="font-headline-lg text-headline-lg font-black tracking-tight text-on-surface dark:text-surface-bright uppercase">ARCHIVE</div>
<div class="hidden md:flex items-center gap-md">
<a class="font-body-sm text-body-sm text-secondary hover:text-primary transition-colors cursor-pointer active:opacity-80" href="/">Back to Store</a>
</div>
</header>
<main class="flex h-full">
<!-- Left Panel: SaaS Aesthetic Marketing/Visuals -->
<section class="hidden lg:flex flex-1 bg-surface-container-low items-center justify-center p-2xl">
<div class="max-w-2xl w-full">
<div class="mb-xl">
<h1 class="font-display text-display text-primary mb-md">ARCHIVE ADMIN</h1>
<p class="font-body-lg text-body-lg text-secondary max-w-md">
                        Manage products, orders, inventory, customers, and store operations from one place.
                    </p>
</div>
<!-- Modern SaaS Illustration/Preview Card -->
<div class="relative bg-surface-container-lowest border border-outline-variant rounded-xl premium-shadow overflow-hidden p-md" style="transform: translate(4.92px, 4.57px);">
<div class="flex items-center gap-sm mb-lg border-b border-outline-variant pb-sm">
<div class="w-3 h-3 rounded-full bg-error/20 border border-error/40"></div>
<div class="w-3 h-3 rounded-full bg-secondary/20 border border-secondary/40"></div>
<div class="w-3 h-3 rounded-full bg-on-tertiary-container/20 border border-on-tertiary-container/40"></div>
</div>
<div class="space-y-md">
<div class="flex gap-md">
<div class="h-24 flex-1 bg-surface-container rounded-lg animate-pulse"></div>
<div class="h-24 flex-1 bg-surface-container rounded-lg animate-pulse"></div>
<div class="h-24 flex-1 bg-surface-container rounded-lg animate-pulse"></div>
</div>
<div class="h-32 w-full bg-surface-container rounded-lg animate-pulse"></div>
<div class="flex gap-md">
<div class="h-16 w-1/3 bg-surface-container rounded-lg animate-pulse"></div>
<div class="h-16 w-2/3 bg-surface-container rounded-lg animate-pulse"></div>
</div>
</div>
<!-- Overlay decorative element -->
<div class="absolute -bottom-8 -right-8 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
</div>
</div>
</section>
<!-- Right Panel: Login Container -->
<section class="flex-1 bg-surface-container-lowest flex items-center justify-center p-margin">
<div class="w-full max-w-[420px]">
<!-- Login Card -->
<div class="bg-surface-container-lowest p-xl rounded-xl border border-outline-variant premium-shadow">
<div class="mb-xl">
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Welcome Back</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Sign in to continue to the ARCHIVE Admin Panel.</p>
</div>
<form action="/admin/login" method="post" class="space-y-lg">
<!-- Email Input -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-on-surface block uppercase" for="email">Email Address</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline text-[18px]">mail</span>
<input class="w-full pl-2xl pr-md py-md bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg font-body-md outline-none transition-all placeholder:text-outline/50" id="email" name="email" placeholder="admin@archive.co" type="email">
</div>
</div>
<!-- Password Input -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-on-surface block uppercase" for="password">Password</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
<input class="w-full pl-2xl pr-md py-md bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg font-body-md outline-none transition-all placeholder:text-outline/50" id="password" name="password" placeholder="••••••••" type="password">
<button type="button" class="absolute right-md top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors flex items-center justify-center" onclick="const input = this.previousElementSibling; if (input.type === 'password') { input.type = 'text'; this.querySelector('span').textContent = 'visibility'; } else { input.type = 'password'; this.querySelector('span').textContent = 'visibility_off'; }"><span class="material-symbols-outlined text-[18px]">visibility_off</span></button></div>
</div>


<!-- login error field -->

<% if (error) { %>
<div class="mb-6 border-l-2 border-red-500 pl-4">
<p class="text-red-500 text-sm font-medium uppercase tracking-wider">
<%= error %>
</p>
</div>
<% } %>

<!-- Sign In Button -->
<button type="submit" class="w-full py-md bg-primary text-on-primary font-headline-md text-headline-md rounded-lg hover:bg-on-surface transition-all active:scale-[0.98] premium-shadow" type="submit">
                            Sign In
                        </button>
</form>
<!-- Mobile-only secondary action -->
<div class="mt-xl text-center md:hidden">
<a class="font-body-sm text-body-sm text-secondary hover:text-primary underline" href="#">Back to Store</a>
</div>
</div>
<!-- Footer text inside the container for layout balance -->
<div class="mt-xl text-center">
<p class="font-body-sm text-body-sm text-outline italic">Authorized personnel only.</p>
</div>
</div>
</section>
</main>
<!-- Footer - Positioned as per JSON but stylized for Login screen -->
<footer class="fixed bottom-0 right-0 w-full md:w-1/2 flex justify-center items-center py-lg px-margin pointer-events-none">
<div class="flex gap-xl pointer-events-auto">
<a class="font-body-sm text-body-sm text-outline hover:text-primary transition-colors cursor-pointer" href="#">Privacy Policy</a>
<a class="font-body-sm text-body-sm text-outline hover:text-primary transition-colors cursor-pointer" href="#">Terms of Service</a>
<a class="font-body-sm text-body-sm text-outline hover:text-primary transition-colors cursor-pointer" href="#">Support</a>
</div>
</footer>
<script>
        // Simple micro-interaction for the password visibility or input focus
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.querySelector('.material-symbols-outlined').style.color = '#000000';
            });
            input.addEventListener('blur', () => {
                input.parentElement.querySelector('.material-symbols-outlined').style.color = '#76777d';
            });
        });

        // Background decorative parallax-ish effect
        document.addEventListener('mousemove', (e) => {
            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;
            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;
            const previewCard = document.querySelector('.relative.bg-surface-container-lowest');
            if(previewCard) {
                previewCard.style.transform = `translate(${moveX}px, ${moveY}px)`;
            }
        });
    </script>


</body></html>