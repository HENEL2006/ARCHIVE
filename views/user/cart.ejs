                        "xl": "0px",
                        "full": "0px"
                    },
                    "spacing": {
                        "mobile-margin": "20px",
                        "grid-gutter": "0px",
                        "section-gap": "128px",
                        "unit": "8px",
                        "container-padding": "64px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
    <style>
        .grid-line-r {
            border-right: 1px solid #000000;
        }

        .grid-line-l {
            border-left: 1px solid #000000;
        }

        .grid-line-t {
            border-top: 1px solid #000000;
        }

        .grid-line-b {
            border-bottom: 1px solid #000000;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="bg-background text-on-background font-body-md selection:bg-primary selection:text-on-primary">
    <!-- TopNavBar -->
    <%- include("./partials/userHeader") %>
        <%- include("partials/toast") %>
            <main class="min-h-screen pt-[80px]">
                <!-- Hero Section -->
                <% if (cart && cart.items.length> 0) { %>

                    <header class="px-container-padding pt-16 pb-12 border-b border-primary">

                        <div class="max-w-4xl">

                            <h1 class="font-display-xl text-display-xl uppercase mb-4">
                                YOUR ARCHIVE
                            </h1>

                            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg">
                                Selected pieces from football history. Curated for the modern collector.
                            </p>

                        </div>

                    </header>

                    <% } %>
                        <!-- Cart Content Layout -->
                        <section class=" <%= cart && cart.items.length > 0
                        ? 'grid grid-cols-1 lg:grid-cols-12 items-start'
                        : 'flex items-center justify-center min-h-[83vh]'
                    %>">
                            <!-- Left Side: Items List -->
                            <div
                                class="lg:col-span-8 <%= cart && cart.items.length > 0 ? 'border-r border-primary' : '' %>">
                                <!-- Item 1: Manchester United -->
                                <% if (cart && cart.items.length> 0) { %>

                                    <% cart.items.forEach((item)=> { %>

                                        <div class="cart-item grid grid-cols-[180px_1fr] border-b border-primary"
                                            data-product-id="<%= item.product._id %>" data-size="<%= item.size %>">

                                            <!-- Image -->
                                            <div class="aspect-[4/5] overflow-hidden border-r border-primary">

                                                <img src="<%= item.product.images[0].url %>"
                                                    alt="<%= item.product.name %>" class="w-full h-full object-cover">

                                            </div>

                                            <!-- Details -->
                                            <div class="p-6 flex flex-col justify-between">

                                                <div>

                                                    <p
                                                        class="font-mono-data text-[10px] uppercase tracking-[0.18em] mb-2">
                                                        <%= item.product.category.name %>
                                                    </p>

                                                    <h2 class="font-display text-3xl uppercase leading-none mb-6">
                                                        <%= item.product.name %>
                                                    </h2>

                                                    <div class="space-y-1 font-mono-data text-[11px] uppercase">

                                                        <p>
                                                            Size :
                                                            <%= item.size %>
                                                        </p>

                                                        <div class="quantity-control flex items-center gap-6 mt-8"
                                                            data-product-id="<%= item.product._id %>"
                                                            data-size="<%= item.size %>" data-price="<%= item.price %>">

                                                            <!-- Decrease -->
                                                            <button type="button"
                                                                class="decrease-btn text-[26px] font-light leading-none hover:opacity-50 transition">
                                                                −
                                                            </button>


                                                            <!-- Quantity -->
                                                            <span
                                                                class="quantity-value font-mono-data text-base w-6 text-center">
                                                                <%= item.quantity %>
                                                            </span>


                                                            <!-- Increase -->
                                                            <button type="button"
                                                                class="increase-btn text-[24px] font-light leading-none hover:opacity-50 transition">
                                                                +
                                                            </button>

                                                        </div>

                                                        <p>
                                                            Price :
                                                            ₹<%= item.price.toLocaleString() %>
                                                        </p>

                                                    </div>

                                                </div>

                                                <button type="button"
                                                    class="remove-cart-btn mt-6 text-[11px] uppercase tracking-[0.18em] hover:underline"
                                                    data-product-id="<%= item.product._id %>"
                                                    data-size="<%= item.size %>">
                                                    REMOVE
                                                </button>

                                            </div>

                                        </div>

                                        <% }) %>

                                            <% } else { %>

                                                <div class="max-w-2xl text-center px-8">

                                                    <p
                                                        class="font-mono-data text-[11px] uppercase tracking-[0.28em] text-neutral-500 mb-6">
                                                        Cart
                                                    </p>

                                                    <h2 class="font-display text-6xl leading-none uppercase mb-8">
                                                        Your Archive<br>Is Empty
                                                    </h2>

                                                    <p
                                                        class="font-body-md text-[15px] leading-8 text-neutral-600 max-w-xl mx-auto mb-14">
                                                        Every archive begins with a single acquisition.
                                                        Explore iconic football shirts curated across generations
                                                        and start building your collection.
                                                    </p>

                                                    <a href="/products"
                                                        class="inline-flex items-center justify-center border border-black px-12 py-5 font-mono-data text-[11px] uppercase tracking-[0.25em] hover:bg-black hover:text-white transition-all duration-300">

                                                        Explore Collection

                                                    </a>

                                                </div>

                                                <% } %>
                            </div>
                            <!-- Right Side: Order Summary -->
                            <% if (cart && cart.items.length> 0) { %>
                                <aside
                                    class="lg:col-span-4 p-8 lg:p-12 sticky top-16 bg-surface-container-low border-b lg:border-b-0 border-primary h-fit">
                                    <div class="mb-8 pb-4 border-b border-primary">
                                        <h2 class="font-headline-md text-headline-md uppercase">ORDER SUMMARY</h2>
                                    </div>
                                    <div class="space-y-4 font-mono-data text-sm">
                                        <div class="flex justify-between">
                                            <span class="uppercase">SUBTOTAL</span>
                                            <span id="cart-subtotal">₹<%= subtotal.toLocaleString() %></span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="uppercase">SHIPPING CHARGE</span>
                                            <span id="cart-shipping">
                                                ₹<%= shipping.toLocaleString() %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="uppercase">DISCOUNT</span>
                                            <span id="cart-discount">
                                                ₹<%= discount.toLocaleString() %>
                                            </span>
                                        </div>
                                        <div
                                            class="flex justify-between pt-6 mt-6 border-t border-primary font-headline-md text-2xl">
                                            <span class="uppercase">TOTAL</span>
                                            <span id="cart-total">
                                                ₹<%= total.toLocaleString() %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-12 space-y-4">
                                        <a href="/checkout"
                                            class="block w-full bg-primary text-on-primary py-5 text-center font-label-caps text-label-caps hover:bg-on-surface-variant transition-none active:translate-y-[1px]">

                                            PROCEED TO CHECKOUT

                                        </a>
                                        <a href="/products"
                                            class="block w-full border border-primary text-primary py-5 text-center font-label-caps text-label-caps hover:bg-primary hover:text-on-primary transition-none active:translate-y-[1px]">

                                            CONTINUE BROWSING

                                        </a>
                                    </div>
                                </aside>
                                <% } %>
                        </section>
                        <!-- Trust Section -->
                        <!-- <section class="grid grid-cols-1 md:grid-cols-3 border-b border-primary bg-background">
                    <div class="p-8 border-r border-primary flex flex-col items-center text-center">
                        <span class="material-symbols-outlined text-3xl mb-3">verified</span>
                        <h4 class="font-label-caps text-label-caps text-[10px] uppercase mb-1">Authenticity Guaranteed
                        </h4>
                        <p class="font-body-md text-[12px] text-on-surface-variant">Verified by in-house experts.</p>
                    </div>
                    <div class="p-8 border-r border-primary flex flex-col items-center text-center">
                        <span class="material-symbols-outlined text-3xl mb-3">lock</span>
                        <h4 class="font-label-caps text-label-caps text-[10px] uppercase mb-1">Secure Checkout</h4>
                        <p class="font-body-md text-[12px] text-on-surface-variant">Encrypted global gateways.</p>
                    </div>
                    <div class="p-8 flex flex-col items-center text-center">
                        <span class="material-symbols-outlined text-3xl mb-3">public</span>
                        <h4 class="font-label-caps text-label-caps text-[10px] uppercase mb-1">Worldwide Shipping</h4>
                        <p class="font-body-md text-[12px] text-on-surface-variant">Delivery to 150+ countries.</p>
                    </div>
                </section> -->
                        <!-- Editorial Statement -->
                        <section
                            class="py-24 px-container-padding text-center border-b border-primary bg-primary text-on-primary">
                            <h2 class="font-display-xl text-display-xl uppercase leading-none tracking-widest">FOOTBALL.
                                CULTURE. MEMORY.</h2>
                        </section>
            </main>
            <!-- Footer -->
            <%- include("partials/userFooter") %>
                <script>
                    // Simple micro-interactions maintained
                    document.querySelectorAll('button').forEach(button => {
                        button.addEventListener('mousedown', () => {
                            button.style.transform = 'translateY(1px)';
                        });
                        button.addEventListener('mouseup', () => {
                            button.style.transform = 'translateY(0px)';
                        });
                    });

                    // ==========================================
                    // INCREASE / DECREASE CART QUANTITY
                    // ==========================================

                    document.querySelectorAll(".quantity-control").forEach((control) => {

                        const decreaseBtn = control.querySelector(".decrease-btn");
                        const increaseBtn = control.querySelector(".increase-btn");
                        const quantityValue = control.querySelector(".quantity-value");

                        const productId = control.dataset.productId;
                        const size = control.dataset.size;

                        decreaseBtn.addEventListener("click", () => {

                            const quantity = Number(quantityValue.textContent.trim());

                            if (quantity <= 1) {
                                showToast("MINIMUM QUANTITY IS 1", "error");
                                return;
                            }

                            updateQuantity(
                                productId,
                                size,
                                "decrease",
                                control,
                                quantityValue
                            );

                        });


                        increaseBtn.addEventListener("click", () => {

                            updateQuantity(
                                productId,
                                size,
                                "increase",
                                control,
                                quantityValue
                            );

                        });

                        updateDecreaseButton(control);
                    });



                    async function updateQuantity(
                        productId,
                        size,
                        action,
                        control,
                        quantityValue
                    ) {

                        const buttons = control.querySelectorAll("button");

                        try {

                            // Prevent multiple clicks while request is running
                            buttons.forEach((button) => {
                                button.disabled = true;
                            });


                            const response = await fetch("/cart/update", {

                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                },

                                body: JSON.stringify({
                                    productId,
                                    size,
                                    action,
                                }),

                            });


                            const data = await response.json();


                            if (!response.ok || !data.success) {

                                showToast(data.message, "error");

                                return;
                            }


                            // Update quantity on screen
                            let quantity =
                                Number(quantityValue.textContent.trim());


                            if (action === "increase") {
                                quantity++;
                            }

                            if (action === "decrease") {
                                quantity--;
                            }


                            quantityValue.textContent = quantity;

                            updateDecreaseButton(control);


                            // Update order summary
                            updateCartSummary(data);


                            showToast(data.message, "success");


                        } catch (error) {

                            console.error(error);

                            showToast(
                                "SOMETHING WENT WRONG",
                                "error"
                            );

                        } finally {

                            buttons.forEach((button) => {
                                button.disabled = false;
                            });

                            updateDecreaseButton(control);

                        }

                    }

                    function updateDecreaseButton(control) {

                        const decreaseBtn =
                            control.querySelector(".decrease-btn");

                        const quantityValue =
                            control.querySelector(".quantity-value");

                        const quantity =
                            Number(quantityValue.textContent.trim());

                        decreaseBtn.disabled = quantity <= 1;

                        decreaseBtn.classList.toggle(
                            "opacity-30",
                            quantity <= 1
                        );

                        decreaseBtn.classList.toggle(
                            "cursor-not-allowed",
                            quantity <= 1
                        );
                    }


                    // ==========================================
                    // REMOVE CART ITEM
                    // ==========================================

                    document.querySelectorAll(".remove-cart-btn").forEach((button) => {

                        button.addEventListener("click", async () => {

                            const productId = button.dataset.productId;
                            const size = button.dataset.size;

                            const cartItem =
                                button.closest(".cart-item");


                            try {

                                button.disabled = true;


                                const response = await fetch("/cart/remove", {

                                    method: "POST",

                                    headers: {
                                        "Content-Type": "application/json",
                                    },

                                    body: JSON.stringify({
                                        productId,
                                        size,
                                    }),

                                });


                                const data = await response.json();


                                if (!response.ok || !data.success) {

                                    showToast(data.message, "error");

                                    return;
                                }


                                // Remove the product from the page
                                cartItem.remove();


                                // Update totals
                                updateCartSummary(data);


                                showToast(data.message, "success");


                                // If cart is now empty
                                const remainingItems =
                                    document.querySelectorAll(".cart-item");


                                if (remainingItems.length === 0) {

                                    window.location.reload();

                                }


                            } catch (error) {

                                console.error(error);

                                showToast(
                                    "SOMETHING WENT WRONG",
                                    "error"
                                );

                            } finally {

                                button.disabled = false;

                            }

                        });

                    });


                    // ==========================================
                    // UPDATE ORDER SUMMARY
                    // ==========================================

                    function updateCartSummary(data) {

                        document.getElementById("cart-subtotal").textContent =
                            `₹${data.subtotal.toLocaleString()}`;

                        document.getElementById("cart-shipping").textContent =
                            `₹${data.shipping.toLocaleString()}`;

                        document.getElementById("cart-discount").textContent =
                            `₹${data.discount.toLocaleString()}`;

                        document.getElementById("cart-total").textContent =
                            `₹${data.total.toLocaleString()}`;

                    }
                </script>


</body>

</html>