<div id="password-error-flag" data-error="<%= passwordError ? 'true' : 'false' %>" hidden>
</div>
<script>
    // Simple micro-interaction for form inputs
    const inputs = document.querySelectorAll('input, select');
    inputs.forEach(input => {
        input.addEventListener('focus', () => {
            input.parentElement.classList.add('opacity-100');
        });
        input.addEventListener('blur', () => {
            input.parentElement.classList.remove('opacity-100');
        });
    });

    // Toggle handling logic for visuals
    const toggles = document.querySelectorAll('input[type="checkbox"]');
    toggles.forEach(toggle => {
        toggle.addEventListener('change', function () {
            const parent = this.closest('.group');
            if (this.checked) {
                parent.classList.add('bg-surface-container-low');
            } else {
                parent.classList.remove('bg-surface-container-low');
            }
        });
    });

    const navLinks = {
        profile: document.getElementById("nav-profile"),
        security: document.getElementById("nav-security"),
        actions: document.getElementById("nav-actions"),
    };

    console.log(navLinks)

    Object.entries(navLinks).forEach(([id, link]) => {
        link.addEventListener("click", () => {
            // Let the scroll event update the active state.
        });
    });

    const links = document.querySelectorAll(".side-link");

    function activate(id) {
        console.log(id)
        links.forEach(link => {
            link.classList.remove("active");
        });

        document.getElementById(`nav-${id}`).classList.add("active");
    }

    const sections = [
        document.getElementById("profile"),
        document.getElementById("security"),
        document.getElementById("actions")
    ];

    window.addEventListener("scroll", () => {

        let current = "profile";

        sections.forEach(section => {

            const rect = section.getBoundingClientRect();

            if (rect.top <= 150 && rect.bottom >= 150) {
                current = section.id;
            }

        });

        activate(current);

    });

    activate("profile");

    // password live validator

    console.log("Password validator started");

    const passwordInput = document.getElementById("new_password");
    const form = document.getElementById("password-form");


    console.log(passwordInput);
    console.log(form);


    const rules = {
        "length-rule": () => passwordInput.value.length >= 6,
        "uppercase-rule": () => /[A-Z]/.test(passwordInput.value),
        "number-rule": () => /[0-9]/.test(passwordInput.value),
        "special-rule": () =>
            /[!@#$%^&*(),.?":{}|<>]/.test(passwordInput.value),
    };

    passwordInput.addEventListener("input", () => {

        Object.keys(rules).forEach((ruleId) => {
            updateRule(
                ruleId,
                rules[ruleId](),
                false
            );
        });

    });

    form.addEventListener("submit", (e) => {

        let allValid = true;

        Object.keys(rules).forEach((ruleId) => {

            const valid = rules[ruleId]();

            updateRule(
                ruleId,
                valid,
                true
            );

            if (!valid) {
                allValid = false;
            }

        });

        if (!allValid) {
            e.preventDefault();
        }

    });

    function updateRule(
        ruleId,
        valid,
        submitted
    ) {

        const rule =
            document.getElementById(ruleId);

        const icon =
            rule.querySelector(
                ".material-symbols-outlined"
            );

        rule.classList.remove(
            "text-surface-dim",
            "text-primary",
            "text-red-500"
        );

        if (valid) {

            icon.textContent =
                "check_circle";

            rule.classList.add(
                "text-primary"
            );

        }
        else {

            icon.textContent =
                "circle";

            if (submitted) {

                rule.classList.add(
                    "text-red-500"
                );

            }
            else {

                rule.classList.add(
                    "text-surface-dim"
                );

            }

        }
    }

    const modal = document.getElementById("changeEmailModal");

    const openBtn = document.getElementById("change-email-btn");
    const closeBtn = document.getElementById("closeEmailModal");
    const cancelBtn = document.getElementById("cancelEmailModal");

    function openModal() {

        modal.classList.remove("hidden");

        modal.classList.add("flex");

        requestAnimationFrame(() => {
            modal.classList.add("show");
        });

    }

    function closeModal() {

        modal.classList.remove("show");

        setTimeout(() => {

            modal.classList.remove("flex");

            modal.classList.add("hidden");

        }, 220);

    }

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    cancelBtn.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
        if (e.target === modal) {
            closeModal();
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            closeModal();
        }
    });

    function togglePassword(inputId, button) {
        const input = document.getElementById(inputId);

        if (input.type === "password") {
            input.type = "text";
            button.textContent = "visibility_off";
        } else {
            input.type = "password";
            button.textContent = "visibility";
        }
    }

    const hasPasswordError =
        document
            .getElementById("password-error-flag")
            .dataset.error === "true";

    if (hasPasswordError) {
        document.getElementById("security").scrollIntoView({
            behavior: "smooth",
            block: "start",
        });
    }
</script>

</html>