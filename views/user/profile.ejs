<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            background-color: #fcf9f8;
            color: #000000;
        }

        /* Custom scrollbar for brand consistency */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #fcf9f8;
        }

        ::-webkit-scrollbar-thumb {
            background: #000000;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#848484",
                        "inverse-primary": "#c6c6c6",
                        "on-error": "#ffffff",
                        "surface-bright": "#fcf9f8",
                        "inverse-on-surface": "#f3f0ef",
                        "on-tertiary": "#ffffff",
                        "background": "#fcf9f8",
                        "outline-variant": "#cfc4c5",
                        "outline": "#7e7576",
                        "accent-success": "#22CD5B",
                        "error": "#ba1a1a",
                        "tertiary-container": "#1b1b1b",
                        "secondary-fixed-dim": "#c6c6c7",
                        "secondary-fixed": "#e2e2e2",
                        "secondary-container": "#dfe0e0",
                        "on-tertiary-fixed": "#1b1b1b",
                        "surface-dim": "#dcd9d9",
                        "primary-fixed": "#e2e2e2",
                        "on-surface-variant": "#4c4546",
                        "primary": "#000000",
                        "primary-container": "#1b1b1b",
                        "surface-container-high": "#ebe7e7",
                        "on-surface": "#1c1b1b",
                        "inverse-surface": "#313030",
                        "on-tertiary-fixed-variant": "#474747",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#454747",
                        "on-secondary-fixed": "#1a1c1c",
                        "on-background": "#1c1b1b",
                        "secondary": "#5d5f5f",
                        "surface-tint": "#5e5e5e",
                        "surface": "#fcf9f8",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "surface-container": "#f0edec",
                        "tertiary": "#000000",
                        "surface-container-highest": "#e5e2e1",
                        "on-secondary-container": "#616363",
                        "on-secondary": "#ffffff",
                        "on-tertiary-container": "#848484",
                        "surface-container-low": "#f6f3f2",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#e2e2e2",
                        "primary-fixed-dim": "#c6c6c6",
                        "surface-container-lowest": "#ffffff",
                        "on-primary-fixed-variant": "#474747",
                        "on-primary-fixed": "#1b1b1b",
                        "on-error-container": "#93000a",
                        "surface-variant": "#e5e2e1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "unit": "8px",
                        "grid-gutter": "0px",
                        "section-gap": "128px",
                        "mobile-margin": "20px",
                        "container-padding": "64px"
                    },
                    "fontFamily": {
                        "display-xl": ["Syne"],
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "headline-lg-mobile": ["Syne"],
                        "body-md": ["Space Mono"],
                        "headline-md": ["Syne"],
                        "headline-lg": ["Syne"]
                    },
                    "fontSize": {
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }]
                    }
                },
            },
        }
    </script>
</head>

<body class="font-body-md text-on-background selection:bg-primary selection:text-surface">
    <!-- TopNavBar -->
    %<%- include("partials/userHeader") %>
        <!-- Hero Section -->
        <header class="border-b border-primary px-container-padding py-16 grid grid-cols-12">
            <div class="col-span-12 md:col-span-8">
                <h1 class="font-headline-lg text-headline-lg mb-4">MY ACCOUNT</h1>
                <div class="flex flex-col md:flex-row md:items-end gap-4 md:gap-12">
                    <div>
                        <p class="font-syne text-headline-md leading-none"><%= user.username %></p>
                        <p class=" mt-1 text-mono-data opacity-60"><%= user.email %></p>
                    </div>
                    <div class="border-l border-primary pl-6 md:pl-12">
                        <p class="font-label-caps text-label-caps opacity-40 mb-1">MEMBER STATUS</p>
                        <p class="font-mono-data text-mono-data">SINCE OCT 2024</p>
                    </div>
                </div>
            </div>
        </header>
        <!-- Quick Access Grid -->
        <section class="grid grid-cols-1 md:grid-cols-2 border-b border-primary">
            <!-- Orders -->
            <a class="group border-r border-primary border-b md:border-b-0 p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="#">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl" data-icon="package_2">package_2</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">ORDERS</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">VIEW AND TRACK YOUR RECENT PURCHASES AND
                        HISTORY.</p>
                </div>
            </a>
            <!-- Wishlist -->
            <a class="group p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="#">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl" data-icon="favorite">favorite</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">WISHLIST</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">ITEMS YOU HAVE SAVED FOR FUTURE
                        ACQUISITION.</p>
                </div>
            </a>
            <!-- Addresses -->
            <a class="group border-t border-r border-primary p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="/address">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl" data-icon="location_on">location_on</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">ADDRESSES</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">MANAGE SHIPPING AND BILLING DESTINATIONS.
                    </p>
                </div>
            </a>
            <!-- Account Settings -->
            <a class="group border-t border-primary p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="/account-settings">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl" data-icon="settings">settings</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">ACCOUNT SETTINGS</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">UPDATE PERSONAL INFORMATION AND SECURITY
                        PREFERENCES.</p>
                </div>
            </a>
            <!-- Wallet -->
            <a class="group border-t border-r border-primary p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="#">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl"
                        data-icon="account_balance_wallet">account_balance_wallet</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">WALLET</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">MANAGE STORE CREDIT, GIFT CARDS, AND
                        PAYMENT METHODS.</p>
                </div>
            </a>
            <!-- Logout -->
            <a class="group border-t border-primary p-container-padding hover:bg-primary hover:text-surface transition-none flex flex-col justify-between aspect-square md:aspect-auto h-[320px]"
                href="/logout">
                <div class="flex justify-between items-start">
                    <span class="material-symbols-outlined text-4xl" data-icon="logout">logout</span>
                    <span class="material-symbols-outlined opacity-0 group-hover:opacity-100 transition-none"
                        data-icon="arrow_outward">arrow_outward</span>
                </div>
                <div>
                    <h3 class="font-label-caps text-label-caps mb-2">LOGOUT</h3>
                    <p class="font-body-md opacity-60 group-hover:opacity-100">TERMINATE THE CURRENT SESSION SECURELY.
                    </p>
                </div>
            </a>
        </section>
        <!-- Recent Orders -->

        </main>
        <!-- Footer -->
        <%- include("partials/userFooter") %>
            <script>
                // Simple micro-interaction for icons
                document.querySelectorAll('.material-symbols-outlined').forEach(icon => {
                    icon.addEventListener('mouseenter', () => {
                        icon.style.fontVariationSettings = "'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24";
                    });
                    icon.addEventListener('mouseleave', () => {
                        if (!icon.classList.contains('underline')) {
                            icon.style.fontVariationSettings = "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24";
                        }
                    });
                });

                // Initialize person icon fill as it's active
                const personIcon = document.querySelector('[data-icon="person"]');
                if (personIcon) {
                    personIcon.style.fontVariationSettings = "'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24";
                }
            </script>


</body>

</html>