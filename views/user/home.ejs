            background: #000000;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Typography Polish */
        .font-elegant {
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.02em;
        }

        .font-technical {
            font-family: 'Space Mono', monospace;
            letter-spacing: -0.03em;
        }

        .brutalist-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: -1px;
            background: #ffffff;
            border: 1px solid #000000;
            z-index: 100;
            border-radius: 0;
            box-shadow: none;
            transition: opacity 0.1s ease-in-out;
        }

        .group:hover>.brutalist-dropdown {
            display: flex;
        }

        .dropdown-item {
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            padding: 8px 16px;
            color: #000000;
            transition: background 0.1s, color 0.1s;
            white-space: nowrap;
            text-transform: lowercase;
        }

        .dropdown-item:hover {
            background: #000000;
            color: #ffffff;
        }

        .mega-menu {
            width: 500px;
            padding: 0;
            flex-direction: row;
        }

        .mega-column {
            flex: 1;
            padding: 20px;
            border-right: 1px solid #000000;
        }

        .mega-column:last-child {
            border-right: none;
        }

        .mega-header {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 12px;
            border-bottom: 1px solid #000000;
            padding-bottom: 4px;
