<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>SIGN IN | ARCHIVE</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              mono: ['"Space Mono"', "ui-monospace", "monospace"],
              display: ['"Syne"', "system-ui", "sans-serif"],
            },
            colors: {
              cream: "#fcfbf8",
            },
          },
        },
      };
    </script>
    <style>
      .custom-checkbox:checked + .checkbox-ui {
        background: black;
      }

      .custom-checkbox:checked + .checkbox-ui svg {
        display: block;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .grid-line-v {
        border-right: 1px solid #000000;
      }
      .grid-line-h {
        border-bottom: 1px solid #000000;
      }
      input:focus {
        outline: none !important;
        box-shadow: none !important;
        border-bottom: 2px solid #000000 !important;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body class="h-screen overflow-hidden bg-cream font-mono text-black">
    <div
      id="toast"
      class="fixed top-8 left-1/2 -translate-x-1/2 -translate-y-20 opacity-0 z-50 transition-all duration-500 ease-out backdrop-blur-md bg-white/80 border border-black/10 shadow-lg px-5 py-3 rounded-full flex items-center gap-3"
    >
      <div
        class="w-6 h-6 rounded-full border border-black flex items-center justify-center text-[10px]"
      >
        ✓
      </div>

      <p
        id="toast-message"
        class="text-[10px] uppercase tracking-[0.25em] whitespace-nowrap text-black font-bold"
      ></p>
    </div>
    <%- include('./partials/header') %>

    <main class="h-[calc(100vh-57px)] flex">
      <!-- Left Side: Editorial Image -->
      <section class="group relative w-1/2 h-full border-r border-black/80 overflow-hidden">
        <img
          src="/images/login-img.jpg"
          alt="Archive editorial"
          class="absolute inset-0 h-full w-full object-cover grayscale contrast-125 brightness-95 transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
        <!-- Atmospheric Faded Typography -->
        <!-- <div
          class="absolute inset-0 h-full w-full object-cover grayscale contrast-125 brightness-95 transition-transform duration-700 ease-out"
        >
          <div
            class="font-display text-[10rem] uppercase leading-none opacity-10 mb-8 break-words tracking-[-0.08em]"
          >
            FOOTBALL.<br />CULTURE.<br />MEMORY.
          </div>
          <div class="border-l-4 border-primary pl-6 py-2">
            <p class="font-display text-3xl italic tracking-[-0.03em]">
              "Every jersey tells a story."
            </p>
          </div>
        </div> -->
      </section>
      <!-- Right Side: Sign In Form -->
      <section
    id="login-form-section"
    class="w-1/2 flex flex-col justify-center px-20 py-10 h-full overflow-y-auto"
>
        <div class="max-w-md w-full mx-auto space-y-12">
          <!-- Headline -->
          <div class="space-y-4">
            <h1 class="font-display text-6xl tracking-wide uppercase">
              WELCOME BACK
            </h1>
            <p
              class="font-mono text-[13px] tracking-[0.12em] text-black/70 leading-8"
            >
              Access your archive, track orders, save favorites, and discover
              curated football history.
            </p>
          </div>
          <!-- Form -->
          <form class="space-y-8" action="/login" method="post">
            <div class="space-y-6">
              <div class="group relative">
                <label
                  class="block text-[10px] uppercase tracking-[0.25em] text-black/60 mb-3"
                  >Email Address</label
                >
                <input
                  class="w-full border-0 border-b border-black/30 bg-transparent py-4 px-0 text-[13px] tracking-[0.12em] placeholder:text-black/35 focus:outline-none focus:border-black transition-all duration-300"
                  placeholder="USER@ARCHIVE-SPEC.COM"
                  type="email"
                  name="email"
                />
              </div>
              <div class="group relative">
                <div class="flex items-center justify-between mb-3">
                  <label
                    class="block text-[10px] uppercase tracking-[0.25em] text-black/60 mb-3"
                    >Password</label
                  >
                  <a
                    href="/forgot-password"
                    class="text-[10px] uppercase tracking-[0.2em] text-black/50 transition-opacity duration-300 hover:opacity-100"
                  >
                    Forgot Password?
                  </a>
                </div>
                <input
                  class="w-full border-0 border-b border-black/30 bg-transparent py-4 px-0 text-[13px] tracking-[0.12em] placeholder:text-black/35 focus:outline-none focus:border-black transition-all duration-300"
                  placeholder="••••••••••••"
                  type="password"
                  name="password"
                /><button
                  type="button"
                  class="absolute right-0 bottom-4 text-primary opacity-60 hover:opacity-100 transition-opacity"
                  onclick="
                    const input = this.previousElementSibling;
                    if (input.type === 'password') {
                      input.type = 'text';
                      this.children[0].textContent = 'visibility';
                    } else {
                      input.type = 'password';
                      this.children[0].textContent = 'visibility_off';
                    }
                  "
                >
                  <span class="material-symbols-outlined">visibility_off</span>
                </button>
              </div>
            </div>
            <div class="flex items-center gap-3 whitespace-nowrap">
              <label class="flex items-center gap-3 cursor-pointer select-none">
                <input
                  id="remember"
                  name="remember"
                  type="checkbox"
                  class="custom-checkbox hidden"
                />

                <div
                  class="checkbox-ui w-4 h-4 border border-black flex items-center justify-center"
                >
                  <svg
                    class="hidden w-2.5 h-2.5 text-white"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M16.704 5.29a1 1 0 010 1.42l-8 8a1 1 0 01-1.42 0l-4-4a1 1 0 111.42-1.42L8 12.59l7.29-7.3a1 1 0 011.414 0z"
                    />
                  </svg>
                </div>

                <span
                  class="text-[10px] uppercase tracking-[0.2em] text-black/70"
                >
                  Remember Me
                </span>
              </label>
            </div>
            <div class="space-y-4 pt-4">
              <% if(typeof error !== "undefined" && error){ %>
                <p
                    id="login-error"
                    class="text-center text-[10px] tracking-[0.2em] uppercase text-red-500"
                    >
                    <%= error %>
                </p>
              <% } %>
              <button
                class="w-full border border-black bg-black py-5 text-[11px] tracking-[0.35em] text-white uppercase transition-all duration-300 hover:bg-transparent hover:text-black"
                type="submit"
              >
                SIGN IN
              </button>
            </div>
          </form>
          <!-- Footer Link -->
          <div class="text-center md:text-left">
            <p
              class="text-center text-[10px] tracking-[0.2em] text-black/60 uppercase"
            >
              Don't have an account?
              <a
                class="text-black font-bold underline decoration-2 underline-offset-4 transition-opacity duration-300 hover:opacity-60"
                href="/signup"
              >
                JOIN THE ARCHIVE
              </a>
              >
            </p>
          </div>
          <!-- Benefits Section (Technical Grid) -->
        </div>
      </section>
    </main>
    <!-- Footer -->

    <script>
      // Micro-interactions and subtle visual effects
      document.addEventListener("DOMContentLoaded", () => {
        const inputs = document.querySelectorAll("input");

        inputs.forEach((input) => {
          input.addEventListener("focus", () => {
            input.parentElement
              .querySelector("label")
              .classList.add("text-primary");
            input.parentElement
              .querySelector("label")
              .classList.remove("opacity-60");
          });

          input.addEventListener("blur", () => {
            if (input.value === "") {
              input.parentElement
                .querySelector("label")
                .classList.remove("text-primary");
              input.parentElement
                .querySelector("label")
                .classList.add("opacity-60");
            }
          });
        });

        // Smooth simple hover inversion logic
        const primaryBtns = document.querySelectorAll("button.bg-primary");
        primaryBtns.forEach((btn) => {
          btn.addEventListener("mousedown", () => {
            btn.classList.add("scale-[0.98]");
          });
          btn.addEventListener("mouseup", () => {
            btn.classList.remove("scale-[0.98]");
          });
        });
      });

      const errorElement = document.getElementById("login-error");
      const formSection = document.getElementById("login-form-section");

      if (errorElement && errorElement.textContent.trim()) {
        formSection.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }
      function showToast(message) {
    const toast = document.getElementById("toast");
    const toastMessage = document.getElementById("toast-message");

    toastMessage.textContent = message;

    toast.classList.remove("-translate-y-20", "opacity-0");
    toast.classList.add("translate-y-0", "opacity-100");

    setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("-translate-y-20", "opacity-0");
    }, 2500);
}

     const toastMessage = "<%= toast || '' %>";

if (toastMessage) {
    const type = toastMessage.includes("INVALID") ||
                 toastMessage.includes("EXPIRED")
                 ? "error"
                 : "success";

    showToast(toastMessage, type);
}
    </script>
  </body>
</html>
