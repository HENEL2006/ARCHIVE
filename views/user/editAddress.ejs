<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <title>ARCHIVE | ADD NEW ADDRESS</title>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .watermark {
            pointer-events: none;
            user-select: none;
            opacity: 0.03;
            z-index: -1;
            white-space: nowrap;
        }

        input:focus {
            outline: none !important;
            box-shadow: none !important;
        }

        .custom-checkbox {
            appearance: none;
            width: 16px;
            height: 16px;
            border: 1px solid #000;
            position: relative;
            cursor: pointer;
            border-radius: 0;
        }

        .custom-checkbox:checked {
            background-color: #000;
        }

        .custom-checkbox:checked::after {
            content: 'X';
            color: #fff;
            font-family: 'Space Mono';
            font-size: 10px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-fixed-variant": "#474747",
                        "tertiary-fixed-dim": "#c6c6c6",
                        "on-tertiary-fixed": "#1b1b1b",
                        "on-background": "#1c1b1b",
                        "on-surface-variant": "#4c4546",
                        "on-secondary-container": "#616363",
                        "on-surface": "#1c1b1b",
                        "surface-variant": "#e5e2e1",
                        "inverse-on-surface": "#f3f0ef",
                        "surface-container-high": "#ebe7e7",
                        "primary-fixed": "#e2e2e2",
                        "primary": "#000000",
                        "error": "#ba1a1a",
                        "inverse-primary": "#c6c6c6",
                        "background": "#fcf9f8",
                        "surface": "#fcf9f8",
                        "surface-container-low": "#f6f3f2",
                        "on-primary-fixed": "#1b1b1b",
                        "accent-success": "#22CD5B",
                        "on-primary-container": "#848484",
                        "outline-variant": "#cfc4c5",
                        "surface-container": "#f0edec",
                        "outline": "#7e7576",
                        "on-primary": "#ffffff",
                        "inverse-surface": "#313030",
                        "surface-dim": "#dcd9d9",
                        "on-tertiary": "#ffffff",
                        "on-error-container": "#93000a",
                        "on-secondary-fixed-variant": "#454747",
                        "error-container": "#ffdad6",
                        "primary-fixed-dim": "#c6c6c6",
                        "on-tertiary-fixed-variant": "#474747",
                        "on-secondary-fixed": "#1a1c1c",
                        "surface-container-lowest": "#ffffff",
                        "secondary": "#5d5f5f",
                        "tertiary-container": "#1b1b1b",
                        "secondary-fixed": "#e2e2e2",
                        "tertiary-fixed": "#e2e2e2",
                        "on-error": "#ffffff",
                        "surface-container-highest": "#e5e2e1",
                        "secondary-container": "#dfe0e0",
                        "on-tertiary-container": "#848484",
                        "surface-tint": "#5e5e5e",
                        "secondary-fixed-dim": "#c6c6c7",
                        "surface-bright": "#fcf9f8",
                        "primary-container": "#1b1b1b",
                        "on-secondary": "#ffffff",
                        "tertiary": "#000000"
                    },
                    "borderRadius": {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "0px"
                    },
                    "spacing": {
                        "grid-gutter": "0px",
                        "container-padding": "64px",
                        "section-gap": "128px",
                        "mobile-margin": "20px",
                        "unit": "8px"
                    },
                    "fontFamily": {
                        "body-lg": ["Space Mono"],
                        "mono-data": ["Space Mono"],
                        "display-xl": ["Syne"],
                        "headline-lg-mobile": ["Syne"],
                        "headline-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Space Mono"],
                        "label-caps": ["Space Mono"],
                        "display": ['"Syne"', 'system-ui', 'sans-serif'],
                    },
                    "fontSize": {
                        "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.1em", "fontWeight": "700" }],
                        "body-md": ["14px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-lg-mobile": ["32px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "mono-data": ["12px", { "lineHeight": "1.0", "letterSpacing": "-0.02em", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.2", "letterSpacing": "0.03em", "fontWeight": "700" }],
                        "headline-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "0.04em", "fontWeight": "700" }],
                        "display-xl": ["80px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "800" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-surface text-primary font-body-md selection:bg-primary selection:text-on-primary">
    <!-- Header / TopNavBar -->
    <%- include("partials/userHeader") %>
        <!-- Watermark Background -->
        <div
            class="watermark fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rotate-[-20deg] font-display-xl text-display-xl uppercase select-none">
            FOOTBALL. CULTURE. MEMORY. FOOTBALL. CULTURE. MEMORY.
        </div>
        <main class="pt-20 min-h-screen">
            <!-- Hero Section -->
            <section class="px-container-padding py-24 border-b border-primary grid grid-cols-12">
                <div class="col-span-12 lg:col-span-8">
                    <h1 class="font-headline-lg text-headline-lg uppercase mb-4">EDIT ADDRESS</h1>
                    <p class="font-mono-data text-body-lg text-on-surface-variant max-w-xl">Update your delivery
                        destination information.</p>
                </div>
                <div class="hidden lg:flex col-span-4 justify-end items-end">

                </div>
            </section>
            <!-- Content Grid -->
            <section class="grid grid-cols-1 md:grid-cols-12 min-h-screen">
                <!-- Form Side -->
                <div class="md:col-span-7 px-container-padding py-16 border-r border-primary">
                    <div class="mb-12">
                        <h2 class="font-label-caps text-label-caps mb-8">DELIVERY INFORMATION</h2>
                        <form action="/address/edit/<%= address._id %>" method="post"
                            class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10" id="addressForm">

                            <!-- Full Name -->
                            <div class="col-span-2 md:col-span-1 border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Full Name
                                </label>

                                <input
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="nameInput" name="fullName" type="text" placeholder="ENTER NAME"
                                    value="<%= oldData?.fullName || address.fullName %>">

                                <% if(errors?.fullName){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.fullName %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- Phone -->
                            <div class="col-span-2 md:col-span-1 border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Phone Number
                                </label>

                                <div class="flex items-center gap-2">
                                    <span class="font-mono-data text-body-md text-on-surface-variant">
                                        +91
                                    </span>

                                    <input name="phone" value="<%= oldData?.phone || address.phone %>"
                                        class="flex-1 bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                        id="phoneInput" placeholder="9876543210" type="tel" maxlength="10">
                                </div>

                                <% if(errors?.phone){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.phone %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- Email -->
                            <!-- <div class="col-span-2 border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Email Address
                                </label>

                                <input name="email" value="<%= oldData?.email || '' %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="emailInput" placeholder="USER@ARCHIVE.COM" type="email">

                                <% if(errors?.email){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.email %>
                                    </p>
                                    <% } %>
                            </div> -->

                            <!-- Address Line 1 -->
                            <div class="col-span-2 border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Street Name And Number
                                </label>

                                <input name="addressLine1" value="<%= oldData?.addressLine1 || address.addressLine1 %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="addr1Input" placeholder="STREET NAME AND NUMBER" type="text">

                                <% if(errors?.addressLine1){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.addressLine1 %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- Address Line 2 -->
                            <div class="col-span-2 border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Apartment, Suite, Etc.
                                </label>

                                <input name="addressLine2" value="<%= oldData?.addressLine2 || address.addressLine2 %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="addr2Input" placeholder="APARTMENT, SUITE, ETC." type="text">

                                <% if(errors?.addressLine2){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.addressLine2 %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- City -->
                            <div class="border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    City
                                </label>

                                <input name="city" value="<%= oldData?.city || address.city %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="cityInput" placeholder="CITY" type="text">

                                <% if(errors?.city){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.city %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- State -->
                            <div class="border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    State / Province
                                </label>

                                <input name="state" value="<%= oldData?.state || address.state %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="stateInput" placeholder="STATE / PROVINCE" type="text">

                                <% if(errors?.state){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.state %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- Postal Code -->
                            <div class="border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Postal Code
                                </label>

                                <input name="postalCode" value="<%= oldData?.postalCode || address.postalCode %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="zipInput" placeholder="POSTAL CODE" type="text">

                                <% if(errors?.postalCode){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.postalCode %>
                                    </p>
                                    <% } %>
                            </div>

                            <!-- Country -->
                            <div class="border-b border-primary pb-2 flex flex-col gap-1 px-2">
                                <label class="font-label-caps text-[10px] uppercase opacity-60">
                                    Country
                                </label>

                                <input name="country" value="<%= oldData?.country || address.country %>"
                                    class="bg-transparent border-none p-0 font-mono-data text-body-md focus:ring-0 focus:outline-none placeholder:text-on-surface-variant/30"
                                    id="countryInput" placeholder="COUNTRY" type="text">

                                <% if(errors?.country){ %>
                                    <p class="text-red-500 text-[10px] mt-2 font-label-caps">
                                        <%= errors.country %>
                                    </p>
                                    <% } %>
                            </div>


                    </div>
                    <div class="space-y-4 mb-16">
                        <label class="flex items-center gap-3 cursor-pointer select-none w-fit">
                            <input type="checkbox" name="isDefault" class="peer sr-only" <%=address.isDefault
                                ? "checked" : "" %>
                            >

                            <div class="w-[18px] h-[18px] border border-primary flex items-center justify-center
               transition-colors duration-150
               peer-checked:bg-primary">

                                <svg class="hidden peer-checked:block w-3 h-3 text-on-primary" viewBox="0 0 20 20"
                                    fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <polyline points="4 10 8 14 16 6"></polyline>
                                </svg>

                            </div>

                            <span class="font-label-caps text-label-caps uppercase">
                                Set As Default Address
                            </span>
                        </label>
                    </div>
                    </form>
                    <div class="flex flex-col md:flex-row gap-6 pt-8 border-t border-primary">
                        <button type="submit" form="addressForm"
                            class="bg-primary text-on-primary px-12 py-4 font-label-caps text-label-caps hover:bg-surface hover:text-primary border border-primary transition-none w-full md:w-auto">UPDATE
                            ADDRESS</button>
                        <a href="/address" class="border border-primary px-12 py-4
                            font-label-caps text-label-caps
                             hover:bg-primary hover:text-on-primary
                            transition-none text-center">
                            CANCEL
                        </a>
                    </div>
                </div>
                <!-- Preview Side -->
                <div class="md:col-span-5 bg-surface-container-low px-container-padding py-16 flex flex-col">
                    <div class="sticky top-32">
                        <h2 class="font-label-caps text-label-caps mb-8 text-on-surface-variant/60">LIVE PREVIEW</h2>
                        <div class="border border-primary bg-surface p-8 relative overflow-hidden group">
                            <!-- Decorative brutalist tag -->
                            <div
                                class="absolute top-0 right-0 border-l border-b border-primary px-4 py-1 font-mono-data text-[10px] bg-primary text-on-primary">
                                PREVIEW MODE
                            </div>
                            <div class="mb-12">
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="material-symbols-outlined text-[16px]"
                                        data-icon="local_shipping">local_shipping</span>
                                    <span class="font-label-caps text-label-caps">DESTINATION_001</span>
                                </div>
                                <div class="font-headline-md text-headline-md uppercase mb-2" id="previewName">FULL NAME
                                </div>
                                <div class="font-mono-data text-body-md text-on-surface-variant leading-tight"
                                    id="previewAddress">
                                    <p id="pAddr1" class="">STREET ADDRESS LINE 1</p>
                                    <p id="pAddr2" class="">STREET ADDRESS LINE 2</p>
                                    <p id="pLocation" class="">CITY, STATE, ZIP</p>
                                    <p class="font-bold text-primary mt-4" id="pCountry">COUNTRY</p>
                                </div>
                            </div>
                            <div class="pt-6 border-t border-primary flex justify-between items-center">
                                <div class="font-mono-data text-[10px] text-on-surface-variant">ARCHIVE LOGISTICS ID:
                                    RD-092-24</div>
                                <div class="flex gap-4">
                                    <span class="material-symbols-outlined text-primary cursor-not-allowed"
                                        data-icon="edit">edit</span>
                                    <span class="material-symbols-outlined text-primary cursor-not-allowed"
                                        data-icon="delete">delete</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-12">


                        </div>
                    </div>
                </div>
            </section>
        </main>
        <!-- Footer -->
        <%- include("partials/userFooter") %>
            <script>
                // Simple Real-time Preview Logic
                const inputs = {
                    name: document.getElementById('nameInput'),
                    addr1: document.getElementById('addr1Input'),
                    addr2: document.getElementById('addr2Input'),
                    city: document.getElementById('cityInput'),
                    state: document.getElementById('stateInput'),
                    zip: document.getElementById('zipInput'),
                    country: document.getElementById('countryInput')
                };

                const previews = {
                    name: document.getElementById('previewName'),
                    addr1: document.getElementById('pAddr1'),
                    addr2: document.getElementById('pAddr2'),
                    location: document.getElementById('pLocation'),
                    country: document.getElementById('pCountry')
                };

                const updatePreview = () => {
                    previews.name.textContent = inputs.name.value.toUpperCase() || 'FULL NAME';
                    previews.addr1.textContent = inputs.addr1.value.toUpperCase() || 'STREET ADDRESS LINE 1';
                    previews.addr2.textContent = inputs.addr2.value.toUpperCase() || 'STREET ADDRESS LINE 2';

                    const city = inputs.city.value.toUpperCase();
                    const state = inputs.state.value.toUpperCase();
                    const zip = inputs.zip.value.toUpperCase();
                    previews.location.textContent = `${city}${city && (state || zip) ? ', ' : ''}${state} ${zip}`.trim() || 'CITY, STATE, ZIP';

                    previews.country.textContent = inputs.country.value.toUpperCase() || 'COUNTRY';
                };

                Object.values(inputs).forEach(input => {
                    input.addEventListener('input', updatePreview);
                });

                updatePreview();

                // Instant Color Inversion on Hover (Visual Polish)
                document.querySelectorAll('button').forEach(btn => {
                    btn.addEventListener('mouseenter', () => {
                        if (!btn.classList.contains('bg-primary')) {
                            btn.style.backgroundColor = '#000';
                            btn.style.color = '#fff';
                        } else {
                            btn.style.backgroundColor = '#fff';
                            btn.style.color = '#000';
                        }
                    });
                    btn.addEventListener('mouseleave', () => {
                        btn.style.backgroundColor = '';
                        btn.style.color = '';
                    });
                });
                document.getElementById("addressForm").addEventListener("submit", function () {
                    const btn = document.querySelector('button[type="submit"]');

                    btn.disabled = true;
                    btn.textContent = "UPDATING...";
                });
            </script>


</body>

</html>