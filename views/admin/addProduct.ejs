<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Add Product | ARCHIVE Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap"
        rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js">
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f9fb;
        }

        .mono-label {
            font-family: 'JetBrains Mono', monospace;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        /* Hide number input spinner (Chrome, Edge, Safari) */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        /* Hide number input spinner (Firefox) */
        input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container-low": "#f2f4f6",
                        "surface-container-high": "#e6e8ea",
                        "secondary": "#505f76",
                        "on-tertiary-container": "#008ebf",
                        "surface-tint": "#565e74",
                        "on-surface-variant": "#45464d",
                        "on-secondary-container": "#54647a",
                        "on-secondary": "#ffffff",
                        "on-background": "#191c1e",
                        "secondary-container": "#d0e1fb",
                        "primary-container": "#131b2e",
                        "secondary-fixed-dim": "#b7c8e1",
                        "outline-variant": "#c6c6cd",
                        "tertiary-container": "#001e2c",
                        "error": "#ba1a1a",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "surface-dim": "#d8dadc",
                        "secondary-fixed": "#d3e4fe",
                        "background": "#f7f9fb",
                        "surface-container": "#eceef0",
                        "surface": "#f7f9fb",
                        "on-error": "#ffffff",
                        "inverse-on-surface": "#eff1f3",
                        "surface-variant": "#e0e3e5",
                        "inverse-primary": "#bec6e0",
                        "tertiary": "#000000",
                        "on-error-container": "#93000a",
                        "primary-fixed-dim": "#bec6e0",
                        "on-primary-fixed": "#131b2e",
                        "on-primary-container": "#7c839b",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed-variant": "#38485d",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed": "#001e2c",
                        "on-surface": "#191c1e",
                        "tertiary-fixed": "#c4e7ff",
                        "surface-container-highest": "#e0e3e5",
                        "primary": "#000000",
                        "on-tertiary": "#ffffff",
                        "on-secondary-fixed": "#0b1c30",
                        "outline": "#76777d",
                        "inverse-surface": "#2d3133",
                        "on-tertiary-fixed-variant": "#004c69",
                        "surface-bright": "#f7f9fb",
                        "primary-fixed": "#dae2fd",
                        "on-primary-fixed-variant": "#3f465c",
                        "on-primary": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "8px",
                        "xl": "12px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xs": "4px",
                        "xl": "32px",
                        "md": "16px",
                        "lg": "24px",
                        "base": "4px",
                        "gutter": "24px",
                        "2xl": "48px",
                        "sm": "8px",
                        "margin": "32px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["JetBrains Mono"],
                        "display": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "headline-lg-mobile": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "headline-lg": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500" }],
                        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
</head>

<body class="bg-background text-on-surface">
    <%- include("partials/toast") %>
        <!-- Fixed SideNavBar -->
        <%- include("partials/adminSidebar") %>
            <!-- TopAppBar -->
            <%- include("partials/adminNavbar") %>
                <!-- Main Content Canvas -->
                <form action="/admin/addProducts" method="post" enctype="multipart/form-data">
                    <main class="ml-[240px] mt-16 pb-32">
                        <!-- Page Header -->
                        <div class="px-gutter py-xl bg-surface-bright border-b border-outline-variant">
                            <div
                                class="max-w-[1200px] mx-auto flex flex-col md:flex-row md:items-end justify-between gap-md">
                                <div>
                                    <h2 class="font-headline-lg text-headline-lg text-primary">Add Product</h2>
                                    <p class="font-body-md text-body-md text-on-surface-variant mt-1">Create a new
                                        product
                                        for
                                        the
                                        ARCHIVE store.</p>
                                </div>
                                <div class="flex items-center gap-sm">
                                    <a href="/admin/products">
                                        <button type="button"
                                            class="px-md py-2 text-body-sm font-medium border border-transparent hover:bg-surface-container transition-colors rounded-lg flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Back
                                            to
                                            Products
                                        </button>
                                    </a>
                                    <!-- <button
                                    class="px-md py-2 text-body-sm font-bold bg-primary text-on-primary hover:bg-primary/90 transition-all rounded-lg shadow-sm">
                                    Add Product
                                </button> -->
                                </div>
                            </div>
                        </div>
                        <!-- Form Body -->
                        <div class="max-w-[1200px] mx-auto px-gutter py-xl space-y-gutter">
                            <div class="grid grid-cols-1 gap-gutter">
                                <!-- Main Form Area (now full width) -->
                                <div class="space-y-gutter">
                                    <!-- 01 BASIC INFORMATION -->
                                    <section
                                        class="bg-surface-container-lowest border border-outline-variant rounded-lg p-lg">
                                        <div
                                            class="flex items-center gap-2 mb-lg border-b border-outline-variant pb-md">
                                            <span
                                                class="mono-label text-[10px] bg-primary text-on-primary px-1.5 py-0.5 rounded">01</span>
                                            <h3 class="font-headline-md text-[16px] uppercase tracking-wider font-bold">
                                                Basic
                                                Information</h3>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                                            <div class="md:col-span-2">
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Product
                                                    Name</label>
                                                <input id="name" name="name" type="text"
                                                    value="<%= formData?.name || '' %>"
                                                    placeholder="<%= errors?.name || 'Enter product name' %>" class="w-full rounded-lg px-3 py-2 text-body-md border
                                                <%= errors?.name
                                                    ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                                    : 'border-outline-variant focus:ring-primary focus:border-primary'
                                                %>">
                                            </div>
                                            <div class="md:col-span-2">
                                                <label
                                                    class="block font-label-md text-label-md text-on-surface-variant uppercase tracking-widest mb-2">Product
                                                    Slug</label>
                                                <input id="slug" name="slug" type="text"
                                                    value="<%= formData?.slug || '' %>"
                                                    placeholder="<%= errors?.slug || 'Enter product slug' %>" class="w-full bg-white rounded-lg px-4 py-3 text-body-md outline-none transition-all border
                                                <%= errors?.slug
                                                    ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                                    : 'border-outline-variant focus:ring-primary focus:border-primary'
                                                %>">
                                            </div>
                                            <div>
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Category</label>
                                                <select name="category" class="w-full rounded-lg px-3 py-2 text-body-md border
                                            <%= errors?.category
                                                ? 'border-red-500 focus:ring-red-500 focus:border-red-500'
                                                : 'border-outline-variant focus:ring-primary focus:border-primary'
                                            %>">
                                                    <% categories.forEach(category=> { %>
                                                        <option value="<%= category._id %>">
                                                            <%= category.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <div>
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Status</label>
                                                <select name="status" class="w-full rounded-lg px-3 py-2 text-body-md border
                                            <%= errors?.status
                                                ? 'border-red-500 focus:ring-red-500 focus:border-red-500'
                                                : 'border-outline-variant focus:ring-primary focus:border-primary'
                                            %>">
                                                    <option>Listed</option>
                                                    <option>Unlisted</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Price
                                                    (₹)</label>
                                                <input name="price" type="number" min="1" step="0.01" id="price"
                                                    value="<%= formData?.price || '' %>"
                                                    placeholder="<%= errors?.price || '12000' %>" class="w-full rounded-lg px-3 py-2 text-body-md border
                                                <%= errors?.price
                                                    ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                                    : 'border-outline-variant focus:ring-primary focus:border-primary'
                                                %>">
                                            </div>
                                            <div>
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Brand</label>
                                                <input id="brand" name="brand" type="text"
                                                    value="<%= formData?.brand || '' %>"
                                                    placeholder="<%= errors?.brand || 'Nike' %>" class="w-full rounded-lg px-3 py-2 text-body-md border
                                                <%= errors?.brand
                                                    ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                                    : 'border-outline-variant focus:ring-primary focus:border-primary'
                                                %>">
                                            </div>
                                            <div class="md:col-span-2">
                                                <label
                                                    class="font-label-md text-label-md text-on-surface-variant block mb-1">Short
                                                    Description</label>
                                                <input name="shortDescription" type="text" id="shortDescription"
                                                    value="<%= formData?.shortDescription || '' %>"
                                                    placeholder="<%= errors?.shortDescription || 'Authentic 1994/95 home kit as worn during the double-winning era.' %>"
                                                    class="w-full rounded-lg px-3 py-2 text-body-md border
                                                <%= errors?.shortDescription
                                                    ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                                    : 'border-outline-variant focus:ring-primary focus:border-primary'
                                                %>">
                                            </div>
                                        </div>
                                    </section>

                                    <section class="bg-surface-container-lowest border rounded-lg p-lg
                                <%= errors?.sizes || errors?.variants
                                    ? 'border-red-500'
                                    : 'border-outline-variant'
                                %>">
                                        <div
                                            class="flex items-center gap-2 mb-lg border-b border-outline-variant pb-md">
                                            <span
                                                class="mono-label text-[10px] bg-primary text-on-primary px-1.5 py-0.5 rounded">02</span>
                                            <h3 class="font-headline-md text-[16px] uppercase tracking-wider font-bold">
                                                Size
                                                Variants
                                            </h3>
                                        </div>
                                        <div id="variantContainer" class="space-y-md">
                                            <div
                                                class="variant-row flex items-center gap-md pb-md border-b border-outline-variant/30">

                                                <!-- Size -->
                                                <div class="flex-1">
                                                    <label
                                                        class="font-label-md text-label-md text-on-surface-variant block mb-1">
                                                        Size
                                                    </label>

                                                    <select name="sizes[]" class="w-full rounded-lg px-3 py-2 text-body-md border
                                                <%= errors?.sizes || errors?.variants
                                                    ? 'border-red-500'
                                                    : 'border-outline-variant'
                                                %>">

                                                        <option>S</option>
                                                        <option>M</option>
                                                        <option>L</option>
                                                        <option>XL</option>
                                                        <option>XXL</option>

                                                    </select>
                                                </div>

                                                <!-- Quantity -->
                                                <div class="w-28">
                                                    <label
                                                        class="font-label-md text-label-md text-on-surface-variant block mb-1">
                                                        Quantity
                                                    </label>

                                                    <div class="flex items-center border rounded-lg overflow-hidden
                                                <%= errors?.stocks ? 'border-red-500' : 'border-outline-variant' %>">

                                                        <button type="button"
                                                            class="decrease w-10 h-10 flex items-center justify-center border-r border-outline-variant hover:bg-surface-container">

                                                            <span class="material-symbols-outlined">remove</span>

                                                        </button>

                                                        <input type="number" name="stocks[]" min="0"
                                                            value="<%= formData?.stocks?.[0] || 0 %>"
                                                            class="stock-input w-full h-10 text-center border-0 bg-transparent focus:ring-0 appearance-none">

                                                        <button type="button"
                                                            class="increase w-10 h-10 flex items-center justify-center border-l border-outline-variant hover:bg-surface-container">

                                                            <span class="material-symbols-outlined">add</span>

                                                        </button>

                                                    </div>
                                                </div>

                                                <button type="button"
                                                    class="remove-variant mt-6 material-symbols-outlined text-on-surface-variant hover:text-error">

                                                    delete

                                                </button>

                                            </div>
                                        </div>
                                        <div class="mt-lg flex items-center justify-between">
                                            <button id="addVariant" type="button"
                                                class="px-md py-2 text-body-sm font-bold border border-outline-variant rounded-lg hover:bg-surface-container-low transition-colors flex items-center gap-2">
                                                <span class="material-symbols-outlined text-[18px]">add</span> Add Size
                                                Variant
                                            </button>
                                            <div class="text-right">
                                                <p
                                                    class="text-[10px] uppercase tracking-widest text-on-surface-variant font-bold">
                                                    Total
                                                    Stock</p>
                                                <p id="totalStock" class="text-body-lg font-bold mono-label">0</p>
                                            </div>
                                        </div>
                                        <% if (errors?.sizes || errors?.variants || errors?.stocks) { %>
                                            <div class="mt-3">
                                                <p id="variantError"
                                                    class="text-xs font-medium uppercase tracking-wider text-red-500">
                                                    <%= errors.sizes || errors.variants || errors.stocks %>
                                                </p>
                                            </div>
                                            <% } %>
                                    </section>
                                    <!-- 03 PRODUCT VARIANTS -->
                                    <!-- Product Images -->
                                    <section
                                        class="bg-surface-container-lowest border border-outline-variant rounded-lg p-lg">

                                        <!-- Section Header -->
                                        <div
                                            class="flex items-center gap-2 mb-lg border-b border-outline-variant pb-md">
                                            <span
                                                class="mono-label text-[10px] bg-primary text-on-primary px-1.5 py-0.5 rounded">
                                                03
                                            </span>

                                            <h3 class="font-headline-md text-[16px] uppercase tracking-wider font-bold">
                                                Product Images
                                            </h3>
                                        </div>

                                        <!-- Optional Helper -->
                                        <div class="flex items-center justify-between mb-lg">
                                            <p class="text-label-md text-on-surface-variant">
                                                Upload up to 5 product images.
                                            </p>

                                            <span
                                                class="text-[10px] uppercase tracking-widest text-on-surface-variant font-bold">
                                                Max 5 Images
                                            </span>
                                        </div>

                                        <!-- Upload Grid -->
                                        <div class="grid grid-cols-6 gap-md">

                                            <!-- Hidden Input -->
                                            <input type="file" id="images" name="images" multiple accept="image/*"
                                                class="hidden">

                                            <!-- Upload Card -->
                                            <label id="uploadCard" for="images" class="aspect-square border border-dashed rounded-lg flex flex-col items-center justify-center gap-2 cursor-pointer transition-colors
                                        <%= errors?.images
                                            ? 'border-red-500'
                                            : 'border-outline-variant hover:bg-surface-container'
                                        %>">
                                                <span class="material-symbols-outlined text-[32px] text-outline">
                                                    add
                                                </span>

                                                <span
                                                    class="text-[10px] uppercase tracking-widest font-bold text-outline">
                                                    Upload
                                                </span>

                                            </label>

                                            <!-- Uploaded Images -->
                                            <div id="previewContainer" class="contents"></div>

                                        </div>
                                        <% if (errors?.images) { %>
                                            <p class="mt-3 text-xs font-medium uppercase tracking-wider text-red-500">
                                                <%= errors.images %>
                                            </p>
                                            <% } %>

                                    </section>
                                    <!-- 04 DESCRIPTION -->
                                    <section
                                        class="bg-surface-container-lowest border border-outline-variant rounded-lg p-lg">
                                        <div
                                            class="flex items-center gap-2 mb-lg border-b border-outline-variant pb-md">
                                            <span
                                                class="mono-label text-[10px] bg-primary text-on-primary px-1.5 py-0.5 rounded">05</span>
                                            <h3 class="font-headline-md text-[16px] uppercase tracking-wider font-bold">
                                                Description</h3>
                                        </div>
                                        <textarea name="description" rows="6" id="description"
                                            placeholder="<%= errors?.description || 'Write product description...' %>"
                                            class="w-full rounded-lg px-3 py-2 text-body-md border
                                        <%= errors?.description
                                            ? 'border-red-500 placeholder-red-500 focus:ring-red-500 focus:border-red-500'
                                            : 'border-outline-variant focus:ring-primary focus:border-primary'
                                        %>"><%= formData?.description || '' %></textarea>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </main>
                    <!-- Bottom Action Bar -->
                    <footer
                        class="fixed bottom-0 right-0 left-[240px] bg-surface-bright border-t border-outline-variant px-lg py-md z-40">
                        <div class="max-w-[1200px] mx-auto flex items-center justify-end">
                            <div class="flex items-center gap-md">
                                <a href="/admin/products"
                                    class="px-lg py-2.5 text-body-sm font-bold text-on-surface-variant hover:text-primary transition-colors">
                                    Cancel
                                </a>
                                <button type="submit"
                                    class="px-xl py-2.5 text-body-sm font-bold bg-primary text-on-primary rounded-lg shadow-lg hover:bg-primary/90 transition-transform active:scale-95">Add
                                    Product</button>
                            </div>
                        </div>
                    </footer>
                </form>

                <div id="cropModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50">

                    <div class="bg-white rounded-xl p-6 w-[700px]">

                        <div class="w-full h-[500px]">
                            <img id="cropImage" class="block max-w-full" style="max-width:100%;">
                        </div>

                        <div class="flex justify-end gap-3 mt-5">

                            <button type="button" id="cancelCrop" class="px-5 py-2 border rounded-lg">

                                Cancel

                            </button>

                            <button type="button" id="saveCrop" class="px-5 py-2 bg-black text-white rounded-lg">

                                Crop & Save

                            </button>

                        </div>

                    </div>

                </div>
                <script>
                    const nameInput = document.getElementById("name");
                    const slugInput = document.getElementById("slug");

                    let slugEdited = false;

                    // If user edits slug manually, stop auto-generation
                    slugInput.addEventListener("input", () => {
                        slugEdited = slugInput.value.trim() !== "";
                    });

                    // Generate slug from product name
                    nameInput.addEventListener("input", () => {

                        if (slugEdited) return;

                        slugInput.value = nameInput.value
                            .toLowerCase()
                            .trim()
                            .replace(/[^a-z0-9\s-]/g, "") // Remove special characters
                            .replace(/\s+/g, "-")         // Spaces -> hyphens
                            .replace(/-+/g, "-");         // Remove duplicate hyphens
                    });

                    // Simple micro-interactions
                    document.querySelectorAll('input, select, textarea').forEach(el => {
                        el.addEventListener('focus', () => {
                            el.parentElement.classList.add('border-primary');
                        });
                        el.addEventListener('blur', () => {
                            el.parentElement.classList.remove('border-primary');
                        });
                    });

                    // Toggle interaction for custom checkboxes
                    document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
                        checkbox.addEventListener('change', (e) => {
                            const label = e.target.closest('label');
                            if (e.target.checked) {
                                label.classList.add('text-primary', 'font-bold');
                            } else {
                                label.classList.remove('text-primary', 'font-bold');
                            }
                        });
                    });


                    const imageInput = document.getElementById("images");
                    const previewContainer = document.getElementById("previewContainer");
                    const uploadCard = document.getElementById("uploadCard");

                    let uploadedFiles = [];

                    imageInput.addEventListener("change", async function () {

                        const selectedFiles = Array.from(this.files);

                        for (const file of selectedFiles) {

                            // Allow only images
                            if (!file.type.startsWith("image/")) {
                                showToast("Only image files are allowed", "error");
                                continue;
                            }

                            // // Max file size: 5MB
                            // if (file.size > 5 * 1024 * 1024) {
                            //     showToast("Image must be less than 5MB", "error");
                            //     continue;
                            // }

                            // Max 5 images
                            if (uploadedFiles.length >= 5) {
                                showToast("Maximum 5 images allowed", "error");
                                break;
                            }

                            await openCropper(file);

                        }

                        // this.value = "";

                    });

                    function openCropper(file) {

                        return new Promise(resolve => {

                            currentFile = file;

                            cropImage.src = URL.createObjectURL(file);

                            cropModal.classList.remove("hidden");
                            cropModal.classList.add("flex");

                            cropImage.onload = () => {

                                if (cropper) {
                                    cropper.destroy();
                                    cropper = null;
                                }

                                cropper = new Cropper(cropImage, {
                                    aspectRatio: 4 / 5,
                                    viewMode: 1,
                                    autoCropArea: 1,
                                    responsive: true,
                                    dragMode: "move",
                                    guides: true,
                                    background: false
                                });

                            };

                            saveCrop.onclick = () => {

                                cropper.getCroppedCanvas({

                                    width: 800,

                                    height: 1000

                                }).toBlob(blob => {

                                    const croppedFile = new File(

                                        [blob],

                                        currentFile.name,

                                        {

                                            type: "image/jpeg"

                                        }

                                    );

                                    uploadedFiles.push(croppedFile);
                                    console.log("Uploaded files:", uploadedFiles.length);

                                    renderPreviews();

                                    cropper.destroy();

                                    cropModal.classList.add("hidden");
                                    cropModal.classList.remove("flex");

                                    resolve();

                                });

                            };

                            cancelCrop.onclick = () => {

                                cropper.destroy();

                                cropModal.classList.add("hidden");
                                cropModal.classList.remove("flex");

                                resolve();

                            };

                        });

                    }

                    function renderPreviews() {

                        previewContainer.innerHTML = "";


                        const dataTransfer = new DataTransfer();

                        uploadedFiles.forEach((file, index) => {

                            dataTransfer.items.add(file);
                            imageInput.files = dataTransfer.files;

                            console.log("Input files:", imageInput.files.length);

                            const preview = document.createElement("div");

                            preview.className =
                                "relative aspect-square rounded-lg overflow-hidden border border-outline-variant group";

                            preview.innerHTML = `
    <img
        src="${URL.createObjectURL(file)}"
        class="w-full h-full object-cover"
    >

    ${index === 0
                                    ? `
            <div
                class="absolute top-2 left-2 px-2 py-1 rounded-md bg-black text-white text-[10px] font-bold uppercase tracking-widest">
                Cover
            </div>
            `
                                    : ""
                                }

    <div
        class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center">

        <button
            type="button"
            class="remove-image px-4 py-2 bg-white text-black text-[11px] uppercase font-semibold rounded"
            data-index="${index}">
            Remove
        </button>

    </div>
`;

                            preview.querySelector(".remove-image").addEventListener("click", function () {

                                uploadedFiles.splice(index, 1);

                                renderPreviews();

                            });

                            previewContainer.appendChild(preview);

                        });

                        imageInput.files = dataTransfer.files;
                        const imageError = document.getElementById("imageError");

                        if (imageError) {
                            if (uploadedFiles.length >= 3) {
                                imageError.classList.add("hidden");
                            } else {
                                imageError.classList.remove("hidden");
                            }
                        }

                        // Disable upload after 5 images
                        if (uploadedFiles.length >= 5) {

                            uploadCard.classList.add(
                                "opacity-40",
                                "pointer-events-none",
                                "cursor-not-allowed"
                            );

                        } else {

                            uploadCard.classList.remove(
                                "opacity-40",
                                "pointer-events-none",
                                "cursor-not-allowed"
                            );

                        }
                    }

                    const variantContainer = document.getElementById("variantContainer");
                    const addVariantBtn = document.getElementById("addVariant");

                    addVariantBtn.addEventListener("click", () => {

                        // Don't allow more than 5 variants
                        if (document.querySelectorAll(".variant-row").length >= 5) {
                            showToast("Maximum 5 size variants allowed.", "warning");
                            return;
                        }

                        // Clone the first variant row
                        const newRow = document
                            .querySelector(".variant-row")
                            .cloneNode(true);


                        // Reset stock
                        newRow.querySelector(".stock-input").value = 0;

                        const select = newRow.querySelector("select");

                        // Enable all options
                        Array.from(select.options).forEach(option => {
                            option.disabled = false;
                        });

                        // Select first available size
                        const usedSizes = Array.from(
                            document.querySelectorAll('select[name="sizes[]"]')
                        ).map(s => s.value);

                        for (const option of select.options) {
                            if (!usedSizes.includes(option.value)) {
                                select.value = option.value;
                                break;
                            }
                        }

                        newRow.classList.add(
                            "opacity-0",
                            "-translate-y-3",
                            "scale-95",
                            "transition-all",
                            "duration-300",
                            "ease-out"
                        );

                        variantContainer.appendChild(newRow);

                        requestAnimationFrame(() => {

                            newRow.classList.remove(
                                "opacity-0",
                                "-translate-y-3",
                                "scale-95"
                            );

                        });

                        updateAvailableSizes();
                        updateTotalStock();
                        updateAddVariantButton();

                    });

                    variantContainer.addEventListener("click", (e) => {

                        // Increase
                        if (e.target.closest(".increase")) {

                            const input = e.target
                                .closest(".variant-row")
                                .querySelector(".stock-input");

                            input.value = Number(input.value) + 1;

                            updateTotalStock();
                        }

                        // Decrease
                        if (e.target.closest(".decrease")) {

                            const input = e.target
                                .closest(".variant-row")
                                .querySelector(".stock-input");

                            input.value = Math.max(0, Number(input.value) - 1);

                            updateTotalStock();
                        }

                        // Remove Variant
                        if (e.target.closest(".remove-variant")) {

                            // Don't remove the last remaining row
                            if (variantContainer.children.length === 1) {
                                return;
                            }

                            const row = e.target.closest(".variant-row");

                            row.classList.add(
                                "opacity-0",
                                "scale-95",
                                "-translate-y-3",
                                "transition-all",
                                "duration-300",
                                "ease-out"
                            );

                            setTimeout(() => {

                                row.remove();

                                updateTotalStock();
                                updateAvailableSizes();
                                updateAddVariantButton();

                            }, 300);
                        }

                    });

                    variantContainer.addEventListener("change", (e) => {

                        if (e.target.name === "sizes[]") {

                            updateAvailableSizes();

                        }

                    });
                    function updateTotalStock() {

                        let total = 0;

                        document.querySelectorAll(".stock-input").forEach(input => {
                            total += Number(input.value);
                        });

                        document.getElementById("totalStock").textContent = total;
                    }

                    updateTotalStock();
                    updateAvailableSizes();
                    updateAddVariantButton();

                    variantContainer.addEventListener("input", (e) => {

                        if (e.target.classList.contains("stock-input")) {
                            updateTotalStock();
                        }

                    });

                    function updateAvailableSizes() {

                        const selects = document.querySelectorAll('select[name="sizes[]"]');

                        // Get all selected sizes
                        const selectedSizes = Array.from(selects).map(select => select.value);

                        selects.forEach(currentSelect => {

                            const currentValue = currentSelect.value;

                            Array.from(currentSelect.options).forEach(option => {

                                // Keep the currently selected option enabled
                                if (option.value === currentValue) {
                                    option.disabled = false;
                                    return;
                                }

                                // Disable if another row already selected it
                                option.disabled = selectedSizes.includes(option.value);

                            });

                        });

                    }

                    function updateAddVariantButton() {

                        addVariantBtn.disabled = document.querySelectorAll(".variant-row").length >= 5;

                        if (addVariantBtn.disabled) {
                            addVariantBtn.classList.add("opacity-50", "cursor-not-allowed");
                        } else {
                            addVariantBtn.classList.remove("opacity-50", "cursor-not-allowed");
                        }

                    }

                    const cropModal = document.getElementById("cropModal");
                    const cropImage = document.getElementById("cropImage");

                    let cropper;
                    let currentFile = null;

                    document.querySelector("form").addEventListener("submit", function (e) {

                        console.log("uploadedFiles:", uploadedFiles.length);
                        console.log("input files:", imageInput.files.length);

                        if (uploadedFiles.length < 3) {
                            e.preventDefault();

                            showToast("Upload at least 3 product images.", "error");

                            return;
                        }

                    });
                </script>
</body>

</html>