                                </div>
                            </div> -->
                                        <div class="flex flex-col gap-base md:col-span-2 opacity-100">


                                        </div>
                                    </div>
                                </section>
                                <!-- Section 02: Offer Target -->
                                <section class="bg-surface-container-lowest border border-outline-variant p-lg">
                                    <div class="flex items-center gap-2 mb-md">
                                        <span class="font-label-md text-label-md text-primary opacity-40">
                                            02
                                        </span>

